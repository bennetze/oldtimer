---
import type { ImageMetadata } from 'astro';
import BackgroundTexture from '../components/BackgroundTexture.astro';
import SectionNavigation from '../components/SectionNavigation.astro';
import SiteChrome from '../components/SiteChrome.astro';
import Layout from './Layout.astro';

interface SectionItem {
	id: string;
	label: string;
}

interface Props {
	title: string;
	heading: string;
	headingMaxWidth?: string;
	description: string;
	sections: SectionItem[];
	theme?: 'dark' | 'light';
	background: string;
	openGraphImage: ImageMetadata;
	openGraphImageAlt: string;
	structuredDataType?: string;
	dateModified: string;
	additionalJsonLd?: Record<string, unknown> | Record<string, unknown>[];
	sectionNavigationVisible?: boolean;
}

const {
	title,
	heading,
	headingMaxWidth = '18ch',
	description,
	sections,
	theme = 'light',
	background,
	openGraphImage,
	openGraphImageAlt,
	structuredDataType = 'WebPage',
	dateModified,
	additionalJsonLd = [],
	sectionNavigationVisible = true,
} = Astro.props;

const openingId = sections[0]?.id;
---

<Layout
	{title}
	{description}
	{openGraphImage}
	{openGraphImageAlt}
	{structuredDataType}
	{dateModified}
	{additionalJsonLd}
>
	<SiteChrome {theme}>
		<main
			class:list={['editorial-page', `editorial-page--${theme}`, { 'textured-background gradient-palette': theme === 'light' }]}
			id="main-content"
			tabindex="-1"
			style={`--editorial-background: ${background}`}
		>
			{theme === 'light' && <BackgroundTexture />}
			<SectionNavigation items={sections} {theme} visible={sectionNavigationVisible} />

			<div class="editorial-opening" id={openingId}>
				<header class="editorial-intro">
					<h1 style={`max-width: ${headingMaxWidth}`}>{heading}</h1>
				</header>
				<slot name="opening" />
			</div>

			<slot />
		</main>
	</SiteChrome>
</Layout>

<script>
	import { watchMedia } from '../scripts/accessibility.js';
	import { fragmentId } from '../config/fragments.js';
	import { boundedParallaxOffset, orderedParallaxOffsets } from '../scripts/editorialParallax.js';
	const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
	const editorialPage = document.querySelector('.editorial-page');
	const parallaxGroups = [...document.querySelectorAll('[data-parallax-group]')];
	const visibleGroups = new Set();
	const geometry = new Map(parallaxGroups.map(group => {
		const blocks = [
			group.querySelector('.profile-heading') ?? group.querySelector('h2'),
			group.querySelector('.story__layout') ?? group.querySelector('.services-list'),
			...group.querySelectorAll(':scope > .section-closing-copy'),
		].filter((block) => block instanceof HTMLElement);
		blocks.forEach(block => block.setAttribute('data-editorial-flow', ''));
		return [group, { blocks, layers: [...group.querySelectorAll('.image-layer[data-parallax-layer]')] }];
	}));
	let parallaxFrame;
	let initialHashAligned = false;

	const updateStoryScrollOffset = () => {
		if (!(editorialPage instanceof HTMLElement)) {
			return;
		}

		const fixedSurfaces = [
			document.querySelector('[data-floating-header]'),
			document.querySelector('.development-notice'),
		];
		const fixedBottom = fixedSurfaces.reduce((maximum, surface) => {
			if (!(surface instanceof HTMLElement)) {
				return maximum;
			}

			return Math.max(maximum, surface.getBoundingClientRect().bottom);
		}, 0);

		editorialPage.style.setProperty('--story-scroll-offset', `${Math.ceil(fixedBottom + 20)}px`);
	};

	const alignInitialHashTarget = () => {
		if (initialHashAligned || !window.location.hash) {
			return;
		}

		const id = fragmentId(window.location.hash);
		const hashTarget = id ? document.getElementById(id) : null;
		if (!(hashTarget instanceof HTMLElement) || !(editorialPage instanceof HTMLElement)) {
			return;
		}

		initialHashAligned = true;
		const scrollOffset = Number.parseFloat(
			window.getComputedStyle(editorialPage).getPropertyValue('--story-scroll-offset'),
		) || 0;
		const targetTop = hashTarget.getBoundingClientRect().top + window.scrollY - scrollOffset;
		window.scrollTo(0, targetTop);
	};

	const resetParallax = () => {
		document.querySelectorAll('[data-editorial-flow]').forEach((block) => {
			if (block instanceof HTMLElement) block.style.setProperty('--flow-parallax-y', '0px');
		});
		document.querySelectorAll('[data-parallax-layer]').forEach((layer) => {
			if (layer instanceof HTMLElement) {
				layer.style.setProperty('--parallax-y', '0px');
			}
		});
	};

	const updateParallax = () => {
		parallaxFrame = undefined;

		if (motionPreference.matches) {
			resetParallax();
			return;
		}

		const viewportCenter = window.innerHeight / 2;
		const isMobileLayout = window.innerWidth <= 840;
		const mobileFactor = isMobileLayout ? 0.4 : 1;

		const updates = [];
		const flowUpdates = [];
		visibleGroups.forEach((group) => {
			if (!(group instanceof HTMLElement)) {
				return;
			}

			const groupBounds = group.getBoundingClientRect();
			const groupCenter = groupBounds.top + groupBounds.height / 2;
			const distance = viewportCenter - groupCenter;
			const elements = geometry.get(group);
			const blocks = elements.blocks.map((block, index) => {
				const bounds = block.getBoundingClientRect();
				const currentOffset = Number.parseFloat(block.style.getPropertyValue('--flow-parallax-y')) || 0;
				return {
					top: bounds.top - currentOffset, bottom: bounds.bottom - currentOffset,
					range: (index === 0 ? 64 : 180) * mobileFactor,
					requested: distance * (index === 0 ? 0.12 : 0.3) * mobileFactor,
				};
			});
			// Reserve breathing room before the next section even at maximum travel.
			const sectionClearance = Math.min(
				Number.parseFloat(window.getComputedStyle(group).paddingBottom) || 0,
				isMobileLayout ? 48 : 80,
			);
			const offsets = orderedParallaxOffsets(blocks, groupBounds.top, groupBounds.bottom - sectionClearance, isMobileLayout ? 16 : 24);
			elements.blocks.forEach((block, index) => flowUpdates.push([block, `${offsets[index].toFixed(2)}px`]));

			elements.layers.forEach((layer) => {
				if (!(layer instanceof HTMLElement)) {
					return;
				}

				const speed = Number(layer.dataset.speed ?? 0) * 1.5 * mobileFactor;
				const range = Number(layer.dataset.range ?? 0) * 1.5 * mobileFactor;
				const stage = layer.closest('.collage');
				if (!(stage instanceof HTMLElement)) return;
				const currentOffset = Number.parseFloat(layer.style.getPropertyValue('--parallax-y')) || 0;
				const layerBounds = layer.getBoundingClientRect();
				const stageBounds = stage.getBoundingClientRect();
				// Photos may move within the clipped collage, never into its section heading.
				const offset = boundedParallaxOffset(
					distance * speed, range,
					layerBounds.top - currentOffset, layerBounds.bottom - currentOffset,
					stageBounds.top, stageBounds.bottom,
				);
				updates.push([layer, `${offset.toFixed(2)}px`]);
			});
		});
		// Finish every geometry read before the first transform write.
		flowUpdates.forEach(([block, value]) => {
			if (block.style.getPropertyValue('--flow-parallax-y') !== value) block.style.setProperty('--flow-parallax-y', value);
		});
		updates.forEach(([layer, value]) => {
			if (layer.style.getPropertyValue('--parallax-y') !== value) layer.style.setProperty('--parallax-y', value);
		});
	};

	const requestParallaxUpdate = () => {
		if (!parallaxFrame && typeof window.requestAnimationFrame === 'function') {
			parallaxFrame = window.requestAnimationFrame(updateParallax);
		}
	};

	if ('IntersectionObserver' in window) {
		const parallaxObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						visibleGroups.add(entry.target);
					} else {
						visibleGroups.delete(entry.target);
					}
				});
				requestParallaxUpdate();
			},
			{ rootMargin: '55% 0px', threshold: 0 },
		);

		parallaxGroups.forEach((group) => parallaxObserver.observe(group));
	} else {
		parallaxGroups.forEach((group) => visibleGroups.add(group));
	}

	window.addEventListener('scroll', () => {
		if (!motionPreference.matches && !document.hidden && visibleGroups.size) requestParallaxUpdate();
	}, { passive: true });
	const handlePageLoaded = () => {
		updateStoryScrollOffset();
		alignInitialHashTarget();
	};

	if (document.readyState === 'complete') {
		handlePageLoaded();
	} else {
		window.addEventListener('load', handlePageLoaded, { once: true });
	}
	let resizeFrame;
	window.addEventListener('resize', () => {
		if (resizeFrame !== undefined) return;
		const update = () => { resizeFrame = undefined; updateStoryScrollOffset(); requestParallaxUpdate(); };
		if (typeof window.requestAnimationFrame === 'function') resizeFrame = window.requestAnimationFrame(update);
		else update();
	}, { passive: true });
	watchMedia(motionPreference, requestParallaxUpdate);
	if (typeof window.requestAnimationFrame === 'function') window.requestAnimationFrame(updateStoryScrollOffset);
	else updateStoryScrollOffset();
	requestParallaxUpdate();
</script>

<style is:global>
	.editorial-page {
		--story-gap: clamp(7rem, 11vw, 11rem);
		--story-scroll-offset: calc(var(--site-header-height, 132px) + clamp(1.5rem, 3vh, 2.5rem));
		--editorial-color: #000000;
		--editorial-line: rgba(17, 17, 17, 0.34);
		--editorial-image-background: #d8dcdd;

		overflow: hidden;
		background: var(--editorial-background);
		color: var(--editorial-color);
	}

	.editorial-page--dark {
		--editorial-color: #eeeeee;
		--editorial-line: rgba(238, 238, 238, 0.3);
		--editorial-image-background: #202427;
	}

	/* Keep the color changes inside section spacing, even when mobile copy wraps.
	   Negative layers leave the existing leather photograph above the gradient. */
	.editorial-page--light {
		--editorial-color: #ffffff;
		--editorial-line: rgba(255, 255, 255, 0.4);
	}

	.editorial-page--light .editorial-opening,
	.editorial-page--light > .story {
		position: relative;
	}

	.editorial-page--light .editorial-opening,
	.editorial-page--light > .story:last-child {
		--editorial-color: var(--gradient-ink);
		--editorial-line: rgba(20, 35, 29, 0.34);
		color: var(--editorial-color);
	}

	.editorial-page--light .editorial-opening::before,
	.editorial-page--light > .story::before {
		position: absolute;
		inset: 0;
		z-index: -2;
		content: '';
		pointer-events: none;
	}

	/* Only the two color transitions need this extra travel distance. */
	.editorial-page--light .editorial-opening,
	.editorial-page--light > .story:nth-last-child(2) {
		--story-gap: clamp(8rem, 12vw, 12rem);
	}

	.editorial-page--light .editorial-opening::before {
		bottom: -2px;
		background:
			var(--gradient-descend) bottom / 100% var(--story-gap) no-repeat,
			linear-gradient(var(--gradient-cream), var(--gradient-cream))
				top / 100% calc(100% - var(--story-gap) + 2px) no-repeat var(--gradient-green);
	}

	.editorial-page--light > .story::before {
		background: var(--gradient-green);
	}

	.editorial-page--light > .story:nth-last-child(2)::before {
		bottom: -2px;
		background:
			var(--gradient-ascend) bottom / 100% var(--story-gap) no-repeat,
			linear-gradient(var(--gradient-green), var(--gradient-green))
				top / 100% calc(100% - var(--story-gap) + 2px) no-repeat var(--gradient-green);
	}

	.editorial-page--light > .story:last-child::before {
		top: -2px;
		background: var(--gradient-cream);
	}


	.editorial-intro {
		display: grid;
		place-items: center;
		/* Preserve the original title clearance as the shared header changes height. */
		padding: calc(clamp(9rem, 13vw, 13rem) + var(--site-header-height, 132px) - 76px)
			clamp(1.25rem, 5vw, 5rem) clamp(6rem, 9vw, 9rem);
	}

	.editorial-intro h1,
	.editorial-page .story h2 {
		margin: 0;
		font-family: var(--font-heading);
		text-align: center;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.editorial-intro h1 {
		max-width: 18ch;
		font-size: clamp(2.5rem, 5.2vw, 5.25rem);
		font-weight: 450;
		line-height: 0.96;
		letter-spacing: 0.1em;
	}

	.editorial-page .story {
		padding: 0 clamp(2rem, 6vw, 7.5rem) var(--story-gap);
	}

	.editorial-page .story[id],
	.editorial-page .editorial-opening[id] {
		scroll-margin-top: var(--story-scroll-offset);
	}

	.editorial-page .story h2 {
		margin-bottom: clamp(3rem, 5vw, 5rem);
		font-size: clamp(1.9rem, 3.2vw, 3.4rem);
		font-weight: 450;
		line-height: 1;
		letter-spacing: 0.045em;
	}

	.editorial-page .story__layout {
		display: grid;
		grid-template-columns: minmax(16rem, 0.58fr) minmax(38rem, 1.42fr);
		align-items: center;
		gap: clamp(2rem, 4vw, 5rem);
		width: min(100%, 1720px);
		margin: 0 auto;
	}

	.editorial-page .story--images-left .story__layout {
		grid-template-columns: minmax(38rem, 1.42fr) minmax(16rem, 0.58fr);
	}

	.editorial-page .story--images-right .collage {
		grid-column: 2;
		grid-row: 1;
	}

	.editorial-page .story--images-right .story__copy {
		grid-column: 1;
		grid-row: 1;
	}

	.editorial-page .story--images-left .collage {
		grid-column: 1;
		grid-row: 1;
	}

	.editorial-page .story--images-left .story__copy {
		grid-column: 2;
		grid-row: 1;
	}

	.editorial-page .story__copy {
		max-width: 37rem;
		text-align: center;
	}

	.editorial-page .story__copy p,
	.editorial-page .story__copy blockquote {
		margin: 0;
		font-size: clamp(1.15rem, 1.25vw, 1.35rem);
		font-weight: 400;
		line-height: 1.72;
		letter-spacing: 0.008em;
	}

	.editorial-page .story__copy p + p,
	.editorial-page .story__copy p + blockquote,
	.editorial-page .story__copy blockquote + p {
		margin-top: clamp(1.8rem, 3vw, 3rem);
	}

	.editorial-page .story__copy blockquote {
		position: relative;
		padding: clamp(1.4rem, 2.6vw, 2.4rem) 0;
		border-block: 1px solid var(--editorial-line);
		font-size: clamp(1.2rem, 1.45vw, 1.5rem);
		font-weight: 450;
		line-height: 1.48;
	}

	.editorial-page [data-editorial-flow] {
		transform: translate3d(0, var(--flow-parallax-y, 0), 0);
		will-change: transform;
	}

	.editorial-page .collage {
		position: relative;
		overflow: clip;
	}

	.editorial-page .collage--double {
		min-height: clamp(58rem, 108vh, 78rem);
	}

	.editorial-page .collage--triple {
		min-height: clamp(60rem, 112vh, 82rem);
	}

	.editorial-page .image-layer {
		position: absolute;
		margin: 0;
		overflow: hidden;
		background: var(--editorial-image-background);
		transform: translate3d(0, var(--parallax-y, 0), 0);
		will-change: transform;
	}

	.editorial-page .image-layer img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.editorial-page--dark .image-layer img {
		filter: saturate(0.72) contrast(1.04) brightness(0.9);
	}

	.editorial-page .image-layer--portrait {
		top: 0;
		z-index: 1;
		width: 78%;
		height: 92%;
	}

	.editorial-page .collage--right .image-layer--portrait {
		right: 0;
	}

	.editorial-page .collage--left .image-layer--portrait {
		left: 0;
	}

	.editorial-page .image-layer--landscape {
		bottom: 1%;
		z-index: 2;
		width: 70%;
		height: 48%;
	}

	.editorial-page .collage--right .image-layer--landscape {
		left: 0;
	}

	.editorial-page .collage--left .image-layer--landscape {
		right: 0;
	}

	.editorial-page .image-layer--team-main {
		top: 0;
		right: 0;
		z-index: 1;
		width: 90%;
		height: 64%;
	}

	.editorial-page .image-layer--team-conversation {
		left: 0;
		bottom: 0;
		z-index: 2;
		width: 66%;
		height: 45%;
	}

	.editorial-page .image-layer--team-workshop {
		right: 0;
		bottom: 8%;
		z-index: 3;
		width: 46%;
		height: 33%;
	}

	@supports not (text-wrap: balance) {
		.editorial-intro h1,
		.editorial-page .story h2 {
			text-wrap: normal;
		}
	}

	@media (max-width: 1040px) {
		.editorial-page .story__layout,
		.editorial-page .story--images-left .story__layout {
			grid-template-columns: minmax(14rem, 0.62fr) minmax(29rem, 1.38fr);
			gap: clamp(2rem, 4vw, 4rem);
		}

		.editorial-page .story--images-left .story__layout {
			grid-template-columns: minmax(29rem, 1.38fr) minmax(14rem, 0.62fr);
		}

		.editorial-page .story__copy p,
		.editorial-page .story__copy blockquote {
			font-size: 1.2rem;
		}

		.editorial-page .story__copy blockquote {
			font-size: 1.3rem;
		}
	}

	@media (max-width: 840px) {
		.editorial-page {
			--story-gap: clamp(4.5rem, 18vw, 6rem);
			--story-scroll-offset: calc(var(--site-header-height, 104px) + 1.25rem);
		}

		.editorial-page--light .editorial-opening,
		.editorial-page--light > .story:nth-last-child(2) {
			--story-gap: clamp(5.5rem, 22vw, 8rem);
		}

		.editorial-intro {
			padding: calc(var(--site-header-height, 104px) + 2.5rem) 1.25rem 3rem;
		}

		.editorial-intro h1 {
			font-size: clamp(2.1rem, 8.3vw, 3.2rem);
			line-height: 1.04;
			letter-spacing: 0.055em;
		}

		.editorial-intro h1:lang(en) {
			font-size: clamp(1.6rem, 7.2vw, 3.2rem);
		}

		.editorial-page .story {
			padding: 0 1.25rem var(--story-gap);
		}

		.editorial-page .story h2 {
			margin-bottom: clamp(2rem, 8vw, 3rem);
			font-size: clamp(1.4rem, 6.2vw, 2.8rem);
			line-height: 1.15;
			letter-spacing: 0.035em;
		}

		.editorial-page .story__layout,
		.editorial-page .story--images-left .story__layout {
			display: flex;
			flex-direction: column;
			gap: clamp(2rem, 8vw, 3rem);
		}

		.editorial-page .collage,
		.editorial-page .story__copy {
			width: 100%;
			max-width: none;
		}

		.editorial-page .collage--double {
			min-height: clamp(25rem, 125vw, 35rem);
		}

		.editorial-page .collage--triple {
			min-height: clamp(25rem, 130vw, 35rem);
		}

		.editorial-page .image-layer--portrait {
			width: 90%;
			height: 91%;
		}

		.editorial-page .image-layer--landscape {
			width: 78%;
			height: 43%;
		}

		.editorial-page .image-layer--team-main {
			width: 92%;
			height: 64%;
		}

		.editorial-page .image-layer--team-conversation {
			bottom: 0;
			width: 70%;
			height: 41%;
		}

		.editorial-page .image-layer--team-workshop {
			bottom: 10%;
			width: 54%;
			height: 30%;
		}

		.editorial-page .story__copy { overflow-wrap: normal; hyphens: auto; }

		.editorial-page .story__copy p {
			font-size: clamp(1.15rem, 4.8vw, 1.3rem);
			line-height: 1.68;
		}

		.editorial-page .story__copy blockquote {
			font-size: clamp(1.2rem, 5.1vw, 1.45rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.editorial-page [data-editorial-flow],
		.editorial-page .image-layer {
			transform: none !important;
			will-change: auto;
		}
	}
</style>
