---
import type { ImageMetadata } from 'astro';
import defaultOpenGraphImage from '../assets/oldtimer/hero-site-poster.jpg';
import {
	isTranslatedRoute,
	languageStorageKey,
	localeData,
	localizedRoute,
	normalizeRoute,
	type Locale,
} from '../config/i18n';
import { siteStatus } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	openGraphImage?: Pick<ImageMetadata, 'src' | 'width' | 'height' | 'format'>;
	openGraphImageAlt?: string;
	openGraphType?: string;
	structuredDataType?: string;
	dateModified?: string;
	additionalJsonLd?: Record<string, unknown> | Record<string, unknown>[];
	mainEntityId?: string;
	breadcrumbs?: Array<{ name: string; path: string }>;
	locale?: Locale;
	enableLanguageRedirect?: boolean;
}

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const {
	title,
	description = 'Die Oldtimermanufaktur restauriert klassische Automobile mit handwerklicher Präzision, technischer Sorgfalt und Respekt vor ihrer Geschichte.',
	noindex = false,
	openGraphImage = defaultOpenGraphImage,
	openGraphImageAlt = 'Ein historischer Roadster während einer Fahrt',
	openGraphType = 'website',
	structuredDataType = 'WebPage',
	dateModified = '2026-08-02',
	additionalJsonLd = [],
	mainEntityId,
	breadcrumbs,
	locale = 'de',
	enableLanguageRedirect = true,
} = Astro.props;
const language = localeData[locale];
const pageTitle = title ? `${title} | Die Oldtimermanufaktur` : 'Die Oldtimermanufaktur';
const isGitHubPagesPreview = siteStatus.developmentPreview && basePath !== '/';
const effectiveNoindex = noindex || isGitHubPagesPreview;
const siteUrl = Astro.site ?? Astro.url;
const siteRootUrl = new URL(basePath, siteUrl);
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const deploymentBase = basePath === '/' ? '' : basePath.replace(/\/$/, '');
const routePath = normalizeRoute(
	deploymentBase && Astro.url.pathname.startsWith(deploymentBase)
		? Astro.url.pathname.slice(deploymentBase.length)
		: Astro.url.pathname,
);
const translatedRoute = isTranslatedRoute(routePath);
const withBasePath = (path: string) =>
	path === '/' ? basePath : `${basePath}${path.replace(/^\//, '')}`;
const germanAlternateUrl = translatedRoute
	? new URL(withBasePath(localizedRoute(routePath, 'de')), siteUrl)
	: undefined;
const englishAlternateUrl = translatedRoute
	? new URL(withBasePath(localizedRoute(routePath, 'en')), siteUrl)
	: undefined;
const languageRedirectTarget = locale === 'de' ? englishAlternateUrl : germanAlternateUrl;
const languageBootstrap = `(() => {
	const currentLocale = ${JSON.stringify(locale)};
	const redirectEnabled = ${JSON.stringify(enableLanguageRedirect && translatedRoute)};
	const alternateUrl = ${JSON.stringify(languageRedirectTarget?.pathname ?? '')};
	let preferredLocale;
	try {
		const storedLocale = window.localStorage.getItem(${JSON.stringify(languageStorageKey)});
		if (storedLocale === 'de' || storedLocale === 'en') preferredLocale = storedLocale;
	} catch {}
	if (!preferredLocale) {
		preferredLocale = (navigator.language || '').toLowerCase().startsWith('de') ? 'de' : 'en';
	}
	if (redirectEnabled && preferredLocale !== currentLocale && alternateUrl) {
		window.location.replace(alternateUrl);
	}
})();`;
const openGraphImageUrl = new URL(openGraphImage.src, siteUrl);
const sitemapUrl = new URL(`${basePath}sitemap.xml`, siteUrl);
const llmsUrl = new URL(`${basePath}llms.txt`, siteUrl);
const openGraphImageType = openGraphImage.format === 'jpg'
	? 'image/jpeg'
	: `image/${openGraphImage.format}`;
const organizationId = `${siteRootUrl.href}#organization`;
const websiteId = `${siteRootUrl.href}#website`;
const webpageId = `${pageUrl.href}#webpage`;
const primaryImageId = `${pageUrl.href}#primaryimage`;
const breadcrumbId = `${pageUrl.href}#breadcrumb`;
const extraJsonLdNodes = Array.isArray(additionalJsonLd)
	? additionalJsonLd
	: [additionalJsonLd];
const webpageData: Record<string, unknown> = {
	'@type': structuredDataType,
	'@id': webpageId,
	url: pageUrl.href,
	name: pageTitle,
	description,
	inLanguage: language.htmlLang,
	dateModified,
	isPartOf: { '@id': websiteId },
	about: { '@id': organizationId },
	primaryImageOfPage: { '@id': primaryImageId },
};

if (mainEntityId) {
	webpageData.mainEntity = { '@id': mainEntityId };
}

const jsonLdGraph: Record<string, unknown>[] = [
	{
		'@type': 'AutoRepair',
		'@id': organizationId,
		name: 'Die Oldtimermanufaktur',
		legalName: 'DIE OLDTIMERMANUFAKTUR GmbH',
		url: siteRootUrl.href,
		logo: new URL(`${basePath}favicon.svg`, siteUrl).href,
		description: locale === 'de'
			? 'Die Oldtimermanufaktur restauriert und bewahrt historische Automobile mit traditionellem Handwerk, technischer Sorgfalt und Liebe zum Detail.'
			: 'The Oldtimermanufaktur restores and preserves historic automobiles through traditional craftsmanship, technical care and attention to detail.',
		foundingDate: '1987',
		founder: {
			'@type': 'Person',
			name: 'Mario Schrank',
		},
		telephone: '+49 36966 83783',
		faxNumber: '+49 36966 83635',
		email: 'info@oldtimermanufaktur.de',
		address: {
			'@type': 'PostalAddress',
			streetAddress: 'Kreuzweg 11a',
			postalCode: '36452',
			addressLocality: 'Kaltennordheim-Fischbach',
			addressCountry: 'DE',
		},
	},
	{
		'@type': 'WebSite',
		'@id': websiteId,
		url: siteRootUrl.href,
		name: 'Die Oldtimermanufaktur',
		inLanguage: language.htmlLang,
		publisher: { '@id': organizationId },
	},
	{
		'@type': 'ImageObject',
		'@id': primaryImageId,
		contentUrl: openGraphImageUrl.href,
		url: openGraphImageUrl.href,
		width: openGraphImage.width,
		height: openGraphImage.height,
		caption: openGraphImageAlt,
	},
	webpageData,
];

const breadcrumbItems = breadcrumbs ?? (
	title
		? [
				{ name: locale === 'de' ? 'Startseite' : 'Home', path: locale === 'de' ? '/' : '/en/' },
				{ name: title, path: '' },
			]
		: []
);

if (breadcrumbItems.length) {
	webpageData.breadcrumb = { '@id': breadcrumbId };
	jsonLdGraph.push({
		'@type': 'BreadcrumbList',
		'@id': breadcrumbId,
		itemListElement: breadcrumbItems.map((item, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			name: item.name,
			item:
				item.path === '/'
					? siteRootUrl.href
					: item.path === ''
						? pageUrl.href
						: new URL(item.path.replace(/^\//, ''), siteRootUrl).href,
		})),
	});
}

jsonLdGraph.push(...extraJsonLdNodes);
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': jsonLdGraph,
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={language.htmlLang} prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<link rel="apple-touch-icon" href={`${basePath}apple-touch-icon.png`} />
		<link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl.href} />
		<link rel="alternate" type="text/markdown" title="llms.txt" href={llmsUrl.href} />
		<meta name="description" content={description} />
		<meta name="date" content={dateModified} />
		{effectiveNoindex && <meta name="robots" content="noindex,follow,noarchive" />}
		{!effectiveNoindex && <meta name="robots" content="index,follow,max-image-preview:large" />}
		{!effectiveNoindex && <link rel="canonical" href={pageUrl.href} />}
		{!effectiveNoindex && germanAlternateUrl && <link rel="alternate" hreflang="de-DE" href={germanAlternateUrl.href} />}
		{!effectiveNoindex && englishAlternateUrl && <link rel="alternate" hreflang="en" href={englishAlternateUrl.href} />}
		{!effectiveNoindex && germanAlternateUrl && <link rel="alternate" hreflang="x-default" href={germanAlternateUrl.href} />}
		<meta property="og:title" content={pageTitle} />
		<meta property="og:type" content={openGraphType} />
		<meta property="og:image" content={openGraphImageUrl} />
		<meta property="og:image:secure_url" content={openGraphImageUrl} />
		<meta property="og:image:type" content={openGraphImageType} />
		<meta property="og:image:width" content={String(openGraphImage.width)} />
		<meta property="og:image:height" content={String(openGraphImage.height)} />
		<meta property="og:image:alt" content={openGraphImageAlt} />
		<meta property="og:url" content={pageUrl.href} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={language.openGraphLocale} />
		{translatedRoute && locale === 'de' && <meta property="og:locale:alternate" content="en_GB" />}
		{translatedRoute && locale === 'en' && <meta property="og:locale:alternate" content="de_DE" />}
		<meta property="og:site_name" content="Die Oldtimermanufaktur" />
		{!effectiveNoindex && <script type="application/ld+json" set:html={jsonLd} />}
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<script is:inline set:html={languageBootstrap} />
		<script is:inline>
			(() => {
				const userAgent = navigator.userAgent;
				const safariVersion = Number(userAgent.match(/Version\/(\d+)/)?.[1] ?? 0);
				const isIOS =
					/iP(?:hone|ad|od)/.test(userAgent) ||
					(navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
				const isSafari =
					/Safari\//.test(userAgent) &&
					!/(?:CriOS|FxiOS|EdgiOS|OPiOS)/.test(userAgent);

				if (isIOS && isSafari && safariVersion >= 26) {
					document.documentElement.classList.add('ios-safari-liquid-glass');
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">
			{locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
		</a>
		<slot />
		<script>
			document.addEventListener('contextmenu', (event) => {
				if (
					event.target instanceof Element &&
					event.target.closest('img, picture, video')
				) {
					event.preventDefault();
				}
			});

			document.addEventListener('dragstart', (event) => {
				if (
					event.target instanceof Element &&
					event.target.closest('img, picture, video')
				) {
					event.preventDefault();
				}
			});
		</script>
	</body>
</html>

<style>
	@font-face {
		/* Cormorant Garamond, SIL OFL 1.1; see /licenses/Cormorant-Garamond-OFL-1.1.txt */
		font-family: 'Cormorant Garamond';
		src: url('../assets/fonts/cormorant-garamond-variable.ttf') format('truetype');
		font-weight: 300 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: 'Cormorant Garamond';
		src: url('../assets/fonts/cormorant-garamond-variable-italic.ttf') format('truetype');
		font-weight: 300 700;
		font-style: italic;
		font-display: swap;
	}

	:root {
		--color-background: #101010;
		--color-main: #eeeeee;
		--color-line: rgba(238, 238, 238, 0.18);
		--font-body: 'Cormorant Garamond', Georgia, serif;
		--text-utility: clamp(0.72rem, 0.7rem + 0.12vw, 0.8rem);
		--text-small: clamp(0.84rem, 0.81rem + 0.14vw, 0.94rem);
		--text-body: clamp(1rem, 0.97rem + 0.16vw, 1.12rem);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: var(--color-background);
		color: var(--color-main);
		font-family: var(--font-body);
		font-weight: 400;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	html {
		font-size: 100%;
	}

	body {
		font-size: var(--text-body);
		overflow-x: hidden;
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 2000;
		padding: 0.8rem 1rem;
		color: #101010;
		background: #eeeeee;
		border: 1px solid #eeeeee;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 500;
		transform: translateY(calc(-100% - 1rem));
		transition: transform 160ms ease;
	}

	.skip-link:focus {
		outline: 2px solid #101010;
		outline-offset: -4px;
		transform: translateY(0);
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(img),
	:global(picture),
	:global(video),
	:global(svg) {
		display: block;
		-webkit-user-select: none;
		user-select: none;
		-webkit-user-drag: none;
		user-drag: none;
	}

	button,
	a {
		font: inherit;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			scroll-behavior: auto !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
