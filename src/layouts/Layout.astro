---
interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const {
	title,
	description = 'Die Oldtimermanufaktur restauriert klassische Automobile mit handwerklicher Präzision, technischer Sorgfalt und Respekt vor ihrer Geschichte.',
	noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} | Die Oldtimermanufaktur` : 'Die Oldtimermanufaktur';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<link rel="icon" href={`${basePath}favicon.ico`} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex,follow" />}
		{canonicalUrl && !noindex && <link rel="canonical" href={canonicalUrl} />}
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<script is:inline>
			(() => {
				const userAgent = navigator.userAgent;
				const safariVersion = Number(userAgent.match(/Version\/(\d+)/)?.[1] ?? 0);
				const isIOS =
					/iP(?:hone|ad|od)/.test(userAgent) ||
					(navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
				const isSafari =
					/Safari\//.test(userAgent) &&
					!/(?:CriOS|FxiOS|EdgiOS|OPiOS)/.test(userAgent);

				if (isIOS && isSafari && safariVersion >= 26) {
					document.documentElement.classList.add('ios-safari-liquid-glass');
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Zum Inhalt springen</a>
		<slot />
		<script>
			document.addEventListener('contextmenu', (event) => {
				event.preventDefault();
			});

			document.addEventListener('dragstart', (event) => {
				if (event.target instanceof HTMLImageElement) {
					event.preventDefault();
				}
			});
		</script>
	</body>
</html>

<style>
	@font-face {
		font-family: 'Jost';
		src: url('../assets/fonts/jost-variable.ttf') format('truetype');
		font-weight: 300 600;
		font-style: normal;
		font-display: swap;
	}

	:root {
		--color-background: #101010;
		--color-main: #eeeeee;
		--color-line: rgba(238, 238, 238, 0.18);
		--font-body: 'Jost', 'Helvetica Neue', sans-serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: var(--color-background);
		color: var(--color-main);
		font-family: var(--font-body);
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
	}

	body {
		overflow-x: hidden;
	}

	.skip-link {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 2000;
		padding: 0.8rem 1rem;
		color: #101010;
		background: #eeeeee;
		border: 1px solid #eeeeee;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.72rem;
		font-weight: 500;
		transform: translateY(calc(-100% - 1rem));
		transition: transform 160ms ease;
	}

	.skip-link:focus {
		outline: 2px solid #101010;
		outline-offset: -4px;
		transform: translateY(0);
	}

	:global(*) {
		box-sizing: border-box;
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
	}

	:global(*::selection) {
		background: transparent;
		color: inherit;
	}

	:global(img),
	:global(svg) {
		display: block;
		-webkit-user-drag: none;
		user-drag: none;
	}

	button,
	a {
		font: inherit;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.001ms !important;
			animation-iteration-count: 1 !important;
			scroll-behavior: auto !important;
			transition-duration: 0.001ms !important;
		}
	}
</style>
