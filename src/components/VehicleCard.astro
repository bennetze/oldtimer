---
import { vehicleImageRoute, vehicleRoute, type VehicleEntry } from '../config/vehicles';

interface Props {
	vehicle: VehicleEntry;
	index: number;
	defaultVisible?: boolean;
}

const { vehicle, index, defaultVisible = true } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string) => `${basePath}${path.replace(/^\//, '')}`;
---

<article
	class="vehicle-card"
	style={`--card-index: ${index}`}
	data-vehicle-card
	data-search-value={vehicle.data.title}
	data-default-visible={defaultVisible ? 'true' : 'false'}
	hidden={!defaultVisible}
>
	<a href={sitePath(vehicleRoute(vehicle))} aria-label={vehicle.data.title}>
		<div class="vehicle-card__media">
			<img
				src={sitePath(vehicleImageRoute(vehicle, vehicle.data.cardImage))}
				alt={vehicle.data.cardImageAlt}
				loading={index < 6 ? 'eager' : 'lazy'}
				fetchpriority={index === 0 ? 'high' : 'auto'}
				decoding="async"
			/>
		</div>
		<div class="vehicle-card__copy">
			<h2>{vehicle.data.title}</h2>
		</div>
	</a>
</article>

<style>
	.vehicle-card {
		min-width: 0;
		border: 1px solid rgba(17, 17, 17, 0.34);
		background: rgba(238, 238, 238, 0.68);
		animation: card-enter 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: calc(150ms + min(var(--card-index), 8) * 48ms);
		transition:
			border-color 320ms ease,
			background-color 320ms ease;
	}

	.vehicle-card a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.vehicle-card__media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-bottom: 1px solid rgba(17, 17, 17, 0.34);
		background: #d8d8d8;
	}

	.vehicle-card__media::after {
		position: absolute;
		inset: 0;
		background: rgba(17, 17, 17, 0.08);
		content: '';
		opacity: 0;
		transition: opacity 420ms ease;
		pointer-events: none;
	}

	.vehicle-card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.94) contrast(1.02);
		transform: scale(1.002);
		transition:
			filter 520ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.vehicle-card__copy {
		display: flex;
		align-items: flex-start;
		min-height: 7.25rem;
		padding: 1.45rem clamp(1.2rem, 1.7vw, 1.75rem) 1.65rem;
	}

	.vehicle-card h2 {
		margin: 0;
		font-size: clamp(0.84rem, 0.96vw, 1rem);
		font-weight: 460;
		letter-spacing: 0.115em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.vehicle-card a:focus-visible {
		outline: 2px solid #111111;
		outline-offset: 3px;
	}

	@media (hover: hover) and (pointer: fine) {
		.vehicle-card:hover,
		.vehicle-card:has(a:focus-visible) {
			border-color: #111111;
			background: rgba(238, 238, 238, 0.88);
		}

		.vehicle-card a:hover .vehicle-card__media :global(img),
		.vehicle-card a:focus-visible .vehicle-card__media :global(img) {
			filter: saturate(1.06) contrast(1.02);
			transform: scale(1.022);
		}

		.vehicle-card a:hover .vehicle-card__media::after,
		.vehicle-card a:focus-visible .vehicle-card__media::after {
			opacity: 1;
		}
	}

	@keyframes card-enter {
		from {
			opacity: 0;
			transform: translateY(1.15rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 680px) {
		.vehicle-card__copy {
			min-height: 6rem;
			padding: 1.3rem 1.25rem 1.45rem;
		}

		.vehicle-card h2 {
			font-size: 0.88rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.vehicle-card {
			animation: none;
		}

		.vehicle-card,
		.vehicle-card__media::after,
		.vehicle-card__media :global(img) {
			transition: none;
		}
	}
</style>
