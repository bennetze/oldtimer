---
import BackgroundTexture from './BackgroundTexture.astro';

interface Props {
	title: string;
	eyebrow: string;
}

const { title, eyebrow } = Astro.props;
---

<main class="legal-page textured-background gradient-palette" id="main-content" tabindex="-1">
	<BackgroundTexture />
	<header class="legal-hero">
		<p>{eyebrow}</p>
		<h1>{title}</h1>
	</header>
	<div class="legal-body">
		<article class="legal-copy">
			<h2>In Vorbereitung</h2>
			<slot />
		</article>
	</div>
</main>

<style>
	.legal-page {
		min-height: 100vh;
		min-height: 100svh;
		--legal-fade: clamp(28rem, 65vw, 64rem);
		color: var(--gradient-ink);
		background: var(--gradient-cream);
	}

	.legal-hero {
		position: relative;
	}

	.legal-hero::before,
	.legal-body::before {
		position: absolute;
		inset: 0;
		z-index: -2;
		content: '';
		pointer-events: none;
	}

	.legal-hero::before {
		bottom: -2px;
		background:
			var(--gradient-descend) bottom / 100% var(--legal-fade) no-repeat,
			linear-gradient(var(--gradient-cream), var(--gradient-cream))
				top / 100% calc(100% - var(--legal-fade) + 2px) no-repeat var(--gradient-green);
	}

	.legal-body {
		position: relative;
		padding-bottom: var(--legal-fade);
		color: #ffffff;
	}

	.legal-body::before {
		bottom: -2px;
		background:
			var(--gradient-ascend) bottom / 100% var(--legal-fade) no-repeat,
			linear-gradient(var(--gradient-green), var(--gradient-green))
				top / 100% calc(100% - var(--legal-fade) + 2px) no-repeat var(--gradient-green);
	}

	.legal-hero {
		padding: calc(clamp(9rem, 13vw, 13rem) + var(--site-header-height, 132px) - 76px)
			clamp(1.25rem, 5vw, 5rem) var(--legal-fade);
		text-align: center;
	}

	.legal-hero p {
		margin: 0 0 1.75rem;
		text-transform: uppercase;
		letter-spacing: 0.24em;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.legal-hero h1 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2rem, 5.2vw, 5.25rem);
		font-weight: 350;
		line-height: 1.12;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
		hyphens: auto;
		hyphenate-limit-chars: 10 6 9;
	}

	.legal-copy {
		width: min(42rem, calc(100% - 3rem));
		margin: 0 auto;
		padding-top: clamp(2rem, 4vw, 3.5rem);
	}

	.legal-copy h2 {
		margin: 0 0 1.5rem;
		font-family: var(--font-heading);
		font-size: clamp(1rem, 1.5vw, 1.35rem);
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.legal-copy :global(p) {
		margin: 0;
		font-size: clamp(1.15rem, 1.25vw, 1.35rem);
		font-weight: 600;
		line-height: 1.75;
	}

	@media (max-width: 760px) {
		.legal-hero {
			padding-top: calc(var(--site-header-height, 132px) + 4rem);
		}

		.legal-hero h1 {
			font-size: clamp(1.65rem, 7vw, 3rem);
			letter-spacing: 0.035em;
		}
	}
</style>
