---
import BackgroundTexture from './BackgroundTexture.astro';

interface Props {
	title: string;
	eyebrow: string;
}

const { title, eyebrow } = Astro.props;
---

<main class="legal-page textured-background" id="main-content" tabindex="-1">
	<BackgroundTexture />
	<header class="legal-hero">
		<p>{eyebrow}</p>
		<h1>{title}</h1>
	</header>
	<article class="legal-copy">
		<h2>In Vorbereitung</h2>
		<slot />
	</article>
</main>

<style>
	.legal-page {
		min-height: 100vh;
		min-height: 100svh;
		padding-bottom: clamp(6rem, 12vw, 12rem);
		color: #111111;
		background: linear-gradient(180deg, #ffffff 0%, #ffffff 11%, #f7eee2 18%, #f8f3ec 30%, #e9dacf 39%, #b1b6d5 47%, #8faede 54%, #80a3d1 61%, #8bb0e1 70%, #a6c6ec 82%, #ffffff 100%);
	}

	.legal-hero {
		padding: calc(clamp(9rem, 13vw, 13rem) + var(--site-header-height, 132px) - 76px)
			clamp(1.25rem, 5vw, 5rem) clamp(4rem, 7vw, 7rem);
		text-align: center;
	}

	.legal-hero p {
		margin: 0 0 1.75rem;
		text-transform: uppercase;
		letter-spacing: 0.24em;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.legal-hero h1 {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2rem, 5.2vw, 5.25rem);
		font-weight: 350;
		line-height: 1.12;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		overflow-wrap: anywhere;
		hyphens: auto;
		hyphenate-limit-chars: 10 6 9;
	}

	.legal-copy {
		width: min(42rem, calc(100% - 3rem));
		margin: 0 auto;
		padding-top: clamp(2rem, 4vw, 3.5rem);
		border-top: 1px solid rgba(17, 17, 17, 0.34);
	}

	.legal-copy h2 {
		margin: 0 0 1.5rem;
		font-family: var(--font-heading);
		font-size: clamp(1rem, 1.5vw, 1.35rem);
		font-weight: 500;
		line-height: 1.4;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.legal-copy :global(p) {
		margin: 0;
		font-size: clamp(1.15rem, 1.25vw, 1.35rem);
		font-weight: 600;
		line-height: 1.75;
	}

	@media (max-width: 760px) {
		.legal-hero {
			padding-top: calc(var(--site-header-height, 132px) + 4rem);
		}

		.legal-hero h1 {
			font-size: clamp(1.65rem, 7vw, 3rem);
			letter-spacing: 0.035em;
		}
	}
</style>
