---
import texture from '../assets/oldtimer/L1007006.webp';
---

<div class="background-texture" aria-hidden="true">
	<!-- One unmodified photograph, cropped past the deep fold at its left edge.
	     A viewport-sized surface avoids both tile seams and page-length stretching. -->
	<div class="background-texture__viewport">
		<svg class="background-texture__surface" viewBox="400 100 1395 1450" preserveAspectRatio="xMidYMid slice" focusable="false">
			<image href={texture.src} width={texture.width} height={texture.height} />
		</svg>
	</div>
</div>

<style>
	.background-texture {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		user-select: none;
		/* Clip the fixed surface to this main, including at the footer boundary.
		   Keep the surface out of the footer. */
		clip: rect(0, auto, auto, 0);
	}

	.background-texture__viewport {
		opacity: 0.13;
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
	}

	.background-texture__surface {
		width: 100%;
		height: 100%;
		display: block;
	}
</style>

<style is:global>
	/* Contain the decorative surface below content without changing focus. */
	.textured-background {
		position: relative;
		isolation: isolate;
	}
</style>
