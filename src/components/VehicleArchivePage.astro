---
import { localizeVehicle, vehicleLanguage } from '../config/vehicleLocale.js';
import { vehicleImage } from '../config/vehicleImages';
import Layout from '../layouts/Layout.astro';
import defaultOpenGraphImage from '../assets/oldtimer/hero-site-poster.jpg';
import { pageModified } from '../config/modificationDates.js';
import SiteChrome from './SiteChrome.astro';
import BackgroundTexture from './BackgroundTexture.astro';
import VehicleCard from './VehicleCard.astro';
import {
	categoryByKey,
	vehicleCategories,
	vehicleRoute,
	type VehicleCategoryKey,
	type VehicleEntry,
} from '../config/vehicles';

interface Props {
	category: VehicleCategoryKey;
	vehicles: VehicleEntry[];
	currentPage?: number;
	pageSize?: number;
}

const { category, vehicles, currentPage = 1, pageSize = vehicles.length || 1 } = Astro.props;
const categoryData = categoryByKey[category];
const totalPages = Math.ceil(vehicles.length / pageSize);
const safePage = Math.min(Math.max(currentPage, 1), Math.max(totalPages, 1));
const firstIndex = (safePage - 1) * pageSize;
const visibleVehicles = vehicles.slice(firstIndex, firstIndex + pageSize);
const lastIndex = firstIndex + visibleVehicles.length;
const searchId = `vehicle-search-${category}`;
const gridId = `vehicle-grid-${category}`;
const pageTitle = safePage > 1 ? `${categoryData.heading} – Seite ${safePage}` : categoryData.heading;
const language = vehicleLanguage(Astro.url.pathname, import.meta.env.BASE_URL);
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string) => `${basePath}${path.replace(/^\//, '')}`;
const pagePath = (page: number) =>
	page === 1
		? `/projekte/${category}/`
		: `/projekte/${category}/seite/${page}/`;
const siteUrl = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(sitePath(path), siteUrl).href;
const openGraphVehicle = visibleVehicles[0] ?? vehicles[0];
const openGraphImage = openGraphVehicle ? {
	...vehicleImage(openGraphVehicle, openGraphVehicle.data.cardImage, 'card', basePath),
	format: 'webp' as const,
} : defaultOpenGraphImage;
const openGraphImageAlt = (openGraphVehicle ? localizeVehicle(openGraphVehicle.data, language).cardImageAlt : undefined) ?? 'Ein historischer Roadster während einer Fahrt';
const collectionId = `${absolute(pagePath(safePage))}#itemlist`;
const itemList = {
	'@type': 'ItemList',
	'@id': collectionId,
	name: pageTitle,
	numberOfItems: vehicles.length,
	itemListOrder: 'https://schema.org/ItemListOrderAscending',
	itemListElement: visibleVehicles.map((vehicle, index) => ({
		'@type': 'ListItem',
		position: firstIndex + index + 1,
		name: localizeVehicle(vehicle.data, language).title,
		__authored: ['name'],
		url: absolute(vehicleRoute(vehicle)),
	})),
};
---

<Layout
	authoredImageAlt={Boolean(openGraphVehicle)}
	title={pageTitle}
	description={categoryData.description}
	openGraphImage={openGraphImage}
	{openGraphImageAlt}
	structuredDataType="CollectionPage"
	dateModified={pageModified(pagePath(safePage), vehicles.map((vehicle) => vehicle.data.dateModified))}
	additionalJsonLd={itemList}
	mainEntityId={collectionId}
	breadcrumbs={[
		{ name: 'Startseite', path: '/' },
		{ name: 'Projekte', path: '/projekte/' },
		{ name: categoryData.label, path: `/projekte/${category}/` },
	]}
>
	<SiteChrome theme="light">
		<main class="vehicle-archive textured-background" id="main-content" tabindex="-1">
			<BackgroundTexture />
			<header class="archive-intro">
				<h1>{categoryData.heading}</h1>
			</header>

			<nav class="category-switcher" aria-label="Projektbereiche">
				<button class="category-switcher__toggle" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="project-category-dialog" hidden>
					<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h10M4 17h16" /></svg>
					<span>Projektbereich wechseln</span>
					<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
				</button>
				<div class="category-switcher__links" id="project-category-links">
				{
					vehicleCategories.map((item) => (
						<a
							href={sitePath(`/projekte/${item.key}/`)}
							aria-current={item.key === category ? 'page' : undefined}
							data-category-link
						>
							<span>{item.label}</span>
						</a>
					))
				}
				</div>
			</nav>

			<dialog class="category-dialog" id="project-category-dialog" aria-labelledby="project-category-title">
				<header class="category-dialog__header">
					<h2 id="project-category-title">Projektbereiche</h2>
					<button class="category-dialog__close" type="button" aria-label="Schließen" autofocus>
						<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6" /></svg>
					</button>
				</header>
				<nav class="category-dialog__links" aria-label="Projektbereiche">
					{vehicleCategories.map((item, index) => (
						<a href={sitePath(`/projekte/${item.key}/`)} aria-current={item.key === category ? 'page' : undefined}>
							<span class="category-dialog__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<span class="category-dialog__name">{item.label}{item.key === category && <small>Ausgewählt</small>}</span>
							<svg aria-hidden="true" viewBox="0 0 24 24"><path d={item.key === category ? 'm5 12 4 4L19 6' : 'M4 12h15m-6-6 6 6-6 6'} /></svg>
						</a>
					))}
				</nav>
			</dialog>

			<form class="archive-search" role="search" aria-label={categoryData.label} data-vehicle-search hidden>
				<label for={searchId}>Fahrzeugsuche</label>
				<div class="archive-search__field">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<circle cx="10.5" cy="10.5" r="6.75" />
						<path d="m15.5 15.5 5 5" />
					</svg>
					<input
						id={searchId}
						type="search"
						placeholder="Fahrzeugname eingeben"
						aria-controls={gridId}
						autocomplete="off"
						spellcheck="false"
						data-vehicle-search-input
					/>
					<button type="button" data-vehicle-search-clear hidden>Löschen</button>
				</div>
				<p class="archive-search__empty" data-vehicle-search-empty hidden>
					Kein Fahrzeug für diese Suche gefunden.
				</p>
				<span class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-vehicle-search-status></span>
			</form>

			{!vehicles.length && <p class="archive-empty">Zurzeit sind in diesem Bereich keine Fahrzeuge veröffentlicht.</p>}

			<section id={gridId} class="vehicle-grid" aria-label={`${categoryData.label}, Seite ${safePage}`}>
				{
					visibleVehicles.map((vehicle, index) => <VehicleCard vehicle={vehicle} index={index} />)
				}
			</section>
			<template data-archive-deferred>
				{vehicles.map((vehicle, index) => index < firstIndex || index >= lastIndex
					? <VehicleCard vehicle={vehicle} index={pageSize + index} defaultVisible={false} /> : null)}
			</template>

			{
				totalPages > 1 && (
					<nav class="pagination" aria-label="Seitennavigation">
						{safePage > 1 && (
							<a class="pagination__direction" href={sitePath(pagePath(safePage - 1))} rel="prev">
								<span aria-hidden="true">←</span> Zurück
							</a>
						)}
						<div class="pagination__pages">
							{Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
								<a
									href={sitePath(pagePath(page))}
									aria-current={page === safePage ? 'page' : undefined}
									aria-label={`Seite ${String(page).padStart(2, '0')}`}
								>
									{String(page).padStart(2, '0')}
								</a>
							))}
						</div>
						{safePage < totalPages && (
							<a class="pagination__direction" href={sitePath(pagePath(safePage + 1))} rel="next">
								Weiter <span aria-hidden="true">→</span>
							</a>
						)}
					</nav>
				)
			}
		</main>
	</SiteChrome>
</Layout>

<script>
	import { watchMedia, createModal } from '../scripts/accessibility.js';
	import { createCardFilter } from '../scripts/archiveSearch.js';
	import { restoreArchiveQuery, saveArchiveQuery } from '../scripts/archiveHistory.js';
	const archive = document.querySelector('.vehicle-archive');
	const categoryToggle = archive?.querySelector<HTMLButtonElement>('.category-switcher__toggle');
	const categoryLinks = archive?.querySelector<HTMLElement>('.category-switcher__links');
	const categoryDialog = archive?.querySelector<HTMLDialogElement>('.category-dialog');
	const mobileCategories = window.matchMedia('(max-width: 760px)');
	if (categoryToggle && categoryLinks && categoryDialog && typeof categoryDialog.showModal === 'function' && typeof categoryDialog.close === 'function') {
		const categoryModal = createModal(categoryDialog);
		const closeCategories = () => categoryModal.close();
		const syncCategoryLayout = () => {
			const focused = document.activeElement;
			const wasOpen = categoryDialog.open;
			if (wasOpen) closeCategories();
			categoryToggle.hidden = !mobileCategories.matches;
			categoryLinks.hidden = mobileCategories.matches;
			if (!mobileCategories.matches && (wasOpen || focused === categoryToggle)) categoryLinks.querySelector<HTMLAnchorElement>('[aria-current="page"]')?.focus();
			if (mobileCategories.matches && categoryLinks.contains(focused)) categoryToggle.focus();
		};
		categoryToggle.addEventListener('click', () => {
			categoryModal.open(categoryToggle);
			categoryToggle.setAttribute('aria-expanded', 'true');
			document.body.classList.add('category-dialog-open');
		});
		categoryDialog.querySelector('.category-dialog__close')?.addEventListener('click', closeCategories);
		categoryDialog.addEventListener('click', (event) => {
			if (event.target !== categoryDialog) return;
			const bounds = categoryDialog.getBoundingClientRect();
			if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) closeCategories();
		});
		categoryDialog.addEventListener('close', () => {
			categoryToggle.setAttribute('aria-expanded', 'false');
			document.body.classList.remove('category-dialog-open');
			if (mobileCategories.matches) categoryToggle.focus();
		});
		window.addEventListener('pagehide', closeCategories);
		watchMedia(mobileCategories, syncCategoryLayout);
		syncCategoryLayout();
	}
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const searchForm = archive?.querySelector('[data-vehicle-search]');
	const searchInput = searchForm?.querySelector('[data-vehicle-search-input]');
	const clearSearch = searchForm?.querySelector('[data-vehicle-search-clear]');
	const emptySearch = searchForm?.querySelector('[data-vehicle-search-empty]');
	const searchStatus = searchForm?.querySelector('[data-vehicle-search-status]');
	const pagination = archive?.querySelector('.pagination');
	const vehicleCards = Array.from(archive?.querySelectorAll('[data-vehicle-card]') ?? []).filter(
		(card): card is HTMLElement => card instanceof HTMLElement,
	);

	const grid = archive?.querySelector('.vehicle-grid');
	const deferred = archive?.querySelector<HTMLTemplateElement>('[data-archive-deferred]');
	const filterCards = createCardFilter(vehicleCards, reducedMotion, () => {
		if (!deferred || !grid) return [];
		const cards = [...deferred.content.querySelectorAll<HTMLElement>('[data-vehicle-card]')];
		const languageChoice = new URL(window.location.href).searchParams.get('lang');
		if (languageChoice === 'de' || languageChoice === 'en') {
			deferred.content.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => {
				const target = new URL(link.href, window.location.href);
				target.searchParams.set('lang', languageChoice);
				link.href = `${target.pathname}${target.search}${target.hash}`;
			});
		}
		grid.append(deferred.content);
		[...grid.querySelectorAll<HTMLElement>('[data-vehicle-card]')].sort((a, b) => Number(a.dataset.vehicleOrder) - Number(b.dataset.vehicleOrder)).forEach(card => grid.append(card));
		return cards;
	});
	if (searchForm instanceof HTMLElement && vehicleCards.length) searchForm.hidden = false;
	const pageGridLabel = grid?.getAttribute('aria-label') ?? '';

	const updateVehicleSearch = () => {
		if (!(searchInput instanceof HTMLInputElement)) return;

		const rawQuery = searchInput.value.trim();
		const { searching: isSearching, count: matchCount } = filterCards(rawQuery);
		grid?.setAttribute('aria-label', isSearching
			? (document.documentElement.lang === 'en' ? 'Vehicle search results' : 'Ergebnisse der Fahrzeugsuche')
			: pageGridLabel);

		if (clearSearch instanceof HTMLButtonElement) clearSearch.hidden = !rawQuery;
		if (pagination instanceof HTMLElement) pagination.hidden = isSearching;
		if (emptySearch instanceof HTMLElement) emptySearch.hidden = !isSearching || matchCount > 0;
		if (searchStatus instanceof HTMLElement) {
			searchStatus.textContent = isSearching
				? matchCount === 1
					? (document.documentElement.lang === 'en' ? 'One vehicle found.' : 'Ein Fahrzeug gefunden.')
					: (document.documentElement.lang === 'en' ? `${matchCount} vehicles found.` : `${matchCount} Fahrzeuge gefunden.`)
				: '';
		}
	};

	const restoreArchive = () => {
		if (searchInput instanceof HTMLInputElement) searchInput.value = restoreArchiveQuery(window.history, window.location.pathname, searchInput.value);
		updateVehicleSearch();
	};
	window.addEventListener('pageshow', restoreArchive);
	restoreArchive();

	searchForm?.addEventListener('submit', (event) => event.preventDefault());
	searchInput?.addEventListener('input', () => {
		if (searchInput instanceof HTMLInputElement) saveArchiveQuery(window.history, window.location.pathname, searchInput.value);
		updateVehicleSearch();
	});
	clearSearch?.addEventListener('click', () => {
		if (!(searchInput instanceof HTMLInputElement)) return;
		searchInput.value = '';
		saveArchiveQuery(window.history, window.location.pathname, '');
		updateVehicleSearch();
		searchInput.focus();
	});

</script>

<style>
	.vehicle-archive {
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(10.5rem, 15vw, 14rem) clamp(1.25rem, 4.8vw, 5.5rem) clamp(8rem, 12vw, 13rem);
		background:
			linear-gradient(
				180deg,
				#ffffff 0,
				#ffffff 16rem,
				#f7eee2 28rem,
				#f8f3ec 40rem,
				#e9dacf 51rem,
				#b1b6d5 63rem,
				#8faede 76rem,
				#80a3d1 90rem,
				#8bb0e1 105rem,
				#a6c6ec 122rem,
				#eeeeee 154rem
			);
		color: #000000;
	}

	.archive-intro {
		padding: clamp(2.5rem, 5vw, 4.75rem) 0 clamp(3rem, 5vw, 5rem);
	}

	.archive-intro h1 {
		margin: 0;
		font-size: clamp(2.65rem, 4.75vw, 5rem);
		font-weight: 360;
		letter-spacing: 0.075em;
		line-height: 0.98;
		text-transform: uppercase;
		animation: heading-enter 680ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.category-switcher {
		margin-bottom: clamp(2rem, 4vw, 4rem);
	}

	.category-switcher__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem clamp(1.5rem, 4vw, 4rem);
		border-bottom: 1px solid rgba(17, 17, 17, 0.3);
	}

	.category-switcher a {
		display: flex;
		align-items: center;
		min-height: 52px;
		padding: 0.75rem 0;
		border-bottom: 2px solid transparent;
		color: inherit;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		line-height: 1.4;
		text-decoration: none;
		text-transform: uppercase;
		transition: border-color 180ms ease;
	}

	.category-switcher a:hover,
	.category-switcher a[aria-current='page'] {
		border-bottom-color: currentColor;
	}

	.category-switcher a:focus-visible,
	.category-switcher__toggle:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	.category-switcher__toggle {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		width: 100%;
		min-height: 58px;
		padding: 1rem 1.125rem;
		border: 1px solid #111111;
		border-radius: 0;
		background: #111111;
		color: #eeeeee;
		font: inherit;
		font-size: 1.0625rem;
		font-weight: 600;
		text-align: left;
		cursor: pointer;
		transition: background-color 160ms ease;
	}

	.category-switcher__toggle:hover { background: #303030; }
	.category-switcher__toggle:active { background: #444444; }
	.category-switcher__toggle svg,
	.category-dialog svg {
		flex: 0 0 20px;
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.25;
	}
	.category-switcher__toggle svg:last-child { margin-left: auto; width: 16px; }
	.category-switcher [hidden] { display: none; }

	:global(body.category-dialog-open) { overflow: hidden; }
	.category-dialog {
		position: fixed;
		inset: auto 0 0;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		max-height: 90vh;
		max-height: 90svh;
		margin: 0;
		padding: 1.25rem max(1.25rem, env(safe-area-inset-right, 0px)) max(1.5rem, env(safe-area-inset-bottom, 0px)) max(1.25rem, env(safe-area-inset-left, 0px));
		border: 0;
		border-top: 1px solid rgba(17, 17, 17, 0.25);
		background: #eeeeee;
		color: #111111;
		overscroll-behavior: contain;
	}
	.category-dialog::backdrop { background: rgba(0, 0, 0, 0.5); backdrop-filter: blur(5px); }
	.category-dialog[open] { animation: category-sheet-enter 220ms cubic-bezier(0.22, 1, 0.36, 1); }
	.category-dialog__header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.category-dialog__header h2 { margin: 0; font-size: clamp(1.125rem, 5vw, 1.5rem); font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
	.category-dialog__close { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; padding: 0; border: 1px solid rgba(17,17,17,0.3); border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
	.category-dialog__links a { display: flex; align-items: center; gap: 1rem; min-height: 80px; padding: 1rem 0; border-top: 1px solid rgba(17,17,17,0.25); color: inherit; text-decoration: none; }
	.category-dialog__number { font-size: 0.875rem; color: #555555; }
	.category-dialog__name { flex: 1; font-family: var(--font-heading); font-size: clamp(1rem, 4.5vw, 1.25rem); font-weight: 500; line-height: 1.3; overflow-wrap: anywhere; }
	.category-dialog__name small { display: block; margin-top: 0.35rem; font-family: var(--font-body); font-size: 1rem; font-weight: 600; }
	.category-dialog__links a:hover .category-dialog__name { text-decoration: underline; text-underline-offset: 0.2em; }
	.category-dialog :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
	@keyframes category-sheet-enter { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }
	@media (prefers-reduced-motion: reduce) { .category-dialog[open] { animation: none; } .category-switcher__toggle { transition: none; } }

	.archive-search {
		display: grid;
		grid-template-columns: auto minmax(18rem, 1fr);
		align-items: end;
		gap: 0.75rem clamp(2rem, 4vw, 4rem);
		width: min(100%, 52rem);
		margin-bottom: clamp(3.5rem, 6vw, 6rem);
		animation: tabs-enter 700ms 140ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.archive-search > label {
		padding-bottom: 0.9rem;
		font-size: 0.68rem;
		font-weight: 520;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.archive-search__field {
		position: relative;
		border-bottom: 1px solid rgba(17, 17, 17, 0.55);
		transition: border-color 240ms ease;
	}

	.archive-search__field:focus-within {
		border-color: #000000;
	}

	.archive-search__field > svg {
		position: absolute;
		top: 50%;
		left: 0;
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.15;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.archive-search input {
		width: 100%;
		padding: 0.75rem 5rem 0.75rem 1.9rem;
		border: 0;
		border-radius: 0;
		outline: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: clamp(1rem, 1.15vw, 1.05rem);
		letter-spacing: 0.035em;
	}

	.archive-search__field:not(:has(button:not([hidden]))) input { padding-right: 0.25rem; }

	.archive-search input:focus-visible {
		outline: 2px solid #111111;
		outline-offset: 4px;
	}

	.archive-search input::placeholder {
		color: #555555;
		opacity: 1;
	}

	.archive-search input::-webkit-search-cancel-button {
		display: none;
	}

	.archive-search button {
		position: absolute;
		top: 50%;
		right: 0;
		padding: 0.45rem 0;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.62rem;
		font-weight: 520;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		transform: translateY(-50%);
		cursor: pointer;
	}

	.archive-search button:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.25rem;
	}

	.archive-search__empty {
		grid-column: 2;
		margin: 0.9rem 0 0;
		font-size: 0.76rem;
		letter-spacing: 0.08em;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.vehicle-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@keyframes heading-enter {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes tabs-enter {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@keyframes marker-enter {
		from {
			transform: scaleX(0);
		}

		to {
			transform: scaleX(1);
		}
	}

	.pagination {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
		margin-top: clamp(4rem, 7vw, 7rem);
		padding-top: 1.5rem;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
	}

	.pagination[hidden] {
