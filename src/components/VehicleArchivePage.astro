---
import { join } from 'node:path';
import sharp from 'sharp';
import Layout from '../layouts/Layout.astro';
import SiteChrome from './SiteChrome.astro';
import VehicleCard from './VehicleCard.astro';
import {
	categoryByKey,
	vehicleImageRoute,
	vehicleCategories,
	vehicleRoute,
	type VehicleCategoryKey,
	type VehicleEntry,
} from '../config/vehicles';

interface Props {
	category: VehicleCategoryKey;
	vehicles: VehicleEntry[];
	currentPage?: number;
	pageSize?: number;
}

const { category, vehicles, currentPage = 1, pageSize = vehicles.length || 1 } = Astro.props;
const categoryData = categoryByKey[category];
const totalPages = Math.ceil(vehicles.length / pageSize);
const safePage = Math.min(Math.max(currentPage, 1), Math.max(totalPages, 1));
const firstIndex = (safePage - 1) * pageSize;
const visibleVehicles = vehicles.slice(firstIndex, firstIndex + pageSize);
const lastIndex = firstIndex + visibleVehicles.length;
const searchId = `vehicle-search-${category}`;
const gridId = `vehicle-grid-${category}`;
const pageTitle = safePage > 1 ? `${categoryData.heading} – Seite ${safePage}` : categoryData.heading;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string) => `${basePath}${path.replace(/^\//, '')}`;
const pagePath = (page: number) =>
	page === 1
		? `/projekte/${category}/`
		: `/projekte/${category}/seite/${page}/`;
const siteUrl = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(sitePath(path), siteUrl).href;
const openGraphVehicle = visibleVehicles[0] ?? vehicles[0];
const openGraphMetadata = await sharp(
	join(
		process.cwd(),
		'src/pages/projekte',
		openGraphVehicle.data.category,
		openGraphVehicle.data.slug,
		openGraphVehicle.data.cardImage.replace(/^\.\//, ''),
	),
).metadata();
const openGraphImage = {
	src: sitePath(vehicleImageRoute(openGraphVehicle, openGraphVehicle.data.cardImage)),
	width: openGraphMetadata.width ?? 1200,
	height: openGraphMetadata.height ?? 900,
	format: 'webp' as const,
};
const collectionId = `${absolute(pagePath(safePage))}#itemlist`;
const itemList = {
	'@type': 'ItemList',
	'@id': collectionId,
	name: pageTitle,
	numberOfItems: vehicles.length,
	itemListOrder: 'https://schema.org/ItemListOrderAscending',
	itemListElement: visibleVehicles.map((vehicle, index) => ({
		'@type': 'ListItem',
		position: firstIndex + index + 1,
		name: vehicle.data.title,
		url: absolute(vehicleRoute(vehicle)),
	})),
};
---

<Layout
	title={pageTitle}
	description={categoryData.description}
	openGraphImage={openGraphImage}
	openGraphImageAlt={visibleVehicles[0]?.data.cardImageAlt ?? vehicles[0].data.cardImageAlt}
	structuredDataType="CollectionPage"
	dateModified="2026-08-06"
	additionalJsonLd={itemList}
	mainEntityId={collectionId}
	breadcrumbs={[
		{ name: 'Startseite', path: '/' },
		{ name: 'Projekte', path: '/projekte/' },
		{ name: categoryData.label, path: `/projekte/${category}/` },
	]}
>
	<SiteChrome theme="light">
		<main class="vehicle-archive" id="main-content" tabindex="-1">
			<header class="archive-intro">
				<h1>{categoryData.heading}</h1>
			</header>

			<nav class="category-switcher" aria-label="Projektbereiche">
				{
					vehicleCategories.map((item) => (
						<a
							href={sitePath(`/projekte/${item.key}/`)}
							aria-current={item.key === category ? 'page' : undefined}
							data-category-link
						>
							<span>{item.label}</span>
							{item.key === category && <i aria-hidden="true" />}
						</a>
					))
				}
			</nav>

			<form class="archive-search" role="search" data-vehicle-search>
				<label for={searchId}>Fahrzeugsuche</label>
				<div class="archive-search__field">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<circle cx="10.5" cy="10.5" r="6.75" />
						<path d="m15.5 15.5 5 5" />
					</svg>
					<input
						id={searchId}
						type="search"
						placeholder="Fahrzeugname eingeben"
						aria-label={`${categoryData.label} durchsuchen`}
						aria-controls={gridId}
						autocomplete="off"
						spellcheck="false"
						data-vehicle-search-input
					/>
					<button type="button" data-vehicle-search-clear hidden>Löschen</button>
				</div>
				<p class="archive-search__empty" data-vehicle-search-empty hidden>
					Kein Fahrzeug für diese Suche gefunden.
				</p>
				<span class="visually-hidden" aria-live="polite" data-vehicle-search-status></span>
			</form>

			<section id={gridId} class="vehicle-grid" aria-label={`${categoryData.label}, Seite ${safePage}`}>
				{
					vehicles.map((vehicle, index) => {
						const defaultVisible = index >= firstIndex && index < lastIndex;
						const displayIndex = defaultVisible ? index - firstIndex : pageSize + index;
						return <VehicleCard vehicle={vehicle} index={displayIndex} {defaultVisible} />;
					})
				}
			</section>

			{
				totalPages > 1 && (
					<nav class="pagination" aria-label="Seitennavigation">
						{safePage > 1 && (
							<a class="pagination__direction" href={sitePath(pagePath(safePage - 1))} rel="prev">
								<span aria-hidden="true">←</span> Zurück
							</a>
						)}
						<div class="pagination__pages">
							{Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
								<a
									href={sitePath(pagePath(page))}
									aria-current={page === safePage ? 'page' : undefined}
									aria-label={`Seite ${page}`}
								>
									{String(page).padStart(2, '0')}
								</a>
							))}
						</div>
						{safePage < totalPages && (
							<a class="pagination__direction" href={sitePath(pagePath(safePage + 1))} rel="next">
								Weiter <span aria-hidden="true">→</span>
							</a>
						)}
					</nav>
				)
			}
		</main>
	</SiteChrome>
</Layout>

<script>
	const archive = document.querySelector('.vehicle-archive');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const searchForm = archive?.querySelector('[data-vehicle-search]');
	const searchInput = searchForm?.querySelector('[data-vehicle-search-input]');
	const clearSearch = searchForm?.querySelector('[data-vehicle-search-clear]');
	const emptySearch = searchForm?.querySelector('[data-vehicle-search-empty]');
	const searchStatus = searchForm?.querySelector('[data-vehicle-search-status]');
	const pagination = archive?.querySelector('.pagination');
	const vehicleCards = Array.from(archive?.querySelectorAll('[data-vehicle-card]') ?? []).filter(
		(card): card is HTMLElement => card instanceof HTMLElement,
	);

	const normalizeSearchValue = (value: string) =>
		value
			.normalize('NFD')
			.replace(/\p{Diacritic}/gu, '')
			.toLocaleLowerCase('de')
			.trim();

	const setCardVisibility = (card: HTMLElement, visible: boolean) => {
		card.dataset.searchVisible = visible ? 'true' : 'false';
		card.getAnimations().forEach((animation) => animation.cancel());

		if (reducedMotion.matches) {
			card.hidden = !visible;
			return;
		}

		if (visible) {
			const wasHidden = card.hidden;
			card.hidden = false;
			if (wasHidden) {
				card.animate(
					[
						{ opacity: 0, transform: 'translateY(0.7rem)' },
						{ opacity: 1, transform: 'translateY(0)' },
					],
					{ duration: 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
				);
			}
			return;
		}

		if (!card.hidden) {
			const animation = card.animate(
				[
					{ opacity: 1, transform: 'translateY(0)' },
					{ opacity: 0, transform: 'translateY(-0.35rem)' },
				],
				{ duration: 150, easing: 'cubic-bezier(0.55, 0, 1, 0.45)' },
			);
			animation.finished
				.then(() => {
					if (card.dataset.searchVisible === 'false') card.hidden = true;
				})
				.catch(() => undefined);
		}
	};

	const updateVehicleSearch = () => {
		if (!(searchInput instanceof HTMLInputElement)) return;

		const rawQuery = searchInput.value.trim();
		const normalizedQuery = normalizeSearchValue(rawQuery);
		const queryParts = normalizedQuery.split(/\s+/).filter(Boolean);
		const isSearching = queryParts.length > 0;
		let matchCount = 0;

		vehicleCards.forEach((card) => {
			const searchValue = normalizeSearchValue(card.dataset.searchValue ?? '');
			const matches = isSearching
				? queryParts.every((part) => searchValue.includes(part))
				: card.dataset.defaultVisible === 'true';
			if (isSearching && matches) matchCount += 1;
			setCardVisibility(card, matches);
		});

		if (clearSearch instanceof HTMLButtonElement) clearSearch.hidden = !rawQuery;
		if (pagination instanceof HTMLElement) pagination.hidden = isSearching;
		if (emptySearch instanceof HTMLElement) emptySearch.hidden = !isSearching || matchCount > 0;
		if (searchStatus instanceof HTMLElement) {
			searchStatus.textContent = isSearching
				? matchCount === 1
					? 'Ein Fahrzeug gefunden.'
					: `${matchCount} Fahrzeuge gefunden.`
				: '';
		}
	};

	searchForm?.addEventListener('submit', (event) => event.preventDefault());
	searchInput?.addEventListener('input', updateVehicleSearch);
	clearSearch?.addEventListener('click', () => {
		if (!(searchInput instanceof HTMLInputElement)) return;
		searchInput.value = '';
		updateVehicleSearch();
		searchInput.focus();
	});

	document.querySelectorAll('[data-category-link]').forEach((link) => {
		link.addEventListener('click', (event) => {
			if (
				!(link instanceof HTMLAnchorElement) ||
				!(event instanceof MouseEvent) ||
				event.defaultPrevented ||
				event.button !== 0 ||
				event.metaKey ||
				event.ctrlKey ||
				event.shiftKey ||
				event.altKey ||
				link.getAttribute('aria-current') === 'page' ||
				reducedMotion.matches
			) {
				return;
			}

			event.preventDefault();
			archive?.classList.add('archive-is-leaving');
			window.setTimeout(() => window.location.assign(link.href), 220);
		});
	});
</script>

<style>
	.vehicle-archive {
		min-height: 100svh;
		padding: clamp(10.5rem, 15vw, 14rem) clamp(1.25rem, 4.8vw, 5.5rem) clamp(8rem, 12vw, 13rem);
		background:
			linear-gradient(
				180deg,
				#eeeeee 0,
				#eeeeee 16rem,
				#f7eee2 28rem,
				#f8f3ec 40rem,
				#e9dacf 51rem,
				#9299c4 63rem,
				#688dca 76rem,
				#557fb8 90rem,
				#6695d3 105rem,
				#82afe2 122rem,
				#eeeeee 154rem
			);
		color: #111111;
	}

	.archive-intro {
		padding: clamp(2.5rem, 5vw, 4.75rem) 0 clamp(3rem, 5vw, 5rem);
	}

	.archive-intro h1 {
		margin: 0;
		font-size: clamp(2.65rem, 4.75vw, 5rem);
		font-weight: 360;
		letter-spacing: 0.075em;
		line-height: 0.98;
		text-transform: uppercase;
		animation: heading-enter 680ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.category-switcher {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-bottom: clamp(3.5rem, 6vw, 6rem);
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		border-bottom: 1px solid rgba(17, 17, 17, 0.3);
		background: rgba(238, 238, 238, 0.18);
		animation: tabs-enter 700ms 80ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.category-switcher a {
		position: relative;
		padding: 1.25rem clamp(0.75rem, 2vw, 1.5rem);
		color: inherit;
		font-size: clamp(0.68rem, 0.78vw, 0.78rem);
		font-weight: 460;
		letter-spacing: 0.145em;
		text-align: center;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background-color 260ms ease,
			color 260ms ease;
	}

	.category-switcher a + a {
		border-left: 1px solid rgba(17, 17, 17, 0.3);
	}

	.category-switcher a:hover {
		background: rgba(17, 17, 17, 0.045);
	}

	.category-switcher a[aria-current='page'] {
		background: rgba(238, 238, 238, 0.32);
		font-weight: 560;
	}

	.category-switcher i {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		height: 2px;
		background: #111111;
		content: '';
		transform-origin: left center;
		animation: marker-enter 480ms 160ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.category-switcher a:focus-visible {
		outline: 2px solid #111111;
		outline-offset: -4px;
	}

	.archive-search {
		display: grid;
		grid-template-columns: auto minmax(18rem, 1fr);
		align-items: end;
		gap: 0.75rem clamp(2rem, 4vw, 4rem);
		width: min(100%, 52rem);
		margin-bottom: clamp(3.5rem, 6vw, 6rem);
		animation: tabs-enter 700ms 140ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.archive-search > label {
		padding-bottom: 0.9rem;
		font-size: 0.68rem;
		font-weight: 520;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.archive-search__field {
		position: relative;
		border-bottom: 1px solid rgba(17, 17, 17, 0.35);
		transition: border-color 240ms ease;
	}

	.archive-search__field:focus-within {
		border-color: #111111;
	}

	.archive-search__field > svg {
		position: absolute;
		top: 50%;
		left: 0;
		width: 1.1rem;
		height: 1.1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.15;
		transform: translateY(-50%);
		pointer-events: none;
	}

	.archive-search input {
		width: 100%;
		padding: 0.75rem 5rem 0.75rem 1.9rem;
		border: 0;
		border-radius: 0;
		outline: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: clamp(0.92rem, 1.15vw, 1.05rem);
		letter-spacing: 0.035em;
	}

	.archive-search input::placeholder {
		color: rgba(17, 17, 17, 0.5);
		opacity: 1;
	}

	.archive-search input::-webkit-search-cancel-button {
		display: none;
	}

	.archive-search button {
		position: absolute;
		top: 50%;
		right: 0;
		padding: 0.45rem 0;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.62rem;
		font-weight: 520;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		transform: translateY(-50%);
		cursor: pointer;
	}

	.archive-search button:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.25rem;
	}

	.archive-search__empty {
		grid-column: 2;
		margin: 0.9rem 0 0;
		font-size: 0.76rem;
		letter-spacing: 0.08em;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.vehicle-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 1.5vw, 1.5rem);
	}

	@keyframes heading-enter {
		from {
			opacity: 0;
			transform: translateY(0.7rem);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes tabs-enter {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@keyframes marker-enter {
		from {
			transform: scaleX(0);
		}

		to {
			transform: scaleX(1);
		}
	}

	.archive-is-leaving .archive-intro h1 {
		animation: archive-fallback-out 190ms cubic-bezier(0.55, 0, 1, 0.45) both;
	}

	.archive-is-leaving .vehicle-grid {
		animation: archive-fallback-out 210ms 10ms cubic-bezier(0.55, 0, 1, 0.45) both;
	}

	@keyframes archive-fallback-out {
		to {
			opacity: 0;
			transform: translateY(-0.5rem);
		}
	}

	.pagination {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
		margin-top: clamp(4rem, 7vw, 7rem);
		padding-top: 1.5rem;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
	}

	.pagination[hidden] {
		display: none;
	}

	.pagination a {
		color: inherit;
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.pagination__pages {
		display: flex;
		gap: 0.6rem;
	}

	.pagination__pages a {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid rgba(17, 17, 17, 0.3);
	}

	.pagination__pages a[aria-current='page'] {
		color: #eeeeee;
		background: #111111;
	}

	.pagination__direction:last-child {
		justify-self: end;
	}

	.pagination a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	@media (max-width: 980px) {
		.vehicle-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 680px) {
		.vehicle-archive {
			padding-top: 9rem;
		}

		.archive-intro {
			padding: 2.75rem 0 3rem;
		}

		.archive-intro h1 {
			min-width: 0;
			font-size: clamp(1.95rem, 8vw, 2.55rem);
			letter-spacing: 0.06em;
			line-height: 1;
			overflow-wrap: normal;
			hyphens: none;
		}

		.category-switcher {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			overflow: visible;
		}

		.category-switcher a {
			display: grid;
			place-items: center;
			min-width: 0;
			min-height: 4.25rem;
			padding: 0.8rem 0.35rem;
			font-size: 0.58rem;
			letter-spacing: 0.1em;
			line-height: 1.4;
		}

		.category-switcher a span {
			max-width: 13ch;
			text-wrap: balance;
		}

		.archive-search {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}

		.archive-search > label {
			padding-bottom: 0.25rem;
		}

		.archive-search__empty {
			grid-column: 1;
		}

		.vehicle-grid {
			grid-template-columns: 1fr;
		}

		.pagination {
			grid-template-columns: 1fr 1fr;
		}

		.pagination__pages {
			grid-column: 1 / -1;
			grid-row: 1;
			justify-content: center;
			flex-wrap: wrap;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.archive-intro h1,
		.category-switcher,
		.category-switcher i,
		.archive-search {
			animation: none;
		}

		.category-switcher a,
		.archive-search__field {
			transition: none;
		}
	}
</style>
