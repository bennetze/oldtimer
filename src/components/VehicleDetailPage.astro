---
import { join } from 'node:path';
import sharp from 'sharp';
import Layout from '../layouts/Layout.astro';
import {
	GITHUB_PAGES_GALLERY_IMAGE_LIMIT,
	limitVehicleGalleryBlocks,
} from '../config/vehicleGalleryPolicy.js';
import {
	categoryByKey,
	getCategoryVehicles,
	vehicleImageRoute,
	vehicleRoute,
	type VehicleEntry,
} from '../config/vehicles';
import SiteChrome from './SiteChrome.astro';

interface Props {
	vehicle: VehicleEntry;
}

const { vehicle } = Astro.props;
const category = categoryByKey[vehicle.data.category];
const siblings = await getCategoryVehicles(vehicle.data.category);
const currentIndex = siblings.findIndex((entry) => entry.data.slug === vehicle.data.slug);
const previousVehicle = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const nextVehicle = currentIndex >= 0 && currentIndex < siblings.length - 1
	? siblings[currentIndex + 1]
	: undefined;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const githubPagesPreview = basePath !== '/';
const contentBlocks = (
	githubPagesPreview
		? limitVehicleGalleryBlocks(vehicle.data.blocks, GITHUB_PAGES_GALLERY_IMAGE_LIMIT)
		: vehicle.data.blocks
) as typeof vehicle.data.blocks;
const sitePath = (path: string) => `${basePath}${path.replace(/^\//, '')}`;
const galleryImagePath = (source: string) => sitePath(vehicleImageRoute(vehicle, source));
const siteUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const vehicleId = `${pageUrl}#vehicle`;
const leadImageMetadata = await sharp(
	join(
		process.cwd(),
		'src/pages/projekte',
		vehicle.data.category,
		vehicle.data.slug,
		vehicle.data.leadImage.replace(/^\.\//, ''),
	),
).metadata();
const leadImage = {
	src: galleryImagePath(vehicle.data.leadImage),
	width: leadImageMetadata.width ?? 1200,
	height: leadImageMetadata.height ?? 800,
	format: 'webp' as const,
};
const vehicleJsonLd = {
	'@type': 'Vehicle',
	'@id': vehicleId,
	name: vehicle.data.title,
	description: vehicle.data.description,
	image: new URL(leadImage.src, siteUrl).href,
	...(vehicle.data.year ? { productionDate: vehicle.data.year } : {}),
};
---

<Layout
	title={vehicle.data.title}
	description={vehicle.data.description}
	openGraphImage={leadImage}
	openGraphImageAlt={vehicle.data.leadImageAlt}
	structuredDataType="ItemPage"
	dateModified={vehicle.data.dateModified}
	additionalJsonLd={vehicleJsonLd}
	mainEntityId={vehicleId}
	breadcrumbs={[
		{ name: 'Startseite', path: '/' },
		{ name: 'Projekte', path: '/projekte/' },
		{ name: category.label, path: `/projekte/${vehicle.data.category}/` },
		{ name: vehicle.data.title, path: vehicleRoute(vehicle) },
	]}
>
	<SiteChrome theme="light">
		<main class="vehicle-detail" id="main-content" tabindex="-1">
			<header class="vehicle-masthead">
				<p>
					<a href={sitePath(`/projekte/${vehicle.data.category}/`)}>{category.label}</a>
				</p>
				<h1>{vehicle.data.title}</h1>
			</header>

			<figure class="vehicle-lead">
				<img
					src={leadImage.src}
					alt={vehicle.data.leadImageAlt}
					width={leadImage.width}
					height={leadImage.height}
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</figure>

			<article class="vehicle-story">
				{
					contentBlocks.map((block, blockIndex) => {
						if (block.type === 'copy') {
							return <div class="story-copy" set:html={block.html} />;
						}

						if (block.type === 'contact') {
							return (
								<aside class="story-contact" aria-label="Fahrzeuganfrage">
									<div set:html={block.html} />
									<div class="story-contact__actions">
										<a href="tel:+493696683783">03 69 66 / 83 7 83</a>
										<a href="mailto:info@oldtimermanufaktur.de">E-Mail schreiben</a>
									</div>
								</aside>
							);
						}

						return (
							<div
								class:list={['story-gallery', `story-gallery--${Math.min(block.images.length, 4)}`]}
								aria-label={`Bildergruppe ${blockIndex + 1}`}
							>
								{block.images.map((image, imageIndex) => (
									<figure class:list={['story-image', { 'story-image--feature': imageIndex === 0 && block.images.length >= 3 }]}>
										<button
											type="button"
											class="story-image__button"
											data-lightbox-trigger
											data-lightbox-src={galleryImagePath(image.src)}
											data-lightbox-alt={image.alt}
											aria-label={`${image.alt} vergrößern`}
										>
											<img
												src={galleryImagePath(image.src)}
												alt={image.alt}
												loading="lazy"
												decoding="async"
											/>
										</button>
										{image.caption && <figcaption>{image.caption}</figcaption>}
									</figure>
								))}
							</div>
						);
					})
				}
			</article>

			<nav class="vehicle-adjacent" aria-label="Weitere Fahrzeuge">
				{
					previousVehicle ? (
						<a href={sitePath(vehicleRoute(previousVehicle))} rel="prev">
							<span class="vehicle-adjacent__label">
								<svg aria-hidden="true" viewBox="0 0 24 12">
									<path d="M6 1 1 6l5 5M1 6h22" />
								</svg>
								Vorheriges Fahrzeug
							</span>
							<strong>{previousVehicle.data.title}</strong>
						</a>
					) : (
						<span aria-hidden="true" />
					)
				}
				<a class="vehicle-adjacent__archive" href={sitePath(`/projekte/${vehicle.data.category}/`)}>
					Alle {category.label}
				</a>
				{
					nextVehicle ? (
						<a class="vehicle-adjacent__next" href={sitePath(vehicleRoute(nextVehicle))} rel="next">
							<span class="vehicle-adjacent__label">
								Nächstes Fahrzeug
								<svg aria-hidden="true" viewBox="0 0 24 12">
									<path d="m18 1 5 5-5 5M1 6h22" />
								</svg>
							</span>
							<strong>{nextVehicle.data.title}</strong>
						</a>
					) : (
						<span aria-hidden="true" />
					)
				}
			</nav>
		</main>

		<dialog class="image-lightbox" data-image-lightbox aria-label="Bildansicht">
			<button class="image-lightbox__close" type="button" data-lightbox-close>
				Schließen
			</button>
			<div class="image-lightbox__stage">
				<img src="" alt="" data-lightbox-image />
			</div>
		</dialog>
	</SiteChrome>
</Layout>

<script>
	const lightbox = document.querySelector('[data-image-lightbox]');
	const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');
	const lightboxClose = lightbox?.querySelector('[data-lightbox-close]');
	let lightboxOpener;

	document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
		trigger.addEventListener('click', () => {
			if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImage instanceof HTMLImageElement)) {
				return;
			}

			lightboxOpener = trigger;
			lightboxImage.src = trigger.dataset.lightboxSrc ?? '';
			lightboxImage.alt = trigger.dataset.lightboxAlt ?? '';
			lightbox.showModal();
			lightboxClose?.focus();
		});
	});

	const closeLightbox = () => {
		if (lightbox instanceof HTMLDialogElement) lightbox.close();
	};

	lightboxClose?.addEventListener('click', closeLightbox);
	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox) closeLightbox();
	});
	lightbox?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			event.preventDefault();
			closeLightbox();
		}
	});
	lightbox?.addEventListener('close', () => {
		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.removeAttribute('src');
		}
		if (lightboxOpener instanceof HTMLElement) lightboxOpener.focus();
		lightboxOpener = undefined;
	});
</script>

<style>
	.vehicle-detail {
		min-height: 100svh;
		padding-top: clamp(8.5rem, 12vw, 12rem);
		background: #eeeeee;
		color: #111111;
	}

	.vehicle-masthead,
	.vehicle-adjacent {
		margin-right: clamp(1.25rem, 4.8vw, 5.5rem);
		margin-left: clamp(1.25rem, 4.8vw, 5.5rem);
	}

	.vehicle-masthead {
		display: grid;
		place-items: center;
		min-height: clamp(27rem, 58vw, 48rem);
		padding: 5rem 0;
		text-align: center;
	}

	.vehicle-masthead p {
		margin: 0 0 1.5rem;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.vehicle-masthead p a {
		color: inherit;
		text-decoration-color: transparent;
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.45em;
		transition: text-decoration-color 220ms ease;
	}

	.vehicle-masthead p a:hover {
		text-decoration-color: currentColor;
	}

	.vehicle-masthead p a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.4rem;
	}

	.vehicle-masthead h1 {
		max-width: 19ch;
		margin: 0;
		font-size: clamp(2.45rem, 4.7vw, 5rem);
		font-weight: 340;
		letter-spacing: 0.065em;
		line-height: 0.98;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.vehicle-lead {
		margin: 0;
		background: #d7d7d7;
	}

	.vehicle-lead :global(img) {
		width: 100%;
		max-height: min(86svh, 70rem);
		object-fit: cover;
	}

	.vehicle-story {
		padding: clamp(8rem, 14vw, 14rem) clamp(1.25rem, 5vw, 6.5rem);
	}

	.story-copy {
		width: min(100%, 49rem);
		margin: 0 auto clamp(4rem, 7vw, 7rem);
		font-size: clamp(1.25rem, 1.75vw, 1.7rem);
		font-weight: 370;
		line-height: 1.65;
		text-align: center;
	}

	.story-copy :global(p),
	.story-copy :global(blockquote) {
		margin: 0;
		font: inherit;
	}

	.story-copy :global(h2),
	.story-copy :global(h3) {
		margin: 0;
		font-size: clamp(1.65rem, 3.5vw, 3.5rem);
		font-weight: 440;
		letter-spacing: 0.055em;
		line-height: 1.05;
		text-align: center;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.story-copy :global(a),
	.story-contact :global(a) {
		color: inherit;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.story-gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.5vw, 1.5rem);
		width: min(100%, 108rem);
		margin: 0 auto clamp(8rem, 13vw, 13rem);
	}

	.story-gallery--1 {
		grid-template-columns: minmax(0, 1fr);
		width: min(100%, 92rem);
	}

	.story-gallery--3,
	.story-gallery--4 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.story-image {
		min-width: 0;
		margin: 0;
	}

	.story-image--feature {
		grid-column: span 2;
		grid-row: span 2;
	}

	.story-image__button {
		display: block;
		width: 100%;
		padding: 0;
		overflow: hidden;
		border: 0;
		border-radius: 0;
		background: #d7d7d7;
		cursor: zoom-in;
	}

	.story-image__button :global(img) {
		display: block;
		width: 100%;
		height: auto;
		min-height: 18rem;
		max-height: 62rem;
		object-fit: cover;
		transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.story-image__button:hover :global(img),
	.story-image__button:focus-visible :global(img) {
		transform: scale(1.018);
	}

	.story-image__button:focus-visible {
		outline: 2px solid #111111;
		outline-offset: 0.35rem;
	}

	.story-image figcaption {
		padding-top: 0.75rem;
		font-size: 0.78rem;
		line-height: 1.5;
	}

	.story-contact {
		width: min(100%, 58rem);
		margin: 0 auto clamp(8rem, 13vw, 13rem);
		padding: clamp(2rem, 4vw, 4rem);
		border-top: 1px solid rgba(17, 17, 17, 0.32);
		border-bottom: 1px solid rgba(17, 17, 17, 0.32);
		font-size: clamp(1.12rem, 1.5vw, 1.45rem);
		line-height: 1.65;
		text-align: center;
	}

	.story-contact :global(p) {
		margin: 0;
		font: inherit;
	}

	.story-contact__actions {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 2rem;
	}

	.story-contact__actions a {
		padding: 0.85rem 1.15rem;
		border: 1px solid #111111;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.vehicle-adjacent {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 2rem;
		padding: clamp(3rem, 5vw, 5rem) 0 clamp(8rem, 12vw, 12rem);
		border-top: 1px solid rgba(17, 17, 17, 0.3);
	}

	.vehicle-adjacent a {
		color: inherit;
		text-decoration: none;
	}

	.vehicle-adjacent__label {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.55rem;
		font-size: 0.66rem;
		font-weight: 500;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.vehicle-adjacent__label svg {
		width: 1.5rem;
		height: 0.75rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.vehicle-adjacent strong {
		display: block;
		max-width: 31ch;
		font-size: clamp(0.9rem, 1.1vw, 1.08rem);
		font-weight: 430;
		line-height: 1.35;
		text-transform: uppercase;
	}

	.vehicle-adjacent__archive {
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-align: center;
		text-transform: uppercase;
	}

	.vehicle-adjacent__next {
		text-align: right;
	}

	.vehicle-adjacent__next .vehicle-adjacent__label {
		justify-content: flex-end;
	}

	.vehicle-adjacent__next strong {
		margin-left: auto;
	}

	.vehicle-adjacent a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.vehicle-adjacent a:hover .vehicle-adjacent__label svg:first-child {
			transform: translateX(-0.25rem);
		}

		.vehicle-adjacent__next:hover .vehicle-adjacent__label svg:last-child {
			transform: translateX(0.25rem);
		}
	}

	.image-lightbox {
		width: 100vw;
		max-width: none;
		height: 100svh;
		max-height: none;
		padding: 0;
		border: 0;
		background: rgba(8, 8, 8, 0.97);
		color: #eeeeee;
	}

	.image-lightbox::backdrop {
		background: rgba(8, 8, 8, 0.9);
	}

	.image-lightbox__close {
		position: fixed;
		top: 1.5rem;
		right: 1.5rem;
		z-index: 2;
		padding: 0.75rem 1rem;
		border: 1px solid rgba(238, 238, 238, 0.62);
		color: inherit;
		background: rgba(17, 17, 17, 0.65);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.image-lightbox__stage {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: clamp(4.5rem, 7vw, 6rem) clamp(1rem, 4vw, 4rem) clamp(1rem, 4vw, 4rem);
	}

	.image-lightbox__stage img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
	}

	@media (max-width: 760px) {
		.vehicle-masthead {
			min-height: 31rem;
		}

		.vehicle-masthead h1 {
			font-size: clamp(2rem, 9vw, 3rem);
		}

		.vehicle-story {
			padding-top: 7rem;
		}

		.story-gallery,
		.story-gallery--3,
		.story-gallery--4 {
			grid-template-columns: 1fr;
			margin-bottom: 7rem;
		}

		.story-image--feature {
			grid-column: auto;
			grid-row: auto;
		}

		.story-image__button :global(img) {
			min-height: 0;
		}

		.story-contact__actions {
			flex-direction: column;
		}

		.vehicle-adjacent {
			grid-template-columns: 1fr;
			text-align: left;
		}

		.vehicle-adjacent__archive {
			grid-row: 1;
			justify-self: start;
		}

		.vehicle-adjacent__next {
			text-align: left;
		}

		.vehicle-adjacent__next .vehicle-adjacent__label {
			justify-content: flex-start;
		}

		.vehicle-adjacent__next strong {
			margin-left: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.vehicle-masthead p a,
		.story-image__button :global(img) {
			transition: none;
		}

		.vehicle-adjacent__label svg {
			transition: none;
		}
	}
</style>
