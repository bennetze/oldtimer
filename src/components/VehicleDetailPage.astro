---
import { localizeVehicle, vehicleLanguage } from '../config/vehicleLocale.js';
import { vehicleImage } from '../config/vehicleImages';
import Layout from '../layouts/Layout.astro';
import { validateVehicleBlocks } from '../config/vehicleHtml.js';
import { annotateVehicleLanguageParts } from '../config/vehicleLanguageParts.js';
import {
	categoryByKey,
	getCategoryVehicles,
	vehicleRoute,
	type VehicleEntry,
} from '../config/vehicles';
import SiteChrome from './SiteChrome.astro';
import BackgroundTexture from './BackgroundTexture.astro';

interface Props {
	vehicle: VehicleEntry;
}

const { vehicle } = Astro.props;
const category = categoryByKey[vehicle.data.category];
const siblings = await getCategoryVehicles(vehicle.data.category);
const currentIndex = siblings.findIndex((entry) => entry.data.slug === vehicle.data.slug);
const previousVehicle = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const nextVehicle = currentIndex >= 0 && currentIndex < siblings.length - 1
	? siblings[currentIndex + 1]
	: undefined;
const language = vehicleLanguage(Astro.url.pathname, import.meta.env.BASE_URL);
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const content = localizeVehicle(vehicle.data, language);
const validatedBlocks = validateVehicleBlocks(content.blocks, `${vehicle.data.category}/${vehicle.data.slug}`).map(block =>
	block.type === 'gallery' && !block.textSide ? block : { ...block, html: annotateVehicleLanguageParts(block.html, language) });
// Join only uninterrupted photo runs for responsive rows; text always ends a run.
// This presentation step never changes the editor's records or image order.
const contentBlocks = validatedBlocks.reduce<typeof vehicle.data.blocks>((blocks, block) => {
	const previous = blocks.at(-1);
	if (block.type === 'gallery' && !block.textSide && previous?.type === 'gallery' && !previous.textSide) {
		previous.images.push(...block.images);
	} else {
		blocks.push(block.type === 'gallery' ? { ...block, images: [...block.images] } : block);
	}
	return blocks;
}, []);
const hasLeadInStory = contentBlocks.some(block => block.type === 'gallery' && block.images.some(image => image.src === vehicle.data.leadImage));
const showLeadImage = !hasLeadInStory;
const firstGalleryBlock = contentBlocks.findIndex(block => block.type === 'gallery');
const sitePath = (path: string) => `${basePath}${path.replace(/^\//, '')}`;
const galleryImagePath = (source: string) => vehicleImage(vehicle, source, 'detail', basePath).src;
const siteUrl = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const vehicleId = `${pageUrl}#vehicle`;
const leadImage = {
	...vehicleImage(vehicle, vehicle.data.leadImage, 'detail', basePath),
	format: 'webp' as const,
};
const vehicleJsonLd = {
	'@type': 'Vehicle',
	__authored: ['name', 'description'],
	'@id': vehicleId,
	name: content.title,
	description: content.description,
	image: new URL(leadImage.src, siteUrl).href,
	...(vehicle.data.year ? { productionDate: vehicle.data.year } : {}),
};
---

<Layout
	authoredTitle authoredDescription authoredImageAlt
	title={content.title}
	description={content.description}
	openGraphImage={leadImage}
	openGraphImageAlt={content.leadImageAlt}
	structuredDataType="ItemPage"
	dateModified={vehicle.data.dateModified}
	additionalJsonLd={vehicleJsonLd}
	mainEntityId={vehicleId}
	breadcrumbs={[
		{ name: 'Startseite', path: '/' },
		{ name: 'Projekte', path: '/projekte/' },
		{ name: category.label, path: `/projekte/${vehicle.data.category}/` },
		{ name: content.title, path: vehicleRoute(vehicle), authored: true },
	]}
>
	<SiteChrome theme="light">
		<main class="vehicle-detail textured-background gradient-palette" id="main-content" tabindex="-1">
			<BackgroundTexture />
			<header class="vehicle-masthead">
				<p>
					<a href={sitePath(`/projekte/${vehicle.data.category}/`)}>{category.label}</a>
				</p>
				<h1 data-authored>{content.title}</h1>
			</header>

			<div class="vehicle-documentation">
				{showLeadImage && <figure class="vehicle-lead">
					<a data-authored class="story-image__button" href={leadImage.src} data-lightbox-trigger data-lightbox-src={leadImage.src} data-lightbox-alt={content.leadImageAlt} aria-label={`${content.leadImageAlt}${language === 'en' ? ' — enlarge' : ' vergrößern'}`}>
					<img
						src={leadImage.src}
						srcset={leadImage.srcset}
						sizes="(max-width: 760px) 90vw, 480px"
						data-authored alt={content.leadImageAlt}
						width={leadImage.width}
						height={leadImage.height}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
					</a>
				</figure>}

				<article class="vehicle-story">
					{
						contentBlocks.map((block, blockIndex) => {
							if (block.type === 'copy') {
								return <div class="story-copy" data-authored set:html={block.html} />;
							}

							if (block.type === 'contact') {
								return (
									<div class="story-contact" role="group" aria-label="Fahrzeuganfrage">
										<div data-authored set:html={block.html} />
										<div class="story-contact__actions">
											<a href="tel:+493696683783">03 69 66 / 83 7 83</a>
											<a href="mailto:info@oldtimermanufaktur.de">E-Mail schreiben</a>
										</div>
									</div>
								);
							}

							return (
								<div
									class:list={['story-gallery', { 'story-gallery--multiple': block.images.length > 1, 'story-gallery--sized': block.images.some(image => image.size && image.size !== 'small'), 'story-gallery--text': Boolean(block.textSide), 'story-gallery--text-right': block.textSide === 'right', 'story-gallery--wide': Boolean(block.textSide && block.images[0]?.size === 'large') }]}
									role="group"
									aria-label={`Bildergruppe ${blockIndex + 1}`}
								>
									{block.textSide && <div class="story-copy story-side-copy" data-authored set:html={block.html} />}
									{block.images.map((image, imageIndex) => (
										<figure data-authored class:list={["story-image", `story-image--${image.size || "small"}`]}>
											<a
												href={galleryImagePath(image.src)}
												class="story-image__button"
												data-lightbox-trigger
												data-lightbox-src={galleryImagePath(image.src)}
												data-lightbox-alt={image.alt}
												aria-label={`${image.alt}${language === 'en' ? ' — enlarge' : ' vergrößern'}`}
											>
												<img
													{...vehicleImage(vehicle, image.src, 'detail', basePath)}
													sizes={image.size === "large" ? "100vw" : image.size === "medium" ? "(max-width: 840px) 90vw, 840px" : block.images.length > 1 ? "(max-width: 759px) 90vw, (max-width: 1099px) 45vw, 33vw" : "(max-width: 760px) 90vw, 420px"}
													alt={image.alt}
													loading={!showLeadImage && blockIndex === firstGalleryBlock && imageIndex === 0 ? 'eager' : 'lazy'}
													fetchpriority={!showLeadImage && blockIndex === firstGalleryBlock && imageIndex === 0 ? 'high' : undefined}
													decoding="async"
												/>
											</a>
											{image.caption && <figcaption>{image.caption}</figcaption>}
										</figure>
									))}
								</div>
							);
						})
					}
				</article>
			</div>

			<nav class="vehicle-adjacent" aria-label="Weitere Fahrzeuge">
				{
					previousVehicle ? (
						<a href={sitePath(vehicleRoute(previousVehicle))} rel="prev">
							<span class="vehicle-adjacent__label">
								<svg aria-hidden="true" viewBox="0 0 24 12">
									<path d="M6 1 1 6l5 5M1 6h22" />
								</svg>
								Vorheriges Fahrzeug
							</span>
							<strong data-authored>{localizeVehicle(previousVehicle.data, language).title}</strong>
						</a>
					) : (
						<span aria-hidden="true" />
					)
				}
				<a class="vehicle-adjacent__archive" href={sitePath(`/projekte/${vehicle.data.category}/`)}>
					Alle {category.label}
				</a>
				{
					nextVehicle ? (
						<a class="vehicle-adjacent__next" href={sitePath(vehicleRoute(nextVehicle))} rel="next">
							<span class="vehicle-adjacent__label">
								Nächstes Fahrzeug
								<svg aria-hidden="true" viewBox="0 0 24 12">
									<path d="m18 1 5 5-5 5M1 6h22" />
								</svg>
							</span>
							<strong data-authored>{localizeVehicle(nextVehicle.data, language).title}</strong>
						</a>
					) : (
						<span aria-hidden="true" />
					)
				}
			</nav>
		</main>

		<dialog class="image-lightbox" data-image-lightbox aria-label="Bildansicht">
			<button class="image-lightbox__close" type="button" data-lightbox-close>
				Schließen
			</button>
			<div class="image-lightbox__stage">
				<img src="" alt="" data-lightbox-image />
			</div>
		</dialog>
	</SiteChrome>
</Layout>

<script>
	import { createModal } from '../scripts/accessibility.js';
	const lightbox = document.querySelector('[data-image-lightbox]');
	const lightboxImage = lightbox?.querySelector('[data-lightbox-image]');
	const lightboxClose = lightbox?.querySelector('[data-lightbox-close]');
	const modal = lightbox instanceof HTMLElement ? createModal(lightbox) : null;

	document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
		trigger.addEventListener('click', (event) => {
			if (event.button > 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
			if (!modal || !(lightboxImage instanceof HTMLImageElement)) {
				return;
			}

			event.preventDefault();
			lightboxImage.src = trigger.dataset.lightboxSrc ?? '';
			lightboxImage.alt = trigger.dataset.lightboxAlt ?? '';
			modal.open(trigger);
			lightboxClose?.focus();
		});
	});

	const closeLightbox = () => {
		modal?.close();
	};

	lightboxClose?.addEventListener('click', closeLightbox);
	lightbox?.addEventListener('click', (event) => {
		if (event.target === lightbox || (event.target instanceof Element && event.target.classList.contains('image-lightbox__stage'))) closeLightbox();
	});
	lightbox?.addEventListener('close', () => {
		if (lightboxImage instanceof HTMLImageElement) {
			lightboxImage.removeAttribute('src');
		}
	});
</script>

<style>
	.vehicle-detail {
		overflow-x: clip;
		min-height: 100vh;
		min-height: 100svh;
		padding-top: clamp(8.5rem, 12vw, 12rem);
		--vehicle-fade: clamp(16rem, 24vw, 24rem);
		background: var(--gradient-cream);
		color: var(--gradient-ink);
	}

	.vehicle-adjacent {
		margin-right: clamp(1.25rem, 4.8vw, 5.5rem);
		margin-left: clamp(1.25rem, 4.8vw, 5.5rem);
	}

	.vehicle-masthead {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 0;
		padding: 2rem clamp(1.25rem, 4.8vw, 5.5rem) calc(3rem + var(--vehicle-fade));
		text-align: center;
	}


	/* Place both color transitions in empty spacing, clear of authored content.
	   Keep the shared leather texture and grain above the color layers. */
	.vehicle-masthead::before,
	.vehicle-documentation::before {
		position: absolute;
		inset: 0;
		bottom: -2px;
		z-index: -2;
		content: '';
		pointer-events: none;
	}

	.vehicle-masthead::before {
		background:
			var(--gradient-descend) bottom / 100% var(--vehicle-fade) no-repeat,
			linear-gradient(var(--gradient-cream), var(--gradient-cream))
				top / 100% calc(100% - var(--vehicle-fade) + 2px) no-repeat var(--gradient-green);
	}

	.vehicle-documentation {
		position: relative;
		padding-bottom: var(--vehicle-fade);
		color: #ffffff;
	}

	.vehicle-documentation::before {
		background:
			var(--gradient-ascend) bottom / 100% var(--vehicle-fade) no-repeat,
			linear-gradient(var(--gradient-green), var(--gradient-green))
				top / 100% calc(100% - var(--vehicle-fade) + 2px) no-repeat var(--gradient-green);
	}

	.vehicle-masthead p {
		margin: 0 0 1.5rem;
		font-size: 0.72rem;
		font-weight: 450;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.vehicle-masthead p a {
		color: inherit;
		text-decoration-color: transparent;
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.45em;
		transition: text-decoration-color 220ms ease;
	}

	.vehicle-masthead p a:hover {
		text-decoration-color: currentColor;
	}

	.vehicle-masthead p a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.4rem;
	}

	.vehicle-masthead h1 {
		max-width: 28ch;
		margin: 0;
		font-size: clamp(2rem, 3.4vw, 3.5rem);
		font-weight: 450;
		letter-spacing: 0.065em;
		line-height: 0.98;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.vehicle-lead {
		width: min(90%, 30rem);
		margin: 0 auto;
	}

	.vehicle-lead :global(img) {
		display: block;
		width: 100%;
		height: auto;
		max-height: 30rem;
		object-fit: contain;
	}

	.vehicle-story {
		width: min(100%, 70rem);
		margin: 0 auto;
		padding: 1rem clamp(1.25rem, 4vw, 3rem) 5rem;
		text-align: center;
	}

	.vehicle-story > :not(:first-child) { margin-top: 1.25rem; }
	.vehicle-story > .story-gallery + .story-gallery { margin-top: 2rem; }

	.story-copy {
		width: min(100%, 46rem);
		min-width: 0;
		margin: 0 auto;
		font-size: clamp(1.25rem, 1.6vw, 1.5rem);
		font-weight: 400;
		line-height: 1.6;
		text-align: center;
	}

	.story-copy :global(p),
	.story-copy :global(blockquote) {
		margin: 0;
		font: inherit;
	}

	.story-copy :global(h2),
	.story-copy :global(h3) {
		margin: 0;
		font-size: clamp(1.5rem, 2.5vw, 2.2rem);
		font-weight: 450;
		letter-spacing: 0.055em;
		line-height: 1.05;
		text-align: center;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.story-copy :global(a),
	.story-contact :global(a) {
		color: inherit;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.story-gallery {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
		width: min(100%, 26.25rem);
		margin-inline: auto;
		align-items: start;
	}

	@media (min-width: 760px) {
		.story-gallery--multiple {
			width: min(100%, 53.5rem);
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1100px) {
		.story-gallery--multiple {
			width: 100%;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.story-gallery--multiple:has(> :nth-child(2):last-child) {
			width: min(100%, 53.5rem);
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.story-gallery--sized { width: 100%; }
	.story-image--medium { grid-column: 1 / -1; width: min(100%, 840px); justify-self: center; }
	.story-image--large { grid-column: 1 / -1; width: 100vw; position: relative; left: 50%; transform: translateX(-50%); }
	.story-image--medium .story-image__button :global(img),
	.story-image--large .story-image__button :global(img) { max-height: none; }
	.story-gallery--text { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
	.story-side-copy { text-align: left; }
	.story-gallery--text .story-image { width: 100%; justify-self: center; grid-column: auto; left: auto; transform: none; }
	.story-gallery--text .story-image--small { max-width: 420px; }
	.story-gallery--text .story-image--medium { max-width: 840px; }
	@media (min-width: 760px) {
		.story-gallery--text { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
		.story-gallery--text-right .story-side-copy { order: 2; }
		.story-gallery--wide { width: 100vw; position: relative; left: 50%; transform: translateX(-50%); padding-inline: clamp(1.25rem, 4vw, 3rem); }
	}
	.story-copy :global(.om-color-black), .story-contact :global(.om-color-black) { color: #ffffff; }
	.story-copy :global(.om-color-red), .story-contact :global(.om-color-red) { color: #e04444; }
	.story-copy :global(.om-color-green), .story-contact :global(.om-color-green) { color: #36b96b; }
	.story-copy :global(.om-color-blue), .story-contact :global(.om-color-blue) { color: #4f8fe8; }
	.story-copy :global(.om-color-cyan), .story-contact :global(.om-color-cyan) { color: #22bfd0; }
	.story-copy :global(.om-color-yellow), .story-contact :global(.om-color-yellow) { color: #e9c52f; }
	.story-copy :global(.om-color-magenta), .story-contact :global(.om-color-magenta) { color: #d957bd; }

	.story-image {
		min-width: 0;
		margin: 0;
	}

	.story-image__button {
		display: block;
		text-decoration: none;
		width: 100%;
		padding: 0;
		overflow: hidden;
		border: 0;
		border-radius: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.story-image__button :global(img) {
		display: block;
		width: 100%;
		height: auto;
		max-height: 26rem;
		object-fit: contain;
		transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.story-image__button:hover :global(img),
	.story-image__button:focus-visible :global(img) {
		transform: scale(1.018);
	}

	.story-image__button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.35rem;
	}

	.story-image figcaption {
		padding-top: 0.75rem;
		font-size: 0.92rem;
		font-weight: 400;
		line-height: 1.5;
	}

	.story-contact {
		width: min(100%, 58rem);
		margin: 0 auto;
		padding: 1.5rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.4);
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
		font-size: clamp(1.25rem, 1.6vw, 1.5rem);
		font-weight: 400;
		line-height: 1.65;
		text-align: center;
	}

	.story-contact :global(p) {
		margin: 0;
		font: inherit;
	}

	.story-contact__actions {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-top: 2rem;
	}

	.story-contact__actions a {
		padding: 0.85rem 1.15rem;
		border: 1px solid currentColor;
		font-size: 0.72rem;
		font-weight: 450;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.vehicle-adjacent {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 2rem;
		padding: clamp(3rem, 5vw, 5rem) 0 clamp(8rem, 12vw, 12rem);
		border-top: 1px solid rgba(17, 17, 17, 0.3);
	}

	.vehicle-adjacent a {
		color: inherit;
		text-decoration: none;
	}

	.vehicle-adjacent__label {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.55rem;
		font-size: 0.66rem;
		font-weight: 450;
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.vehicle-adjacent__label svg {
		width: 1.5rem;
		height: 0.75rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-linejoin: miter;
		stroke-width: 1;
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.vehicle-adjacent strong {
		font-family: var(--font-heading);
		display: block;
		max-width: 31ch;
		font-size: clamp(0.9rem, 1.1vw, 1.08rem);
		font-weight: 450;
		line-height: 1.35;
		text-transform: uppercase;
	}

	.vehicle-adjacent__archive {
		font-size: 0.72rem;
		font-weight: 450;
		letter-spacing: 0.12em;
		text-align: center;
		text-transform: uppercase;
	}

	.vehicle-adjacent__next {
		text-align: right;
	}

	.vehicle-adjacent__next .vehicle-adjacent__label {
		justify-content: flex-end;
	}

	.vehicle-adjacent__next strong {
		margin-left: auto;
	}

	.vehicle-adjacent a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.vehicle-adjacent a:hover .vehicle-adjacent__label svg:first-child {
			transform: translateX(-0.25rem);
		}

		.vehicle-adjacent__next:hover .vehicle-adjacent__label svg:last-child {
			transform: translateX(0.25rem);
		}
	}

	.image-lightbox:not([open]) { display: none; }
	.image-lightbox {
		position: fixed;
		inset: 0;
		z-index: 1001;
		margin: auto;
		width: 100vw;
		max-width: none;
		height: 100vh;
		height: 100svh;
		max-height: none;
		padding: 0;
		border: 0;
		background: rgba(8, 8, 8, 0.97);
		color: #eeeeee;
	}

	.image-lightbox::backdrop {
		background: rgba(8, 8, 8, 0.9);
	}

	.image-lightbox__close {
		position: fixed;
		top: max(1.5rem, env(safe-area-inset-top, 0px));
		right: max(1.5rem, env(safe-area-inset-right, 0px));
		z-index: 2;
		padding: 0.75rem 1rem;
		border: 1px solid rgba(238, 238, 238, 0.62);
		color: inherit;
		background: rgba(17, 17, 17, 0.65);
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.image-lightbox__stage {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: clamp(4.5rem, 7vw, 6rem) clamp(1rem, 4vw, 4rem) clamp(1rem, 4vw, 4rem);
	}

	.image-lightbox__stage img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
