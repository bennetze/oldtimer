---
import { Image } from 'astro:assets';
import { socialProfiles } from '../config/social.js';
import tiktokIcon from '../assets/graphics/tiktok.svg?raw';
import instagramIcon from '../assets/graphics/instagram.svg?raw';
import facebookIcon from '../assets/graphics/facebook.svg?raw';
import { companyLogo } from '../config/branding';
import { languagePath } from '../i18n/language.js';
interface Props {
	theme?: 'dark' | 'light';
}

const socialIcons = { tiktok: tiktokIcon, instagram: instagramIcon, facebook: facebookIcon };

const navigationItems = [
	{ title: 'Startseite', href: '/', activePath: '/' },
	{ title: 'Handwerk', href: '/handwerk/', activePath: '/handwerk' },
	{ title: 'Leistungen', href: '/handwerk/#leistungen', activePath: undefined },
	{ title: 'Über uns', href: '/ueber-uns/', activePath: '/ueber-uns' },
	{ title: 'Projekte', href: '/projekte/', activePath: '/projekte' },
	{
		title: 'Fahrzeugangebote',
		href: '/projekte/fahrzeugangebote/',
		activePath: '/projekte/fahrzeugangebote',
	},
	{ title: 'Kontakt', href: '/ueber-uns/#kontakt', activePath: undefined },
];

const { theme = 'dark' } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const deploymentBase = basePath === '/' ? '' : basePath.replace(/\/$/, '');
const currentPath = (
	deploymentBase && Astro.url.pathname.startsWith(deploymentBase)
		? Astro.url.pathname.slice(deploymentBase.length)
		: Astro.url.pathname
).replace(/^\/en(?=\/|$)/, '').replace(/\/+$/, '') || '/';
const activeNavigationPath = currentPath.startsWith('/projekte/fahrzeugangebote')
	? '/projekte/fahrzeugangebote'
	: currentPath.startsWith('/projekte')
		? '/projekte'
		: currentPath;
const sitePath = (path) => {
	if (path === '/') {
		return basePath;
	}

	if (path.startsWith('/#')) {
		return `${basePath}${path.slice(1)}`;
	}

	if (path.startsWith('/')) {
		return `${basePath}${path.slice(1)}`;
	}

	return path;
};
---

<div class:list={['site-shell', { 'site-shell--light': theme === 'light', 'site-shell--home': currentPath === '/' }]}>
	<header class="site-header" data-floating-header>
		<a class="menu-toggle" href="#site-footer" aria-controls="site-menu" aria-expanded="false">
			<span class="menu-lines" aria-hidden="true"></span>
			<span>Menü</span>
		</a>
		<a class="brand brand--logo" href={sitePath('/')} aria-label="Die Oldtimermanufaktur Startseite">
			<Image class="brand-logo" src={companyLogo} width={840} widths={[240, 360, 480, 720, 840]} sizes="(max-width: 760px) min(320px, calc(100vw - 120px)), (max-width: 1400px) 30vw, 420px" alt="" aria-hidden="true" draggable="false" loading="eager" />
		</a>
		<nav class="language-switch" aria-label="Sprache wählen">
			<a href={`${languagePath(Astro.url.pathname, 'de', basePath)}?lang=de`} data-language="de" lang="de" hreflang="de" aria-label="DE – Deutsch">DE</a>
			<a href={`${languagePath(Astro.url.pathname, 'en', basePath)}?lang=en`} data-language="en" lang="en" hreflang="en" aria-label="EN – English">EN</a>
		</nav>
	</header>

	<div class="menu-overlay" id="site-menu" aria-hidden="true" inert style={`--last-item-index: ${navigationItems.length - 1}`}>
		<div class="menu-panel" role="dialog" aria-modal="true" aria-label="Hauptmenü">
			<div class="menu-panel__top">
				<button class="menu-close" type="button">Schließen</button>
				<span>DIE OLDTIMERMANUFAKTUR</span>
			</div>
			<nav class="menu-nav" aria-label="Hauptnavigation">
				{
					navigationItems.map((item, index) => (
						<a
							href={sitePath(item.href)}
							class="menu-nav__link"
							style={`--item-index: ${index}`}
							aria-current={item.activePath === activeNavigationPath ? 'page' : undefined}
						>
							{item.title}
						</a>
					))
				}
			</nav>
		</div>
	</div>

	<slot />

	<footer class="site-footer" id="site-footer">
		<a class="footer-brand" href={sitePath('/')}>DIE OLDTIMERMANUFAKTUR</a>
		<nav class="footer-primary" aria-label="Seitennavigation">
			{
				navigationItems.map((item) => (
					<a
						href={sitePath(item.href)}
						aria-current={item.activePath === activeNavigationPath ? 'page' : undefined}
					>
						{item.title}
					</a>
				))
			}
		</nav>
		<nav class="footer-social" aria-label="Social Media">
			{socialProfiles.map((profile) => (
				<a href={profile.href} aria-label={profile.name} rel="noopener noreferrer" target="_blank">
					<Fragment set:html={socialIcons[profile.icon]} />
				</a>
			))}
		</nav>
		<nav class="footer-legal" aria-label="Rechtliches">
			<a href={sitePath('/impressum/')}>Impressum</a>
			<a href={sitePath('/datenschutz/')}>Datenschutzerklärung</a>
		</nav>
		<p>© 2026 DIE OLDTIMERMANUFAKTUR</p>
	</footer>
</div>

<script>
	import { watchMedia, setIsolated } from '../scripts/accessibility.js';
	// Older engines do not understand selector() conditions or :focus-visible.
	let supportsFocusVisible = false;
	try { supportsFocusVisible = Boolean(window.CSS?.supports?.('selector(:focus-visible)')); } catch { /* Older CSS API. */ }
	if (!supportsFocusVisible) document.documentElement.classList.add('legacy-focus');
	const siteShell = document.querySelector('.site-shell');
	const menuToggle = document.querySelector('.menu-toggle');
	const menuOverlay = document.querySelector('.menu-overlay');
	const menuPanel = document.querySelector('.menu-panel');
	const menuClose = document.querySelector('.menu-close');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const sectionIndicator = document.querySelector('[data-section-indicator]');
	const indicatorControls = sectionIndicator
		? [...sectionIndicator.querySelectorAll('[data-section-target]')]
		: [];
	const sectionById = new Map();
	indicatorControls.forEach((control) => {
		const targetSelector = control.getAttribute('data-section-target');
		const section = targetSelector ? document.querySelector(targetSelector) : null;

		if (!(section instanceof HTMLElement)) {
			return;
		}

		sectionById.set(section.id, control);
	});
	let activeSectionScroll;

	const focusableMenuItems = () =>
		menuPanel ? [...menuPanel.querySelectorAll('a[href], button:not([disabled]), input:not([disabled])')] : [];

	const setMenuBackgroundInert = (shouldBeInert) => {
		if (!(siteShell instanceof HTMLElement)) {
			return;
		}

		[...siteShell.children, document.querySelector('.skip-link')].forEach((element) => {
			if (
				!(element instanceof HTMLElement) ||
				element === menuOverlay
			) {
				return;
			}

			setIsolated(element, shouldBeInert);
		});
	};

	let menuNavigationPending = false;

	const openMenu = () => {
		if (menuNavigationPending) return;
		stopSectionScroll();
		if (menuOverlay instanceof HTMLElement) {
			menuOverlay.inert = false;
			menuOverlay.removeAttribute('inert');
		}
		menuOverlay?.setAttribute('aria-hidden', 'false');
		menuToggle?.setAttribute('aria-expanded', 'true');
		document.body.classList.add('menu-is-open');
		focusableMenuItems()[0]?.focus();
		setMenuBackgroundInert(true);
	};

	const closeMenu = ({ restoreFocus = true } = {}) => {
		setMenuBackgroundInert(false);
		menuToggle?.setAttribute('aria-expanded', 'false');
		if (restoreFocus) menuToggle?.focus();
		else if (menuOverlay?.contains(document.activeElement)) document.activeElement?.blur();
		menuOverlay?.setAttribute('aria-hidden', 'true');
		if (menuOverlay instanceof HTMLElement) {
			menuOverlay.inert = true;
			menuOverlay.setAttribute('inert', '');
		}
		document.body.classList.remove('menu-is-open');
	};

	const clearHash = () => {
		if (window.location.hash) {
			window.history.replaceState(window.history.state, '', window.location.pathname + window.location.search);
		}
	};

	const stopSectionScroll = () => {
		if (activeSectionScroll !== undefined) {
			window.cancelAnimationFrame(activeSectionScroll);
			activeSectionScroll = undefined;
		}
	};

	const easeInOutQuart = (progress) =>
		progress < 0.5 ? 8 * progress * progress * progress * progress : 1 - Math.pow(-2 * progress + 2, 4) / 2;

	const animateSectionScroll = (targetTop) => {
		stopSectionScroll();

		const startTop = window.scrollY;
		const distance = targetTop - startTop;
		const duration = Math.min(1180, Math.max(980, Math.abs(distance) * 0.82));
		const startTime = window.performance.now();

		const step = (time) => {
			const progress = Math.min((time - startTime) / duration, 1);
			const easedProgress = easeInOutQuart(progress);

			window.scrollTo(0, startTop + distance * easedProgress);

			if (progress < 1) {
				activeSectionScroll = window.requestAnimationFrame(step);
				return;
			}

			activeSectionScroll = undefined;
		};

		activeSectionScroll = window.requestAnimationFrame(step);
	};

	const scrollToSection = (section) => {
		stopSectionScroll();

		if (prefersReducedMotion.matches || typeof window.requestAnimationFrame !== 'function') {
			section.scrollIntoView({ block: 'start', behavior: 'auto' });
			clearHash();
			return;
		}

		const scrollMarginTop = Number.parseFloat(window.getComputedStyle(section).scrollMarginTop) || 0;
		const targetTop = section.getBoundingClientRect().top + window.scrollY - scrollMarginTop;
		animateSectionScroll(targetTop);
		clearHash();
	};

	const setActiveIndicator = (id) => {
		indicatorControls.forEach((control) => {
			const isActive = control === sectionById.get(id);
			control.classList.toggle('is-active', isActive);
			if (isActive) {
				control.setAttribute('aria-current', 'true');
			} else {
				control.removeAttribute('aria-current');
			}
		});
	};

	window.addEventListener('wheel', () => {
		stopSectionScroll();
	}, { passive: true });

	window.addEventListener('touchstart', () => {
		stopSectionScroll();
	}, { passive: true });

	window.addEventListener('pointerdown', () => {
		stopSectionScroll();
	}, { passive: true });
	watchMedia(prefersReducedMotion, () => {
		if (prefersReducedMotion.matches) {
			stopSectionScroll();
		}
	});

	// Arrow keys retain browser and assistive-technology behavior.
	window.addEventListener('keydown', (event) => {
		if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', 'Space'].includes(event.code)) {
			stopSectionScroll();
		}
	});

	menuToggle?.addEventListener('click', (event) => { event.preventDefault(); openMenu(); });
	menuToggle?.setAttribute('role', 'button');
	menuToggle?.addEventListener('keydown', (event) => {
		if (event.key === ' ' || event.key === 'Enter') { event.preventDefault(); openMenu(); }
	});
	siteShell?.classList.add('chrome-ready');
	menuClose?.addEventListener('click', closeMenu);
	menuOverlay?.addEventListener('click', (event) => {
		if (event.target === menuOverlay) {
			closeMenu();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuOverlay?.getAttribute('aria-hidden') === 'false') {
			closeMenu();
			return;
		}

		if (event.key !== 'Tab' || menuOverlay?.getAttribute('aria-hidden') !== 'false') {
			return;
		}

		const items = focusableMenuItems();
		if (!items.length) return;
		// Safari may omit links from its native Tab order. Own the entire modal
		// cycle so every menu link is reachable and focus cannot escape.
		event.preventDefault();
		const index = items.indexOf(document.activeElement);
		const next = index < 0 ? (event.shiftKey ? items.length - 1 : 0)
			: (index + (event.shiftKey ? -1 : 1) + items.length) % items.length;
		items[next]?.focus();
	});

	// Wait for the real CSS exit, including cancellation when motion preferences change.
	const waitForExit = async (element, fallbackDuration) => {
		if (prefersReducedMotion.matches || !(element instanceof HTMLElement)) return;
		const animations = element.getAnimations?.() ?? [];
		await new Promise((resolve) => {
			const timer = window.setTimeout(resolve, fallbackDuration);
			if (animations.length) {
				Promise.allSettled(animations.map((animation) => animation.finished)).then(() => {
				window.clearTimeout(timer);
				resolve();
				});
			}
		});
	};

	window.addEventListener('pageshow', () => {
		// Back/Forward may restore the departing document from the browser cache.
		menuNavigationPending = false;
		menuOverlay?.classList.remove('is-navigating');
		setMenuBackgroundInert(false);
	});

	document.querySelectorAll('.menu-nav__link[href]').forEach((link) => {
		link.addEventListener('click', async (event) => {
			if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
			if (!(link instanceof HTMLAnchorElement) || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
			const destination = new URL(link.href, window.location.href);
			if (destination.origin !== window.location.origin) return;
			event.preventDefault();
			if (menuNavigationPending) return;
			menuNavigationPending = true;
			const samePage = destination.pathname === window.location.pathname && destination.search === window.location.search;
			menuOverlay?.classList.add('is-navigating');
			closeMenu({ restoreFocus: true });
			setMenuBackgroundInert(true);
			await waitForExit(menuPanel, 220);
			if (samePage) {
				menuNavigationPending = false;
				menuOverlay?.classList.remove('is-navigating');
				setMenuBackgroundInert(false);
				if (destination.hash) {
					window.location.assign(destination.href);
					let target;
					try { target = document.getElementById(decodeURIComponent(destination.hash.slice(1))); } catch { /* Preserve native fragment handling. */ }
					if (target instanceof HTMLElement) {
						if (!target.hasAttribute('tabindex')) {
							target.setAttribute('tabindex', '-1');
							target.addEventListener('blur', () => target.removeAttribute('tabindex'), { once: true });
						}
						target.focus({ preventScroll: true });
					}
				}
				return;
			}
			window.location.assign(destination.href);
		});
	});

	document.querySelectorAll('[data-scroll-target]').forEach((control) => {
		control.addEventListener('click', (event) => {
			if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
			const targetSelector = control.getAttribute('data-scroll-target');
			const target = targetSelector ? document.querySelector(targetSelector) : null;

			if (target instanceof HTMLElement) {
				event.preventDefault();
				if (sectionById.has(target.id)) {
					setActiveIndicator(target.id);
				}
				scrollToSection(target);
			}
		});
	});

	const updateAccessibleTextLayout = () => {
		const root = document.documentElement;
		if (!(root instanceof HTMLElement)) return;
		const style = window.getComputedStyle(root);
		const fontSize = Number.parseFloat(style.fontSize);
		const spacing = Number.parseFloat(style.letterSpacing);
		root.classList.toggle('accessible-text-layout', fontSize > 20 || spacing >= fontSize * 0.1);
		const header = document.querySelector('[data-floating-header]');
		if (header instanceof HTMLElement) {
			const height = `${header.getBoundingClientRect().height}px`;
			if (root.style.getPropertyValue('--accessible-header-height') !== height) root.style.setProperty('--accessible-header-height', height);
		}
	};
	updateAccessibleTextLayout();
	let textLayoutFrame;
	const requestTextLayout = () => {
		if (textLayoutFrame !== undefined) return;
		if (typeof window.requestAnimationFrame !== 'function') { updateAccessibleTextLayout(); return; }
		textLayoutFrame = window.requestAnimationFrame(() => { textLayoutFrame = undefined; updateAccessibleTextLayout(); });
	};
	window.addEventListener('resize', requestTextLayout);
	window.addEventListener('load', updateAccessibleTextLayout);
	if (document.fonts?.ready) document.fonts.ready.then(updateAccessibleTextLayout);
	if (typeof window.ResizeObserver === 'function') {
		const observer = new ResizeObserver(requestTextLayout);
		observer.observe(document.documentElement);
		const header = document.querySelector('[data-floating-header]');
		if (header) observer.observe(header);
	}

	if (sectionIndicator && 'IntersectionObserver' in window) {
		const visibleRatios = new Map();

		const sectionObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					visibleRatios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
				});

				if (activeSectionScroll) {
					return;
				}

				const activeEntry = [...visibleRatios.entries()].filter(([, ratio]) => ratio > 0).sort((a, b) => b[1] - a[1])[0];

				if (activeEntry?.[0]) {
					setActiveIndicator(activeEntry[0]);
				}
			},
			{
				root: null,
				threshold: [0.12, 0.28, 0.44, 0.6, 0.78],
			},
		);

		sectionById.forEach((_control, id) => {
			const section = document.getElementById(id);

			if (section) {
				sectionObserver.observe(section);
			}
		});
	}
</script>

<style>
	.language-switch {
		display: flex;
		justify-content: flex-end;
		gap: 0.75rem;
		font-size: clamp(1rem, 0.9rem + 0.4vw, 1.3rem);
		letter-spacing: 0.06em;
	}

	.language-switch a {
		color: inherit;
		padding: 0.65rem 0.15rem;
		text-decoration: none;
		opacity: var(--language-link-opacity, 0.6);
	}

	.language-switch a[aria-current="true"],
	.language-switch a:hover {
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 0.3rem;
	}

	.language-switch a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.2rem;
	}

	:global(html),
	:global(body),
	.site-shell {
		background: #101010;
		background-color: #101010;
	}

	.site-shell {
		--site-header-height: calc(clamp(104px, 88px + 5vw, 192px) + env(safe-area-inset-top, 0px));
		min-height: 100vh;
	}

	.site-shell--light {
		background: #eeeeee;
		background-color: #eeeeee;
		color: #111111;
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: var(--site-header-height);
		padding: env(safe-area-inset-top, 0px) clamp(1rem, 3vw, 3rem) 0;
		color: var(--color-main);
		background: rgba(16, 16, 16, 0.85);
		-webkit-backdrop-filter: blur(28px) saturate(108%);
		backdrop-filter: blur(28px) saturate(108%);
	}

	.site-shell--home .site-header {
		background: rgba(16, 16, 16, 0.40);
	}

	.site-shell:not(.site-shell--home) .site-header {
		--language-link-opacity: 0.75;
		color: #111111;
		background: rgba(255, 255, 255, 0.80);
	}

	.site-shell--home .brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(0.5rem, 0.85vw, 1rem);
		font-size: clamp(0.9rem, 1.35vw, 1.55rem);
	}

	.brand-mark {
		display: block;
		width: clamp(128px, 12vw, 224px);
		max-width: 100%;
		height: auto;
	}

	.brand,
	.footer-brand {
		font-family: var(--font-heading);
		color: currentColor;
		font-weight: 450;
		letter-spacing: 0.34em;
		text-decoration: none;
		text-align: center;
		white-space: nowrap;
	}

	.brand {
		font-size: clamp(0.75rem, 1.1vw, 1.25rem);
	}

	.brand.brand--logo {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 0;
		min-height: 44px;
	}

	.brand-logo {
		display: block;
		filter: brightness(85%);
		width: clamp(216px, 30vw, 420px);
		max-width: 100%;
		height: auto;
		max-height: calc(var(--site-header-height) - env(safe-area-inset-top, 0px) - 16px);
		object-fit: contain;
	}

	.footer-brand {
		font-size: clamp(0.72rem, 0.88vw, 0.88rem);
	}

	.menu-toggle,
	.menu-close {
		color: currentColor;
		background: transparent;
		border: 0;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.24em;
		font-size: 0.66rem;
		font-weight: 450;
	}

	.menu-toggle,
	.menu-close {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.8rem;
	}

	.menu-toggle {
		justify-self: start;
		min-height: 44px;
		padding: 0.75rem 0;
		font-size: clamp(1rem, 0.9rem + 0.4vw, 1.3rem);
	}

	.menu-lines,
	.menu-lines::before,
	.menu-lines::after {
		display: block;
		width: 23px;
		height: 1px;
		background: currentColor;
		content: '';
	}

	.menu-lines::before {
		transform: translateY(-7px);
	}

	.menu-lines::after {
		transform: translateY(6px);
	}


	.menu-overlay {
		/* Start the exit immediately; keep the overlay visible through the link stagger. */
		--menu-duration: calc(480ms + var(--last-item-index) * 50ms);
		position: fixed;
		inset: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		z-index: 90;
		background: rgba(16, 16, 16, 0.38);
		-webkit-backdrop-filter: blur(16px) saturate(106%);
		backdrop-filter: blur(16px) saturate(106%);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 260ms ease 160ms,
			visibility 0s linear var(--menu-duration);
	}

	.site-shell--home .menu-overlay {
		background: rgba(16, 16, 16, 0.24);
		-webkit-backdrop-filter: blur(16px) saturate(106%);
	}

	.menu-overlay[aria-hidden='false'] {
		transition-duration: 260ms, 0s;
		transition-delay: 0s, 0s;
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
	}

	.menu-panel {
		box-sizing: border-box;
		display: grid;
		grid-template-rows: auto 1fr;
		width: min(58vw, 820px);
		min-height: 100vh;
		padding: clamp(1.25rem, 3.4vw, 4rem);
		/* Keep navigation readable even when the browser cannot composite blur. */
		background: rgba(16, 16, 16, 0.96);
		-webkit-backdrop-filter: blur(28px) saturate(106%);
		backdrop-filter: blur(28px) saturate(106%);
		color: var(--color-main);
		transform: translateX(-100%);
		transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.site-shell--home .menu-panel {
		background: rgba(16, 16, 16, 0.96);
