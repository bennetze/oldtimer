---
import { siteStatus } from '../config/site';

interface Props {
	theme?: 'dark' | 'light';
}

const navigationItems = [
	{ title: 'Startseite', href: '/', activePath: '/' },
	{ title: 'Handwerk', href: '/handwerk/', activePath: '/handwerk' },
	{ title: 'Über uns', href: '/ueber-uns/', activePath: '/ueber-uns' },
	{ title: 'Projekte', href: '/projekte/', activePath: '/projekte' },
	{
		title: 'Fahrzeugangebote',
		href: '/projekte/fahrzeugangebote/',
		activePath: '/projekte/fahrzeugangebote',
	},
];

const { theme = 'dark' } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const deploymentBase = basePath === '/' ? '' : basePath.replace(/\/$/, '');
const currentPath = (
	deploymentBase && Astro.url.pathname.startsWith(deploymentBase)
		? Astro.url.pathname.slice(deploymentBase.length)
		: Astro.url.pathname
).replace(/\/+$/, '') || '/';
const activeNavigationPath = currentPath.startsWith('/projekte/fahrzeugangebote')
	? '/projekte/fahrzeugangebote'
	: currentPath.startsWith('/projekte')
		? '/projekte'
		: currentPath;
const sitePath = (path) => {
	if (path === '/') {
		return basePath;
	}

	if (path.startsWith('/#')) {
		return `${basePath}${path.slice(1)}`;
	}

	if (path.startsWith('/')) {
		return `${basePath}${path.slice(1)}`;
	}

	return path;
};
---

<div class:list={['site-shell', { 'site-shell--light': theme === 'light' }]}>
	<div class="cursor" aria-hidden="true"></div>
	{
		siteStatus.developmentPreview && siteStatus.aiPlaceholderImagesPresent && (
			<aside class="development-notice" role="note">
				<strong>Entwicklungsvorschau</strong>
				<span>
					Ein Teil der Bildmotive sind KI-generierte Platzhalter. Sie zeigen nicht die
					tatsächlichen Personen, Fahrzeuge oder Betriebsräume.
				</span>
			</aside>
		)
	}

	<header class="site-header" data-floating-header>
		<button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false">
			<span class="menu-lines" aria-hidden="true"></span>
			<span>Menü</span>
		</button>
		<a class="brand" href={sitePath('/')} aria-label="Die Oldtimermanufaktur Startseite">
			DIE OLDTIMERMANUFAKTUR
		</a>
		<span class="header-spacer" aria-hidden="true"></span>
	</header>

	<div class="menu-overlay" id="site-menu" aria-hidden="true" inert>
		<div class="menu-panel" role="dialog" aria-modal="true" aria-label="Hauptmenü">
			<div class="menu-panel__top">
				<button class="menu-close" type="button">Schließen</button>
				<span>DIE OLDTIMERMANUFAKTUR</span>
			</div>
			<nav class="menu-nav" aria-label="Hauptnavigation">
				{
					navigationItems.map((item, index) => (
						<a
							href={sitePath(item.href)}
							class="menu-nav__link"
							style={`--item-index: ${index}`}
							aria-current={item.activePath === activeNavigationPath ? 'page' : undefined}
						>
							{item.title}
						</a>
					))
				}
			</nav>
		</div>
	</div>

	<slot />

	<footer class="site-footer" id="site-footer">
		<a class="footer-brand" href={sitePath('/')}>DIE OLDTIMERMANUFAKTUR</a>
		<nav class="footer-primary" aria-label="Seitennavigation">
			{
				navigationItems.map((item) => (
					<a
						href={sitePath(item.href)}
						aria-current={item.activePath === activeNavigationPath ? 'page' : undefined}
					>
						{item.title}
					</a>
				))
			}
		</nav>
		<nav class="footer-legal" aria-label="Rechtliches">
			<a href={sitePath('/impressum/')}>Impressum</a>
			<a href={sitePath('/datenschutz/')}>Datenschutzerklärung</a>
		</nav>
		<div class="social-links" aria-label="Social Media">
			<span aria-label="YouTube-Profil folgt" title="YouTube-Profil folgt">
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.01 2.01 0 0 1-1.415 1.42c-1.16.312-5.568.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.01 2.01 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558l-.009-.104-.008-.105A31 31 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.01 2.01 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.171-.007.171-.007.087-.004.17-.006A100 100 0 0 1 7.858 2zM6.4 5.209v4.818l4.157-2.408z" />
				</svg>
			</span>
			<span aria-label="Instagram-Profil folgt" title="Instagram-Profil folgt">
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.276.373.145.64.318.92.598s.453.546.598.92c.11.281.24.705.276 1.485.039.844.047 1.096.047 3.232s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.276 1.485a2.5 2.5 0 0 1-.598.92c-.28.28-.547.453-.92.598-.282.11-.706.241-1.486.276-.843.039-1.096.047-3.232.047s-2.39-.008-3.233-.047c-.78-.035-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.598-.92c-.11-.282-.241-.706-.276-1.486-.039-.843-.046-1.096-.046-3.232s.007-2.388.046-3.232c.035-.78.166-1.204.276-1.486.145-.373.318-.64.598-.92s.547-.453.92-.598c.282-.11.705-.241 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92M8 3.892a4.108 4.108 0 1 0 0 8.216 4.108 4.108 0 0 0 0-8.216m0 1.442a2.666 2.666 0 1 1 0 5.332 2.666 2.666 0 0 1 0-5.332" />
				</svg>
			</span>
			<span aria-label="TikTok-Profil folgt" title="TikTok-Profil folgt">
				<svg viewBox="0 0 16 16" aria-hidden="true">
					<path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3z" />
				</svg>
			</span>
		</div>
		<p>© 2026 DIE OLDTIMERMANUFAKTUR</p>
	</footer>
</div>

<script>
	const cursor = document.querySelector('.cursor');
	const interactiveSelector = 'a, button, [role="button"]';
	const siteShell = document.querySelector('.site-shell');
	const menuToggle = document.querySelector('.menu-toggle');
	const menuOverlay = document.querySelector('.menu-overlay');
	const menuPanel = document.querySelector('.menu-panel');
	const menuClose = document.querySelector('.menu-close');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const sectionIndicator = document.querySelector('[data-section-indicator]');
	const indicatorControls = sectionIndicator
		? [...sectionIndicator.querySelectorAll('[data-section-target]')]
		: [];
	const sectionById = new Map();
	const sectionEntries = indicatorControls.flatMap((control) => {
		const targetSelector = control.getAttribute('data-section-target');
		const section = targetSelector ? document.querySelector(targetSelector) : null;

		if (!(section instanceof HTMLElement)) {
			return [];
		}

		sectionById.set(section.id, control);
		return [{ control, section }];
	});
	const sectionTargets = sectionEntries.map(({ section }) => section);
	const siteFooter = document.querySelector('#site-footer');
	const menuBackgroundState = new Map();
	let activeSectionScroll;
	let keyboardSectionIndex;

	if (cursor && window.matchMedia('(pointer: fine)').matches) {
		let cursorX = -40;
		let cursorY = -40;
		let cursorFrame;

		const renderCursor = () => {
			cursorFrame = undefined;
			cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
		};

		const requestCursorFrame = () => {
			if (!cursorFrame) {
				cursorFrame = window.requestAnimationFrame(renderCursor);
			}
		};

		document.documentElement.classList.add('has-custom-cursor');
		window.addEventListener('pointermove', (event) => {
			cursorX = event.clientX;
			cursorY = event.clientY;
			requestCursorFrame();
		}, { passive: true });
		document.addEventListener('pointerover', (event) => {
			if (event.target instanceof Element && event.target.closest(interactiveSelector)) {
				cursor.classList.add('is-active');
			}
		});
		document.addEventListener('pointerout', (event) => {
			if (event.target instanceof Element && event.target.closest(interactiveSelector)) {
				cursor.classList.remove('is-active');
			}
		});
	}

	const focusableMenuItems = () =>
		menuPanel ? [...menuPanel.querySelectorAll('a[href], button:not([disabled])')] : [];

	const setMenuBackgroundInert = (shouldBeInert) => {
		if (!(siteShell instanceof HTMLElement)) {
			return;
		}

		[...siteShell.children].forEach((element) => {
			if (
				!(element instanceof HTMLElement) ||
				element === menuOverlay ||
				element === cursor
			) {
				return;
			}

			if (shouldBeInert) {
				menuBackgroundState.set(element, element.inert);
				element.inert = true;
				return;
			}

			element.inert = menuBackgroundState.get(element) ?? false;
			menuBackgroundState.delete(element);
		});
	};

	const openMenu = () => {
		if (menuOverlay instanceof HTMLElement) {
			menuOverlay.inert = false;
		}
		menuOverlay?.setAttribute('aria-hidden', 'false');
		menuToggle?.setAttribute('aria-expanded', 'true');
		setMenuBackgroundInert(true);
		document.body.classList.add('menu-is-open');
		focusableMenuItems()[0]?.focus();
	};

	const closeMenu = ({ restoreFocus = true } = {}) => {
		menuOverlay?.setAttribute('aria-hidden', 'true');
		if (menuOverlay instanceof HTMLElement) {
			menuOverlay.inert = true;
		}
		menuToggle?.setAttribute('aria-expanded', 'false');
		document.body.classList.remove('menu-is-open');
		setMenuBackgroundInert(false);
		if (restoreFocus) {
			menuToggle?.focus();
		}
	};

	const clearHash = () => {
		if (window.location.hash) {
			window.history.replaceState(null, '', window.location.pathname + window.location.search);
		}
	};

	const stopSectionScroll = () => {
		if (activeSectionScroll) {
			window.cancelAnimationFrame(activeSectionScroll);
			activeSectionScroll = undefined;
		}
	};

	const easeInOutQuart = (progress) =>
		progress < 0.5 ? 8 * progress * progress * progress * progress : 1 - Math.pow(-2 * progress + 2, 4) / 2;

	const animateSectionScroll = (targetTop) => {
		stopSectionScroll();

		const startTop = window.scrollY;
		const distance = targetTop - startTop;
		const duration = Math.min(1180, Math.max(980, Math.abs(distance) * 0.82));
		const startTime = window.performance.now();

		const step = (time) => {
			const progress = Math.min((time - startTime) / duration, 1);
			const easedProgress = easeInOutQuart(progress);

			window.scrollTo(0, startTop + distance * easedProgress);

			if (progress < 1) {
				activeSectionScroll = window.requestAnimationFrame(step);
				return;
			}

			activeSectionScroll = undefined;
		};

		activeSectionScroll = window.requestAnimationFrame(step);
	};

	const scrollToSection = (section) => {
		stopSectionScroll();

		if (prefersReducedMotion.matches) {
			section.scrollIntoView({ block: 'start', behavior: 'auto' });
			clearHash();
			return;
		}

		const scrollMarginTop = Number.parseFloat(window.getComputedStyle(section).scrollMarginTop) || 0;
		const targetTop = section.getBoundingClientRect().top + window.scrollY - scrollMarginTop;
		animateSectionScroll(targetTop);
		clearHash();
	};

	const setActiveIndicator = (id) => {
		indicatorControls.forEach((control) => {
			const isActive = control === sectionById.get(id);
			control.classList.toggle('is-active', isActive);
			if (isActive) {
				control.setAttribute('aria-current', 'true');
			} else {
				control.removeAttribute('aria-current');
			}
		});
	};

	const getCurrentSectionIndex = () => {
		if (Number.isInteger(keyboardSectionIndex)) {
			return keyboardSectionIndex;
		}

		const activeControlIndex = sectionEntries.findIndex(({ control }) =>
			control.classList.contains('is-active'),
		);
		if (activeControlIndex >= 0) {
			return activeControlIndex;
		}

		let closestIndex = 0;
		let closestDistance = Number.POSITIVE_INFINITY;
		sectionTargets.forEach((section, index) => {
			const distance = Math.abs(section.getBoundingClientRect().top);
			if (distance < closestDistance) {
				closestIndex = index;
				closestDistance = distance;
			}
		});

		return closestIndex;
	};

	const isSectionArrowBlockedTarget = (target) =>
		target instanceof Element &&
		Boolean(
			target.closest(
				'a, button, input, textarea, select, summary, [contenteditable="true"], [role="textbox"], [role="button"]',
			),
		);

	window.addEventListener('wheel', () => {
		stopSectionScroll();
		keyboardSectionIndex = undefined;
	}, { passive: true });

	window.addEventListener('touchstart', () => {
		stopSectionScroll();
		keyboardSectionIndex = undefined;
	}, { passive: true });

	window.addEventListener('keydown', (event) => {
		const shouldHandleSectionArrow =
			['ArrowDown', 'ArrowUp'].includes(event.code) &&
			sectionTargets.length > 0 &&
			!event.altKey &&
			!event.ctrlKey &&
			!event.metaKey &&
			!event.shiftKey &&
			!isSectionArrowBlockedTarget(event.target) &&
			menuOverlay?.getAttribute('aria-hidden') !== 'false';

		if (shouldHandleSectionArrow && event.repeat) {
			event.preventDefault();
			return;
		}

		if (['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', 'Home', 'End', 'Space'].includes(event.code)) {
			stopSectionScroll();
		}

		if (shouldHandleSectionArrow) {
			event.preventDefault();

			const direction = event.code === 'ArrowDown' ? 1 : -1;
			const currentIndex = getCurrentSectionIndex();
			const nextIndex = currentIndex + direction;
			const nextSection = sectionTargets[nextIndex];

			if (nextSection instanceof HTMLElement) {
				keyboardSectionIndex = nextIndex;
				setActiveIndicator(nextSection.id);
				scrollToSection(nextSection);
				return;
			}

			if (
				direction > 0 &&
				siteFooter instanceof HTMLElement &&
				currentIndex === sectionTargets.length - 1
			) {
				keyboardSectionIndex = sectionTargets.length;
				scrollToSection(siteFooter);
				return;
			}
		}
	});

	menuToggle?.addEventListener('click', openMenu);
	menuClose?.addEventListener('click', closeMenu);
	menuOverlay?.addEventListener('click', (event) => {
		if (event.target === menuOverlay) {
			closeMenu();
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menuOverlay?.getAttribute('aria-hidden') === 'false') {
			closeMenu();
			return;
		}

		if (event.key !== 'Tab' || menuOverlay?.getAttribute('aria-hidden') !== 'false') {
			return;
		}

		const items = focusableMenuItems();
		const first = items[0];
		const last = items[items.length - 1];

		if (event.shiftKey && document.activeElement === first) {
			event.preventDefault();
			last?.focus();
		} else if (!event.shiftKey && document.activeElement === last) {
			event.preventDefault();
			first?.focus();
		}
	});

	document.querySelectorAll('.menu-nav__link[href]').forEach((link) => {
		link.addEventListener('click', () => {
			closeMenu({ restoreFocus: false });
		});
	});

	document.querySelectorAll('[data-scroll-target]').forEach((control) => {
		control.addEventListener('click', () => {
			const targetSelector = control.getAttribute('data-scroll-target');
			const target = targetSelector ? document.querySelector(targetSelector) : null;

			if (target instanceof HTMLElement) {
				const targetIndex = sectionTargets.indexOf(target);
				keyboardSectionIndex = targetIndex >= 0 ? targetIndex : undefined;
				if (targetIndex >= 0) {
					setActiveIndicator(target.id);
				}
				scrollToSection(target);
			}
		});
	});

	if (sectionIndicator && 'IntersectionObserver' in window) {
		const visibleRatios = new Map();

		const sectionObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					visibleRatios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
				});

				if (activeSectionScroll) {
					return;
				}

				const activeEntry = [...visibleRatios.entries()].sort((a, b) => b[1] - a[1])[0];

				if (activeEntry?.[0]) {
					setActiveIndicator(activeEntry[0]);
				}
			},
			{
				root: null,
				threshold: [0.12, 0.28, 0.44, 0.6, 0.78],
			},
		);

		sectionById.forEach((_control, id) => {
			const section = document.getElementById(id);

			if (section) {
				sectionObserver.observe(section);
			}
		});
	}
</script>

<style>
	:global(html),
	:global(body),
	.site-shell {
		background: #101010;
		background-color: #101010;
	}

	.site-shell {
		min-height: 100vh;
	}

	.site-shell--light {
		background: #eeeeee;
		background-color: #eeeeee;
		color: #111111;
	}

	.development-notice {
		position: fixed;
		top: 76px;
		left: 0;
		right: 0;
		z-index: 48;
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 0.85rem;
		padding: 0.52rem clamp(1rem, 3vw, 3rem);
		color: rgba(238, 238, 238, 0.82);
		background: rgba(16, 16, 16, 0.88);
		border-top: 1px solid rgba(238, 238, 238, 0.1);
		border-bottom: 1px solid rgba(238, 238, 238, 0.16);
		-webkit-backdrop-filter: blur(24px) saturate(106%);
		backdrop-filter: blur(24px) saturate(106%);
		font-size: 0.68rem;
		font-style: normal;
		font-weight: 350;
		letter-spacing: 0.035em;
		line-height: 1.45;
		text-align: center;
		pointer-events: none;
	}

	.development-notice strong {
		color: #eeeeee;
		font-size: 0.62rem;
		font-weight: 520;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	:global(.has-custom-cursor),
	:global(.has-custom-cursor *) {
		cursor: none !important;
	}

	.cursor {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 1000;
		width: 28px;
		height: 28px;
		border: 1px solid rgba(238, 238, 238, 0.84);
		border-radius: 999px;
		pointer-events: none;
		transform: translate3d(-40px, -40px, 0) translate(-50%, -50%);
		will-change: transform;
		transition:
			width 180ms ease,
			height 180ms ease,
			background 180ms ease,
			border-color 180ms ease;
	}

	.cursor.is-active {
		width: 42px;
		height: 42px;
		border-color: rgba(238, 238, 238, 0.72);
		background: rgba(238, 238, 238, 0.08);
	}

	.site-shell--light .cursor {
		border-color: rgba(17, 17, 17, 0.68);
	}

	.site-shell--light .cursor.is-active {
		border-color: rgba(17, 17, 17, 0.52);
		background: rgba(17, 17, 17, 0.06);
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 76px;
		padding: 0 clamp(1rem, 3vw, 3rem);
		color: var(--color-main);
		background: rgba(16, 16, 16, 0.34);
		-webkit-backdrop-filter: blur(28px) saturate(108%);
		backdrop-filter: blur(28px) saturate(108%);
	}

	.site-shell--light .site-header {
		color: #111111;
		background: rgba(238, 238, 238, 0.34);
	}

	.brand,
	.footer-brand {
		color: currentColor;
		font-weight: 500;
		letter-spacing: 0.34em;
		text-decoration: none;
		text-align: center;
		white-space: nowrap;
	}

	.brand {
		font-size: clamp(0.72rem, 0.9vw, 0.9rem);
	}

	.footer-brand {
		font-size: clamp(0.64rem, 0.78vw, 0.78rem);
	}

	.menu-toggle,
	.menu-close {
		color: currentColor;
		background: transparent;
		border: 0;
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.24em;
		font-size: 0.66rem;
		font-weight: 500;
	}

	.menu-toggle,
	.menu-close {
		display: inline-flex;
		align-items: center;
		justify-content: flex-end;
