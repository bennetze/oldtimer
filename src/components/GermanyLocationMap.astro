<style>
	.location-map {
		display: grid;
		gap: 0.9rem;
		width: min(100%, 19rem);
		margin: 0 0 clamp(2rem, 4vw, 3.5rem);
		color: inherit;
		text-decoration: none;
	}

	.location-map svg {
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.location-map__country {
		fill: rgba(17, 17, 17, 0.3);
		transition: fill 220ms ease;
	}

	.location-map__pin path {
		fill: #111111;
	}

	.location-map__pin circle {
		fill: #eeeeee;
	}

	.location-map > span {
		padding-top: 0.8rem;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		font-size: var(--text-utility);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.location-map:hover .location-map__country,
	.location-map:focus-visible .location-map__country {
		fill: rgba(17, 17, 17, 0.42);
	}

	.location-map:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.5rem;
	}

	@media (max-width: 840px) {
		.location-map {
			width: min(72vw, 18rem);
			margin-inline: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.location-map__country {
			transition: none;
		}
	}
</style>
