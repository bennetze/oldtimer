---
import { Image } from 'astro:assets';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import antonCar from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00382.webp';
import antonPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00649.webp';
import contactEntrance from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00445.webp';
import contactExterior from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00113.webp';
import marioPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00776.webp';
import teamConversation from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00096.webp';
import teamPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00806.webp';
import teamWorkshop from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00104.webp';
import germanyMap from '../assets/graphics/germany-silhouette.svg';
import locationPin from '../assets/graphics/geo-alt-fill.svg';
import teamPaint from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00517.webp';

const qualifications = {
	mario: ['KFZ-Mechaniker-Meister', 'KFZ-Elektriker-Meister', 'Karosseriebau-Meister'],
	anton: ['KFZ-Techniker-Meister'],
};
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url);
const aboutUrl = new URL('ueber-uns/', siteRoot);
const people = [
	{ name: 'Mario Schrank', description: 'Mario Schrank - Gründer/Inhaber/Geschäftsführer mit rund 40 Jahren Erfahrung in der Oldtimerrestaurierung.', id: 'mario-schrank', titles: qualifications.mario, image: marioPortrait },
	{ name: 'Anton Schrank', description: 'Anton Schrank - KFZ-Techniker-Meister, der die Oldtimermanufaktur in die nächste Generation führt.', id: 'anton-schrank', titles: qualifications.anton, image: antonPortrait },
].map(({ name, description, id, titles, image }) => ({
	'@type': 'Person',
	'@id': `${aboutUrl.href}#${id}`,
	name,
	description,
	image: new URL(image.src, siteRoot).href,
	worksFor: { '@id': `${siteRoot.href}#organization` },
	subjectOf: { '@id': `${aboutUrl.href}#webpage` },
	hasCredential: titles.map((title) => ({
		'@type': 'EducationalOccupationalCredential',
		name: title,
		credentialCategory: 'Meistertitel',
	})),
}));

const brand = {
	'@type': 'Brand',
	'@id': `${siteRoot.href}#brand`,
	name: 'OLDTIMERMANUFAKTUR®',
	description: "Der Name \"OLDTIMERMANUFAKTUR®\" ist eine durch uns sowohl beim Deutschen- als auch beim Europäischen Marken- und Patentamt eingetragene geschützte Marke.",
	subjectOf: { '@id': `${aboutUrl.href}#webpage` },
};

const sectionNavigationItems = [
	{ id: 'mario-schrank', label: 'Mario Schrank' },
	{ id: 'anton-schrank', label: 'Anton Schrank' },
	{ id: 'das-team', label: 'Das Team' },
	{ id: 'kontakt', label: 'Kontakt' },
];
---

<EditorialPageLayout
	title="Über uns"
	heading="Wir über uns"
	description="Lernen Sie Mario und Anton Schrank, unser Team und die geschützte Marke OLDTIMERMANUFAKTUR® kennen: Oldtimerrestaurierung in Fischbach/Rhön."
	sections={sectionNavigationItems}
	theme="light"
	background="var(--gradient-green)"
	openGraphImage={marioPortrait}
	openGraphImageAlt="Mario Schrank im dunkelblauen Poloshirt neben einem roten historischen Fahrzeug."
	structuredDataType="AboutPage"
	dateModified="2026-10-09"
	additionalJsonLd={[...people, brand]}
	sectionNavigationVisible={false}
>
	<section
		slot="opening"
					class="story story--images-right"
					aria-labelledby="mario-title"
					data-parallax-group
				>
					<header
						class="profile-heading"
						data-parallax-layer
						data-speed="0.045"
						data-range="42"
					>
						<h2 id="mario-title"><span class="profile-name">Mario Schrank</span><span class="profile-role"> - Gründer/<wbr />Inhaber/<wbr />Geschäftsführer</span></h2>
						<p class="profile-credentials">
							{qualifications.mario.map((title) => <span>{title}</span>)}
						</p>
					</header>
					<div class="story__layout">
						<div class="collage collage--single collage--right" role="group" aria-label="Mario Schrank in der Werkstatt">
							<figure
								class="image-layer image-layer--portrait"
								data-parallax-layer
								data-speed="0.12"
								data-range="132"
							>
								<Image
									src={marioPortrait}
									alt="Mario Schrank im dunkelblauen Poloshirt neben einem roten historischen Fahrzeug."
									widths={[560, 760, 972]}
									sizes="(max-width: 840px) 88vw, 48vw"
									format="webp"
									loading="eager"
								/>
							</figure>
						</div>

						<div class="story__copy">
							<p>
								Aufgewachsen in einer erfahrenen Technikerfamilie (Vater Maschinenbau- und Fahrzeug-Ingenieur, Großvater Elektro-Ingenieur) war der berufliche Weg im Bereich der Fahrzeugtechnik bereits in der Frühzeit geebnet.
							</p>
							<p>
								Bereits während seiner Ausbildung zum KFZ-Mechaniker begann mit 17 Jahren schon die Suche nach dem ersten eigenen Oldtimer. Es sollte ein DKW F2 von 1934 werden, den er anschließend bestens restaurierte und damit der Grundstein für seine spätere "Oldtimer-Laufbahn" beginnen sollte. Nach div. Fachausbildungen und Meisterschulen in den einzelnen Fachbereichen kam sehr schnell der Sprung in die betriebliche Selbständigkeit.
							</p>
							<p>
								Somit entstand bereits vor rund 40 Jahren der Grundstein für die heute inzwischen international anerkannte Oldtimer-Fachwerkstatt "DIE OLDTIMERMANUFAKTUR" und einem hochmotivierten Team von bestens ausgebildeten Mitarbeitern mit dem Resultat der Restaurierungen von höchster handwerklicher Präzision und Perfektion.
							</p>
							<p>
								So wurde aus dem einstigen Beruf - Berufung - und aus der einhergehenden Leidenschaft - heutige Passion.
							</p>
						</div>
					</div>
	</section>

	<section
				id="anton-schrank"
				class="story story--images-left"
				aria-labelledby="anton-title"
				data-parallax-group
			>
				<header
					class="profile-heading"
					data-parallax-layer
					data-speed="0.045"
					data-range="42"
				>
					<h2 id="anton-title"><span class="profile-name">Anton Schrank</span></h2>
					<p class="profile-credentials">
						{qualifications.anton.map((title) => <span>{title}</span>)}
					</p>
				</header>
				<div class="story__layout">
					<div class="collage collage--double collage--left collage--portraits" role="group" aria-label="Anton Schrank in der Werkstatt">
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.126"
							data-range="138"
						>
							<Image
								src={antonPortrait}
								alt="Anton Schrank mit Brille und dunkelblauem Poloshirt in der Werkstatt."
								widths={[560, 760, 971]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.218"
							data-range="202"
						>
							<Image
								src={antonCar}
								alt="Anton Schrank mit einem weißen Handschuh an einer dunkelblauen Karosserie."
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<p>
							Wie der Vater, so der Sohn: Bereits mit zwölf Jahren restauriert Anton Schrank gemeinsam mit seinem Vater seinen ersten eigenen Oldtimer, ein sehr seltener Traktor der Schweizer Marke Hürlimann.
						</p>
						<blockquote>
							Zitat: "Mich begeistern die schönen Formen und Farben, aber auch die klassische Technik der historischen Fahrzeuge – und das, was wir aus ihnen machen."
						</blockquote>
						<p>
							Nach seiner Ausbildung zum KFZ-Mechatroniker mit Abschluss als "Jahrgangsbester", entscheidet er sich sogleich zur fachlichen Weiterbildung zum KFZ-Techniker-Meister und gilt mit gerade einmal 20 Jahren als jüngster KFZ-Handwerks-Meister Deutschlands.
						</p>
						<p>
							Heute führt er "DIE OLDTIMERMANUFAKTUR" mit derselben Leidenschaft wie sein Vater in die nächste Generation.
						</p>
					</div>
				</div>
			</section>

			<section
				id="das-team"
				class="story story--images-right story--team"
				aria-labelledby="team-title"
				data-parallax-group
			>
				<h2 id="team-title">Das Team</h2>
				<div class="story__layout">
					<div class="collage collage--triple collage--right collage--team-details" role="group" aria-label="Einblicke in die Arbeit des Teams">
						<figure
							class="image-layer image-layer--team-main"
							data-parallax-layer
							data-speed="0.10"
							data-range="80"
						>
							<Image
								src={teamPortrait}
								alt="Eine weiß behandschuhte Hand liegt auf rotem Lack neben einer verchromten Fahrzeugleuchte."
								widths={[760, 1120, 1536]}
								sizes="(max-width: 840px) 94vw, 55vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-conversation"
							data-parallax-layer
							data-speed="0.18"
							data-range="135"
						>
							<Image
								src={teamConversation}
								alt="Eine Hand liegt auf einer blanken Karosseriekante mit Schleifspuren."
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 72vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-workshop"
							data-parallax-layer
							data-speed="0.24"
							data-range="170"
						>
							<Image
								src={teamWorkshop}
								alt="Hände bearbeiten die Kante eines Blechteils auf einer Werkbank."
								widths={[560, 840, 1120]}
								sizes="(max-width: 840px) 58vw, 31vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure class="image-layer image-layer--team-paint" data-parallax-layer data-speed="0.14" data-range="110">
							<Image src={teamPaint} alt="Eine Lackierpistole mit weißem Behälter sprüht auf eine helle Oberfläche." widths={[480, 760, 1024]} sizes="(max-width: 840px) 55vw, 28vw" format="webp" loading="lazy" />
						</figure>
					</div>

					<div class="story__copy">
						<p>
							Bei der fachgerechten Restaurierung von historischen Fahrzeugen greifen unterschiedlichste handwerkliche Arbeiten ineinander.
						</p>
						<p>
							Mit einem Team von technisch und handwerklich versierten Spezialisten - darunter viele Meister ihres Fachs - stellen wir uns Tag für Tag auch schwierigsten Herausforderungen mit dem Anspruch originalgetreuer und hochwertiger Restaurierungen.
						</p>
						<p>
							Hauptaugenmerk unserer Arbeiten sind dabei entsprechend originalgetreue und qualitativ hochwertige Komplettrestaurationen ganzer Fahrzeuge - komplett aus einer Hand, als auch gewünschte Teilrestaurationen und die Überholung einzelner Fahrzeugkomponenten.
						</p>
						<p>
							Mit diesem einzigartigen Leistungsspektrum und dieser hohen durchgängigen Fertigungstiefe bedienen wir quasi die gesamte Wertschöpfungskette im Bereich hochwertiger Oldtimerrestaurationen und wurden für unsere Ergebnisse bereits mehrfach international ausgezeichnet.
						</p>
						<p>
							Dabei verstehen wir unsere Arbeiten als eine Art Berufung und wertvollen Beitrag zur Erhaltung technisch – historischen Kulturgutes mit hoher Wertstabilität.
						</p>
						<p>
							Dafür wurden wir von der KFZ-Innung als erster und einziger Betrieb im hiesigen Verbandsgebiet mit der Zertifizierung "Fachbetrieb für historische Fahrzeuge" ausgezeichnet.
						</p>
					</div>
				</div>
				<div class="story__copy section-closing-copy">
					<p>Der Name "OLDTIMERMANUFAKTUR®" ist eine durch uns sowohl beim Deutschen- als auch beim Europäischen Marken- und Patentamt eingetragene geschützte Marke.</p>
				</div>
			</section>

			<section
				id="kontakt"
				class="story story--images-left story--contact"
				aria-labelledby="contact-title"
				data-parallax-group
			>
				<h2 id="contact-title">Kontakt</h2>
				<div class="story__layout">
					<div class="collage collage--double collage--left collage--contact" role="group" aria-label="Einblicke in die Werkstatt in Fischbach">
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.123"
							data-range="136"
						>
							<Image
								src={contactExterior}
								alt="Ein Mitarbeiter arbeitet an einem hellblauen Cabriolet, mit weiteren Fahrzeugen in der Werkstatt."
								widths={[560, 760, 1024]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.22"
							data-range="204"
						>
							<Image
								src={contactEntrance}
								alt="Drei Mitarbeiter stehen im Gespräch neben einem dunkelblauen Cabriolet in der Werkstatt."
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<address class="contact-list">
							<a href="tel:+493696683783">
								<span class="contact-label">Telefon</span>
								<strong>03 69 66 / 83 7 83</strong>
							</a>
							<a href="tel:+493696683635" aria-label="Faxnummer 03 69 66 / 83 6 35">
								<span class="contact-label">Fax</span>
								<strong>03 69 66 / 83 6 35</strong>
							</a>
							<a href="mailto:info@oldtimermanufaktur.de">
								<span class="contact-label">E-Mail</span>
								<strong>info@oldtimermanufaktur.de</strong>
							</a>
							<a
								class="maps-link"
								href="https://maps.app.goo.gl/jg4eC1XRAyLDoW1BA"
								target="_blank"
								rel="noreferrer"
								aria-label="Adresse in Google Maps öffnen: DIE OLDTIMERMANUFAKTUR GmbH, Kreuzweg 11a, 36452 Kaltennordheim-Fischbach i.d. Rhön"
							>
								<span class="contact-label">Adresse</span>
								<strong class="maps-link__value">
									<span class="maps-link__address">
										DIE OLDTIMERMANUFAKTUR GmbH,<br />
										Kreuzweg 11a,<br />
										36452 Kaltennordheim-Fischbach i.d. Rhön
									</span>
									<span class="maps-link__action" aria-hidden="true">In Google Maps öffnen ↗</span>
								</strong>
							</a>
						</address>
						<figure
							class="location-map"
							aria-label="Deutschlandkarte mit Standortmarkierung bei Fischbach in der Rhön"
							data-parallax-layer
							data-speed="0.055"
							data-range="28"
						>
							<img class="location-map__silhouette" src={germanyMap.src} width="522" height="729" alt="" loading="lazy" />
							<!-- Approximate Fischbach/Rhön position (50.65 N, 10.14 E); pin tip anchors to the map. -->
							<div class="location-map__marker">
								<img src={locationPin.src} width="24" height="24" alt="" loading="lazy" />
								<span>Fischbach</span>
							</div>
						</figure>
					</div>
				</div>
				<div class="story__copy section-closing-copy">
					<p>Wir sind ein überaus leistungsfähiger und inhabergeführter Restaurationsbetrieb in der geografischen Mitte Deutschlands – in Fischbach i. d. Rhön (inmitten des UNESCO-Biosphärenreservats Rhön) und sind damit von überall zentral und gut zu erreichen.</p>
				</div>
			</section>
</EditorialPageLayout>


<style>
	:global(.editorial-page) .collage--single,
	:global(.editorial-page) .collage--portraits,
	:global(.editorial-page) .collage--team-details { min-height: 0; }
	:global(.editorial-page) :is(.collage--single, .collage--portraits) .image-layer {
		position: relative; inset: auto; height: auto;
	}
	:global(.editorial-page) :is(.collage--single, .collage--portraits) img {
		display: block; height: auto;
	}
	:global(.editorial-page) .collage--single .image-layer { width: 78%; margin-left: auto; }
	:global(.editorial-page) .collage--portraits { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
	:global(.editorial-page) .collage--portraits .image-layer--portrait { width: 110%; }
	:global(.editorial-page) .collage--portraits .image-layer--landscape { width: 100%; margin-top: 55%; }
	:global(.editorial-page) .story--team {
		/* Reserve the full 170px downward travel plus heading clearance. */
		padding-bottom: max(var(--story-gap), clamp(15rem, 18vw, 18rem));
	}
	:global(.editorial-page) .story--team h2 {
		/* The top photo can travel 80px toward the heading. */
		margin-bottom: clamp(10rem, 12vw, 12rem);
	}
	:global(.editorial-page) .collage--team-details {
		min-height: clamp(44rem, 58vw, 52rem);
	}
	:global(.editorial-page) .collage--team-details .image-layer {
		position: absolute;
		inset: auto;
		height: auto;
		margin: 0;
	}
	:global(.editorial-page) .collage--team-details img {
		display: block;
		height: auto;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-main {
		top: 0;
		right: 0;
		width: 74%;
		z-index: 1;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-conversation {
		top: 30%;
		left: 0;
		width: 52%;
		z-index: 2;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-workshop {
		bottom: 4%;
		right: 0;
		width: 48%;
		z-index: 3;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-paint {
		bottom: 0;
		left: 10%;
		width: 24%;
		z-index: 4;
	}
	:global(.editorial-page) .collage--contact {
		min-height: clamp(34rem, 52vw, 48rem);
	}
	:global(.editorial-page) .collage--contact .image-layer--portrait {
		width: 94%;
		height: auto;
	}
	:global(.editorial-page) .collage--contact .image-layer--landscape {
		width: 68%;
		height: auto;
	}
	:global(.editorial-page) .collage--contact img {
		display: block;
		height: auto;
	}
	@media (max-width: 840px) {
		:global(.editorial-page) .collage--single .image-layer { width: 90%; }
		:global(.editorial-page) .story--team .story__layout { gap: clamp(2.5rem, 10vw, 4rem); }
		:global(.editorial-page) .story--team { padding-bottom: var(--story-gap); }
		:global(.editorial-page) .story--team h2 { margin-bottom: clamp(2rem, 8vw, 3rem); }
		:global(.editorial-page) .collage--team-details {
			min-height: clamp(25rem, 124vw, 35rem);
		}
		:global(.editorial-page) .collage--team-details .image-layer--team-main { width: 88%; }
		:global(.editorial-page) .collage--team-details .image-layer--team-conversation { top: 32%; width: 65%; }
		:global(.editorial-page) .collage--team-details .image-layer--team-workshop { width: 57%; bottom: 7%; }
		:global(.editorial-page) .collage--team-details .image-layer--team-paint { width: 31%; left: 3%; }
		:global(.editorial-page) .collage--contact {
			min-height: 0;
			display: grid;
			gap: 3rem;
		}
		:global(.editorial-page) .collage--contact .image-layer {
			position: relative;
			inset: auto;
		}
		:global(.editorial-page) .collage--contact .image-layer--landscape { justify-self: end; }
	}

	.profile-heading {
		margin-bottom: clamp(8rem, 10vw, 10.5rem);
		text-align: center;
		transform: translate3d(0, var(--parallax-y, 0), 0);
		will-change: transform;
	}

	:global(.editorial-page .story .profile-heading h2) {
		margin-bottom: clamp(2.25rem, 3vw, 3.5rem);
	}

	#mario-title .profile-name,
	#mario-title .profile-role,
	.profile-heading:has(#mario-title) .profile-credentials {
		color: #276b57;
	}

	#anton-title .profile-name,
	.profile-heading:has(#anton-title) .profile-credentials {
		color: #aad6c3;
	}

	:global(.editorial-page .story .profile-heading #mario-title) {
		font-size: clamp(1.9rem, 2.1vw, 3.4rem);
		line-height: 1.2;
	}

	.profile-credentials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem clamp(1rem, 2vw, 2.2rem);
		max-width: 68rem;
		margin: 0 auto;
		font-size: clamp(1.02rem, 1.2vw, 1.25rem);
		font-weight: 650;
		line-height: 1.5;
		letter-spacing: 0.105em;
		text-transform: uppercase;
	}


	@media (max-width: 840px) {
		.profile-heading {
			margin-bottom: clamp(2rem, 8vw, 3rem);
		}

		:global(.editorial-page .story .profile-heading h2) {
			margin-bottom: 1.75rem;
		}

		.profile-credentials {
			flex-direction: column;
			gap: 0.3rem;
			font-size: clamp(0.97rem, 4.15vw, 1.1rem);
			letter-spacing: 0.085em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.profile-heading {
			transform: none;
			will-change: auto;
		}
	}

	.story--contact {
		padding-bottom: clamp(11rem, 16vw, 17rem);
