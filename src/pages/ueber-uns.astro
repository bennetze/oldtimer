/Users/betannet/.zshenv:.:3: no such file or directory: /Users/betannet/.cargo/env
---
import { Image } from 'astro:assets';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import antonCar from '../assets/oldtimer/about-anton-car.png';
import antonPortrait from '../assets/oldtimer/about-anton-portrait.png';
import contactEntrance from '../assets/oldtimer/about-contact-entrance.png';
import contactExterior from '../assets/oldtimer/about-contact-exterior.png';
import marioCar from '../assets/oldtimer/about-mario-car.png';
import marioPortrait from '../assets/oldtimer/about-mario-portrait.png';
import teamConversation from '../assets/oldtimer/about-team-conversation.png';
import teamPortrait from '../assets/oldtimer/about-team-portrait.png';
import teamWorkshop from '../assets/oldtimer/about-team-workshop.png';
import heroSitePoster from '../assets/oldtimer/hero-site-poster.jpg';

const sectionNavigationItems = [
	{ id: 'mario-schrank', label: 'Mario Schrank' },
	{ id: 'anton-schrank', label: 'Anton Schrank' },
	{ id: 'das-team', label: 'Das Team' },
	{ id: 'kontakt', label: 'Kontakt' },
];
---

<EditorialPageLayout
	title="Über uns"
	heading="Wir über uns"
	description="Mario Schrank, Anton Schrank und das Team der Oldtimermanufaktur – verbunden durch Erfahrung, Leidenschaft und Liebe zu historischen Fahrzeugen."
	sections={sectionNavigationItems}
	theme="light"
	background="linear-gradient(180deg, #eeeeee 0%, #eeeeee 11%, #f7eee2 18%, #f8f3ec 30%, #e9dacf 39%, #9299c4 47%, #688dca 54%, #557fb8 61%, #6695d3 70%, #82afe2 82%, #ffffff 100%)"
	openGraphImage={heroSitePoster}
	openGraphImageAlt="Ein historischer Roadster während einer Fahrt"
	structuredDataType="AboutPage"
	dateModified="2026-08-03"
>
	<section
		slot="opening"
					class="story story--images-right"
					aria-labelledby="mario-title"
					data-parallax-group
				>
					<h2 id="mario-title">Mario Schrank</h2>
					<div class="story__layout">
						<div class="collage collage--double collage--right" aria-label="Visuelle Platzhalter für Mario Schrank">
							<figure
								class="image-layer image-layer--portrait"
								data-parallax-layer
								data-speed="0.12"
								data-range="132"
							>
								<Image
									src={marioPortrait}
									alt="KI-generierter Platzhalter für ein geplantes Porträt von Mario Schrank"
									widths={[560, 760, 972]}
									sizes="(max-width: 840px) 88vw, 48vw"
									format="webp"
									loading="eager"
								/>
							</figure>
							<figure
								class="image-layer image-layer--landscape"
								data-parallax-layer
								data-speed="0.21"
								data-range="196"
							>
								<Image
									src={marioCar}
									alt=""
									widths={[640, 960, 1280]}
									sizes="(max-width: 840px) 76vw, 42vw"
									format="webp"
									loading="lazy"
								/>
							</figure>
						</div>

						<div class="story__copy">
							<p>
								Mit 17 Jahren kauft Mario Schrank von seinem Ersparten einen DKW und restauriert ihn.
								Damit beginnt eine Leidenschaft, aus der 1987 die Oldtimermanufaktur entsteht. Heute
								verbindet der dreifache Meister jahrzehntelange Erfahrung mit höchster handwerklicher
								Präzision. Restaurierungen aus der Oldtimermanufaktur wurden bereits mehrfach
								international ausgezeichnet.
							</p>
						</div>
					</div>
	</section>

	<section
				id="anton-schrank"
				class="story story--images-left"
				aria-labelledby="anton-title"
				data-parallax-group
			>
				<h2 id="anton-title">Anton Schrank</h2>
				<div class="story__layout">
					<div class="collage collage--double collage--left" aria-label="Visuelle Platzhalter für Anton Schrank">
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.126"
							data-range="138"
						>
							<Image
								src={antonPortrait}
								alt="KI-generierter Platzhalter für ein geplantes Porträt von Anton Schrank"
								widths={[560, 760, 971]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.218"
							data-range="202"
						>
							<Image
								src={antonCar}
								alt=""
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<p>
							Wie der Vater, so der Sohn: Mit zwölf Jahren restauriert Anton Schrank gemeinsam mit
							seinem Vater seinen ersten historischen Traktor.
						</p>
						<blockquote>
							„Mich begeistern die Formen und Farben der alten Fahrzeuge – und das, was wir aus ihnen
							machen.“
						</blockquote>
						<p>
							Heute führt er die Oldtimermanufaktur mit derselben Leidenschaft in die nächste
							Generation.
						</p>
					</div>
				</div>
			</section>

			<section
				id="das-team"
				class="story story--images-right story--team"
				aria-labelledby="team-title"
				data-parallax-group
			>
				<h2 id="team-title">Das Team</h2>
				<div class="story__layout">
					<div class="collage collage--triple collage--right" aria-label="Visuelle Platzhalter für das Team">
						<figure
							class="image-layer image-layer--team-main"
							data-parallax-layer
							data-speed="0.104"
							data-range="122"
						>
							<Image
								src={teamPortrait}
								alt="KI-generierter Platzhalter für eine geplante Teamaufnahme"
								widths={[760, 1120, 1536]}
								sizes="(max-width: 840px) 94vw, 55vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-conversation"
							data-parallax-layer
							data-speed="0.19"
							data-range="180"
						>
							<Image
								src={teamConversation}
								alt=""
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 72vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-workshop"
							data-parallax-layer
							data-speed="0.245"
							data-range="220"
						>
							<Image
								src={teamWorkshop}
								alt=""
								widths={[560, 840, 1120]}
								sizes="(max-width: 840px) 58vw, 31vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<p>
							Bei der Arbeit an historischen Fahrzeugen greifen unterschiedliche handwerkliche
							Aufgaben ineinander. Maßstab sind ein sorgfältiger Umgang mit der vorhandenen Substanz,
							nachvollziehbare Entscheidungen und die Abstimmung der einzelnen Arbeitsschritte.
						</p>
					</div>
				</div>
			</section>

			<section
				id="kontakt"
				class="story story--images-left story--contact"
				aria-labelledby="contact-title"
				data-parallax-group
			>
				<h2 id="contact-title">Kontakt</h2>
				<div class="story__layout">
					<div class="collage collage--double collage--left" aria-label="Visuelle Platzhalter für den Standort in Fischbach">
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.123"
							data-range="136"
						>
							<Image
								src={contactExterior}
								alt="KI-generierter Platzhalter für eine geplante Außenaufnahme des Standorts"
								widths={[560, 760, 1024]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.22"
							data-range="204"
						>
							<Image
								src={contactEntrance}
								alt="KI-generierter Platzhalter für eine geplante Aufnahme des Werkstatteingangs"
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<address class="contact-list">
							<a href="tel:+493696683783">
								<span>Telefon</span>
								<strong>03 69 66 / 83 7 83</strong>
							</a>
							<a href="tel:+493696683635" aria-label="Faxnummer 03 69 66 / 83 6 35">
								<span>Fax</span>
								<strong>03 69 66 / 83 6 35</strong>
							</a>
							<a href="mailto:info@oldtimermanufaktur.de">
								<span>E-Mail</span>
								<strong>info@oldtimermanufaktur.de</strong>
							</a>
							<a
								href="https://maps.app.goo.gl/jg4eC1XRAyLDoW1BA"
								target="_blank"
								rel="noreferrer"
							>
								<span>Adresse · Google Maps ↗</span>
								<strong>
									i.d. Rhön DE, Kreuzweg 11a,<br />
									36452 Kaltennordheim-Fischbach/Rhön
								</strong>
							</a>
						</address>
					</div>
				</div>
			</section>
</EditorialPageLayout>


<style>
	.story--contact {
		padding-bottom: clamp(11rem, 16vw, 17rem);
	}

	.contact-list {
		display: grid;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		font-style: normal;
	}

	.contact-list a {
		display: grid;
		grid-template-columns: minmax(5.5rem, 0.34fr) minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.15rem 0 1.25rem;
		border-bottom: 1px solid rgba(17, 17, 17, 0.3);
		color: inherit;
		text-decoration: none;
	}

	.contact-list a:hover span,
	.contact-list a:hover strong {
		transform: translateX(0.55rem);
	}

	.contact-list a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	.contact-list span,
	.contact-list strong {
		font-size: clamp(0.88rem, 0.96vw, 1.04rem);
		line-height: 1.55;
		transition: transform 180ms ease;
	}

	.contact-list span {
		font-weight: 430;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.contact-list strong {
		min-width: 0;
		font-weight: 330;
		overflow-wrap: anywhere;
	}

	@media (max-width: 840px) {
		.story--contact {
			padding-bottom: clamp(8rem, 29vw, 11rem);
		}

		.contact-list a {
			grid-template-columns: 5.2rem minmax(0, 1fr);
			gap: 1rem;
		}

		.contact-list span,
		.contact-list strong {
			font-size: clamp(0.87rem, 3.8vw, 1rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-list span,
		.contact-list strong {
			transition: none;
			transform: none;
		}
	}
</style>
