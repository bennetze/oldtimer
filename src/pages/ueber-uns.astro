/Users/betannet/.zshenv:.:3: no such file or directory: /Users/betannet/.cargo/env
---
import { Image } from 'astro:assets';
import GermanyLocationMap from '../components/GermanyLocationMap.astro';
import type { Locale } from '../config/i18n';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import antonCar from '../assets/oldtimer/about-anton-car.png';
import antonPortrait from '../assets/oldtimer/about-anton-portrait.png';
import contactEntrance from '../assets/oldtimer/about-contact-entrance.png';
import contactExterior from '../assets/oldtimer/about-contact-exterior.png';
import marioCar from '../assets/oldtimer/about-mario-car.png';
import marioPortrait from '../assets/oldtimer/about-mario-portrait.png';
import teamConversation from '../assets/oldtimer/about-team-conversation.png';
import teamPortrait from '../assets/oldtimer/about-team-portrait.png';
import teamWorkshop from '../assets/oldtimer/about-team-workshop.png';
import heroSitePoster from '../assets/oldtimer/hero-site-poster.jpg';

interface Props {
	locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const copy = {
	de: {
		title: 'Über uns',
		heading: 'Wir über uns',
		description: 'Mario Schrank, Anton Schrank und das Team der Oldtimermanufaktur – verbunden durch Erfahrung, Leidenschaft und Liebe zu historischen Fahrzeugen.',
		sections: [
			{ id: 'mario-schrank', label: 'Mario Schrank' },
			{ id: 'anton-schrank', label: 'Anton Schrank' },
			{ id: 'das-team', label: 'Das Team' },
			{ id: 'kontakt', label: 'Kontakt' },
		],
		marioCopy: 'Mit 17 Jahren kauft Mario Schrank von seinem Ersparten einen DKW und restauriert ihn. Damit beginnt eine Leidenschaft, aus der 1987 die Oldtimermanufaktur entsteht. Heute verbindet der dreifache Meister jahrzehntelange Erfahrung mit höchster handwerklicher Präzision. Restaurierungen aus der Oldtimermanufaktur wurden bereits mehrfach international ausgezeichnet.',
		antonLead: 'Wie der Vater, so der Sohn: Mit zwölf Jahren restauriert Anton Schrank gemeinsam mit seinem Vater seinen ersten historischen Traktor.',
		antonQuote: '„Mich begeistern die Formen und Farben der alten Fahrzeuge – und das, was wir aus ihnen machen.“',
		antonEnd: 'Heute führt er die Oldtimermanufaktur mit derselben Leidenschaft in die nächste Generation.',
		teamCopy: 'Bei der Arbeit an historischen Fahrzeugen greifen unterschiedliche handwerkliche Aufgaben ineinander. Maßstab sind ein sorgfältiger Umgang mit der vorhandenen Substanz, nachvollziehbare Entscheidungen und die Abstimmung der einzelnen Arbeitsschritte.',
		credentials: 'Meisterqualifikationen',
		team: 'Das Team',
		contact: 'Kontakt',
		phone: 'Telefon',
		fax: 'Fax',
		email: 'E-Mail',
		address: 'Adresse',
		faxLabel: 'Faxnummer 03 69 66 / 83 6 35',
		marioVisual: 'Visuelle Platzhalter für Mario Schrank',
		antonVisual: 'Visuelle Platzhalter für Anton Schrank',
		teamVisual: 'Visuelle Platzhalter für das Team',
		contactVisual: 'Visuelle Platzhalter für den Standort in Fischbach',
	},
	en: {
		title: 'About us',
		heading: 'About us',
		description: 'Mario Schrank, Anton Schrank and the Oldtimermanufaktur team combine experience, passion and a deep appreciation for historic vehicles.',
		sections: [
			{ id: 'mario-schrank', label: 'Mario Schrank' },
			{ id: 'anton-schrank', label: 'Anton Schrank' },
			{ id: 'das-team', label: 'The team' },
			{ id: 'kontakt', label: 'Contact' },
		],
		marioCopy: 'At the age of 17, Mario Schrank bought a DKW with his savings and restored it. That project ignited a passion which led to the founding of the Oldtimermanufaktur in 1987. Today, the triple master craftsman combines decades of experience with the highest standards of precision. Restorations from the Oldtimermanufaktur have received multiple international awards.',
		antonLead: 'Like father, like son: at the age of twelve, Anton Schrank restored his first historic tractor together with his father.',
		antonQuote: '“I am fascinated by the forms and colours of old vehicles — and by what we can create from them.”',
		antonEnd: 'Today, he is carrying the Oldtimermanufaktur forward into the next generation with the same passion.',
		teamCopy: 'Restoring historic vehicles brings many different crafts together. Every project is guided by careful treatment of the existing fabric, transparent decisions and close coordination between each stage of the work.',
		credentials: 'Master craft qualifications',
		team: 'The team',
		contact: 'Contact',
		phone: 'Telephone',
		fax: 'Fax',
		email: 'Email',
		address: 'Address',
		faxLabel: 'Fax number +49 36966 83635',
		marioVisual: 'Visual placeholders for Mario Schrank',
		antonVisual: 'Visual placeholders for Anton Schrank',
		teamVisual: 'Visual placeholders for the team',
		contactVisual: 'Visual placeholders for the Fischbach location',
	},
}[locale];

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const personJsonLd = [
	{
		'@type': 'Person',
		'@id': `${pageUrl}#mario-schrank`,
		name: 'Mario Schrank',
		hasCredential: ['KFZ-Mechaniker-Meister', 'KFZ-Elektriker-Meister', 'Karosseriebau-Meister'].map((name) => ({
			'@type': 'EducationalOccupationalCredential',
			name,
		})),
	},
	{
		'@type': 'Person',
		'@id': `${pageUrl}#anton-schrank`,
		name: 'Anton Schrank',
		hasCredential: {
			'@type': 'EducationalOccupationalCredential',
			name: 'KFZ-Techniker-Meister',
		},
	},
];
---

<EditorialPageLayout
	title={copy.title}
	heading={copy.heading}
	description={copy.description}
	sections={copy.sections}
	theme="light"
	background="linear-gradient(180deg, #eeeeee 0%, #eeeeee 11%, #f7eee2 18%, #f8f3ec 30%, #e9dacf 39%, #9299c4 47%, #688dca 54%, #557fb8 61%, #6695d3 70%, #82afe2 82%, #ffffff 100%)"
	openGraphImage={heroSitePoster}
	openGraphImageAlt={locale === 'de' ? 'Ein historischer Roadster während einer Fahrt' : 'A historic roadster on the move'}
	structuredDataType="AboutPage"
	dateModified="2026-08-10"
	additionalJsonLd={personJsonLd}
	{locale}
>
	<section
		slot="opening"
					class="story story--images-right"
					aria-labelledby="mario-title"
					data-parallax-group
				>
					<h2 id="mario-title">Mario Schrank</h2>
					<div class="story__layout">
						<div class="collage collage--double collage--right" aria-label={copy.marioVisual}>
							<figure
								class="image-layer image-layer--portrait"
								data-parallax-layer
								data-speed="0.12"
								data-range="132"
							>
								<Image
									src={marioPortrait}
									alt={locale === 'de' ? 'KI-generierter Platzhalter für ein geplantes Porträt von Mario Schrank' : 'AI-generated placeholder for a planned portrait of Mario Schrank'}
									widths={[560, 760, 972]}
									sizes="(max-width: 840px) 88vw, 48vw"
									format="webp"
									loading="eager"
								/>
							</figure>
							<figure
								class="image-layer image-layer--landscape"
								data-parallax-layer
								data-speed="0.21"
								data-range="196"
							>
								<Image
									src={marioCar}
									alt=""
									widths={[640, 960, 1280]}
									sizes="(max-width: 840px) 76vw, 42vw"
									format="webp"
									loading="lazy"
								/>
							</figure>
						</div>

						<div class="story__copy">
							<p>{copy.marioCopy}</p>
							<div class="credentials" aria-label={copy.credentials}>
								<p>{copy.credentials}</p>
								<ul>
									<li>KFZ-Mechaniker-Meister</li>
									<li>KFZ-Elektriker-Meister</li>
									<li>Karosseriebau-Meister</li>
								</ul>
							</div>
						</div>
					</div>
	</section>

	<section
				id="anton-schrank"
				class="story story--images-left"
				aria-labelledby="anton-title"
				data-parallax-group
			>
				<h2 id="anton-title">Anton Schrank</h2>
				<div class="story__layout">
					<div class="collage collage--double collage--left" aria-label={copy.antonVisual}>
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.126"
							data-range="138"
						>
							<Image
								src={antonPortrait}
								alt={locale === 'de' ? 'KI-generierter Platzhalter für ein geplantes Porträt von Anton Schrank' : 'AI-generated placeholder for a planned portrait of Anton Schrank'}
								widths={[560, 760, 971]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.218"
							data-range="202"
						>
							<Image
								src={antonCar}
								alt=""
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<p>{copy.antonLead}</p>
						<blockquote>{copy.antonQuote}</blockquote>
						<p>{copy.antonEnd}</p>
						<div class="credentials" aria-label={copy.credentials}>
							<p>{copy.credentials}</p>
							<ul><li>KFZ-Techniker-Meister</li></ul>
						</div>
					</div>
				</div>
			</section>

			<section
				id="das-team"
				class="story story--images-right story--team"
				aria-labelledby="team-title"
				data-parallax-group
			>
				<h2 id="team-title">{copy.team}</h2>
				<div class="story__layout">
					<div class="collage collage--triple collage--right" aria-label={copy.teamVisual}>
						<figure
							class="image-layer image-layer--team-main"
							data-parallax-layer
							data-speed="0.104"
							data-range="122"
						>
							<Image
								src={teamPortrait}
								alt={locale === 'de' ? 'KI-generierter Platzhalter für eine geplante Teamaufnahme' : 'AI-generated placeholder for a planned team photograph'}
								widths={[760, 1120, 1536]}
								sizes="(max-width: 840px) 94vw, 55vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-conversation"
							data-parallax-layer
							data-speed="0.19"
							data-range="180"
						>
							<Image
								src={teamConversation}
								alt=""
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 72vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-workshop"
							data-parallax-layer
							data-speed="0.245"
							data-range="220"
						>
							<Image
								src={teamWorkshop}
								alt=""
								widths={[560, 840, 1120]}
								sizes="(max-width: 840px) 58vw, 31vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<p>{copy.teamCopy}</p>
					</div>
				</div>
			</section>

			<section
				id="kontakt"
				class="story story--images-left story--contact"
				aria-labelledby="contact-title"
				data-parallax-group
			>
				<h2 id="contact-title">{copy.contact}</h2>
				<div class="story__layout">
					<div class="collage collage--double collage--left" aria-label={copy.contactVisual}>
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.123"
							data-range="136"
						>
							<Image
								src={contactExterior}
								alt={locale === 'de' ? 'KI-generierter Platzhalter für eine geplante Außenaufnahme des Standorts' : 'AI-generated placeholder for a planned exterior photograph of the location'}
								widths={[560, 760, 1024]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.22"
							data-range="204"
						>
							<Image
								src={contactEntrance}
								alt={locale === 'de' ? 'KI-generierter Platzhalter für eine geplante Aufnahme des Werkstatteingangs' : 'AI-generated placeholder for a planned photograph of the workshop entrance'}
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<GermanyLocationMap {locale} />
						<address class="contact-list">
							<a href="tel:+493696683783">
								<span>{copy.phone}</span>
								<strong>03 69 66 / 83 7 83</strong>
							</a>
							<a href="tel:+493696683635" aria-label={copy.faxLabel}>
								<span>{copy.fax}</span>
								<strong>03 69 66 / 83 6 35</strong>
							</a>
							<a href="mailto:info@oldtimermanufaktur.de">
								<span>{copy.email}</span>
								<strong>info@oldtimermanufaktur.de</strong>
							</a>
							<div class="contact-list__row">
								<span>{copy.address}</span>
								<strong>
									i.d. Rhön DE, Kreuzweg 11a,<br />
									36452 Kaltennordheim-Fischbach/Rhön
								</strong>
							</div>
						</address>
					</div>
				</div>
			</section>
</EditorialPageLayout>


<style>
	.credentials {
		margin-top: clamp(2.25rem, 4vw, 3.5rem);
		padding-top: 1.1rem;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
	}

	.editorial-page .story__copy .credentials > p {
		margin: 0 0 0.9rem;
		font-size: var(--text-utility);
		font-weight: 600;
		letter-spacing: 0.14em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.credentials ul {
		display: grid;
		gap: 0.42rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.credentials li {
		font-size: clamp(1.08rem, 1.16vw, 1.28rem);
		font-weight: 550;
		line-height: 1.35;
	}

	.story--contact {
		padding-bottom: clamp(11rem, 16vw, 17rem);
	}

	.contact-list {
		display: grid;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		font-style: normal;
	}

	.contact-list a,
	.contact-list__row {
		display: grid;
		grid-template-columns: minmax(5.5rem, 0.34fr) minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.15rem 0 1.25rem;
		border-bottom: 1px solid rgba(17, 17, 17, 0.3);
		color: inherit;
		text-decoration: none;
	}

	.contact-list a:hover span,
	.contact-list a:hover strong {
		transform: translateX(0.55rem);
	}

	.contact-list a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	.contact-list span,
	.contact-list strong {
		font-size: clamp(1rem, 1.08vw, 1.18rem);
		line-height: 1.55;
		transition: transform 180ms ease;
	}

	.contact-list span {
		font-weight: 430;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.contact-list strong {
		min-width: 0;
		font-weight: 400;
		overflow-wrap: anywhere;
	}

	@media (max-width: 840px) {
		.story--contact {
			padding-bottom: clamp(8rem, 29vw, 11rem);
		}

		.contact-list a,
		.contact-list__row {
			grid-template-columns: 5.2rem minmax(0, 1fr);
			gap: 1rem;
		}

		.contact-list span,
		.contact-list strong {
			font-size: clamp(1rem, 4.1vw, 1.12rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-list span,
		.contact-list strong {
			transition: none;
			transform: none;
		}
	}
</style>
