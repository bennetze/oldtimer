---
import { Image } from 'astro:assets';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import antonCar from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00382.webp';
import antonPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00649.webp';
import contactEntrance from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00445.webp';
import contactExterior from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00113.webp';
import marioPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00776.webp';
import teamConversation from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00096.webp';
import teamPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00806.webp';
import teamWorkshop from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00104.webp';
import germanyMap from '../assets/graphics/germany-silhouette.svg';
import locationPin from '../assets/graphics/geo-alt-fill.svg';
import teamPaint from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00517.webp';

const qualifications = {
	mario: ['KFZ-Mechaniker-Meister', 'KFZ-Elektriker-Meister', 'Karosseriebau-Meister'],
	anton: ['KFZ-Techniker-Meister'],
};
const siteRoot = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url);
const aboutUrl = new URL('ueber-uns/', siteRoot);
const people = [
	{ name: 'Mario Schrank', id: 'mario-schrank', titles: qualifications.mario, image: marioPortrait },
	{ name: 'Anton Schrank', id: 'anton-schrank', titles: qualifications.anton, image: antonPortrait },
].map(({ name, id, titles, image }) => ({
	'@type': 'Person',
	'@id': `${aboutUrl.href}#${id}`,
	name,
	image: new URL(image.src, siteRoot).href,
	worksFor: { '@id': `${siteRoot.href}#organization` },
	subjectOf: { '@id': `${aboutUrl.href}#webpage` },
	hasCredential: titles.map((title) => ({
		'@type': 'EducationalOccupationalCredential',
		name: title,
		credentialCategory: 'Meistertitel',
	})),
}));

const sectionNavigationItems = [
	{ id: 'mario-schrank', label: 'Mario Schrank' },
	{ id: 'anton-schrank', label: 'Anton Schrank' },
	{ id: 'das-team', label: 'Das Team' },
	{ id: 'kontakt', label: 'Kontakt' },
];
---

<EditorialPageLayout
	title="Über uns"
	heading="Wir über uns"
	description="Mario Schrank, dreifacher Meister, und Anton Schrank, KFZ-Techniker-Meister: Lernen Sie die Menschen, das Handwerk und unseren Standort in Fischbach/Rhön kennen."
	sections={sectionNavigationItems}
	theme="light"
	background="linear-gradient(180deg, #ffffff 0%, #ffffff 11%, #f7eee2 18%, #f8f3ec 30%, #e9dacf 39%, #b1b6d5 47%, #8faede 54%, #80a3d1 61%, #8bb0e1 70%, #a6c6ec 82%, #ffffff 100%)"
	openGraphImage={marioPortrait}
	openGraphImageAlt="Mario Schrank neben einem historischen Fahrzeug in der Werkstatt"
	structuredDataType="AboutPage"
	dateModified="2026-09-28"
	additionalJsonLd={people}
	sectionNavigationVisible={false}
>
	<section
		slot="opening"
					class="story story--images-right"
					aria-labelledby="mario-title"
					data-parallax-group
				>
					<header
						class="profile-heading"
						data-parallax-layer
						data-speed="0.045"
						data-range="42"
					>
						<h2 id="mario-title">Mario Schrank</h2>
						<p class="profile-credentials" aria-label="Meisterqualifikationen">
							{qualifications.mario.map((title) => <span>{title}</span>)}
						</p>
					</header>
					<div class="story__layout">
						<div class="collage collage--single collage--right" aria-label="Mario Schrank in der Werkstatt">
							<figure
								class="image-layer image-layer--portrait"
								data-parallax-layer
								data-speed="0.12"
								data-range="132"
							>
								<Image
									src={marioPortrait}
									alt="Mario Schrank neben einem historischen Fahrzeug in der Werkstatt"
									widths={[560, 760, 972]}
									sizes="(max-width: 840px) 88vw, 48vw"
									format="webp"
									loading="eager"
								/>
							</figure>
						</div>

						<div class="story__copy">
							<p>
								Mit 17 Jahren kauft Mario Schrank von seinem Ersparten einen DKW und restauriert ihn.
								Damit beginnt eine Leidenschaft, aus der 1987 die Oldtimermanufaktur entsteht. Heute
								verbindet der dreifache Meister jahrzehntelange Erfahrung mit höchster handwerklicher
								Präzision. Restaurierungen aus der Oldtimermanufaktur wurden bereits mehrfach
								international ausgezeichnet.
							</p>
						</div>
					</div>
	</section>

	<section
				id="anton-schrank"
				class="story story--images-left"
				aria-labelledby="anton-title"
				data-parallax-group
			>
				<header
					class="profile-heading"
					data-parallax-layer
					data-speed="0.045"
					data-range="42"
				>
					<h2 id="anton-title">Anton Schrank</h2>
					<p class="profile-credentials" aria-label="Meisterqualifikationen">
						{qualifications.anton.map((title) => <span>{title}</span>)}
					</p>
				</header>
				<div class="story__layout">
					<div class="collage collage--double collage--left collage--portraits" aria-label="Anton Schrank in der Werkstatt">
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.126"
							data-range="138"
						>
							<Image
								src={antonPortrait}
								alt="Anton Schrank in der Werkstatt"
								widths={[560, 760, 971]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.218"
							data-range="202"
						>
							<Image
								src={antonCar}
								alt="Anton Schrank bei der Arbeit an einer Fahrzeugkarosserie"
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<p>
							Wie der Vater, so der Sohn: Mit zwölf Jahren restauriert Anton Schrank gemeinsam mit
							seinem Vater seinen ersten historischen Traktor.
						</p>
						<blockquote>
							„Mich begeistern die Formen und Farben der alten Fahrzeuge – und das, was wir aus ihnen
							machen.“
						</blockquote>
						<p>
							Heute führt er die Oldtimermanufaktur mit derselben Leidenschaft in die nächste
							Generation.
						</p>
					</div>
				</div>
			</section>

			<section
				id="das-team"
				class="story story--images-right story--team"
				aria-labelledby="team-title"
				data-parallax-group
			>
				<h2 id="team-title">Das Team</h2>
				<div class="story__layout">
					<div class="collage collage--triple collage--right collage--team-details" aria-label="Einblicke in die Arbeit des Teams">
						<figure
							class="image-layer image-layer--team-main"
							data-parallax-layer
							data-speed="0.10"
							data-range="80"
						>
							<Image
								src={teamPortrait}
								alt="Eine behandschuhte Hand prüft die rote Lackoberfläche eines Oldtimers"
								widths={[760, 1120, 1536]}
								sizes="(max-width: 840px) 94vw, 55vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-conversation"
							data-parallax-layer
							data-speed="0.18"
							data-range="135"
						>
							<Image
								src={teamConversation}
								alt="Eine Hand prüft die Form eines blanken Karosserieblechs"
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 72vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--team-workshop"
							data-parallax-layer
							data-speed="0.24"
							data-range="170"
						>
							<Image
								src={teamWorkshop}
								alt="Präzise Handarbeit an einem kleinen Bauteil auf der Werkbank"
								widths={[560, 840, 1120]}
								sizes="(max-width: 840px) 58vw, 31vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure class="image-layer image-layer--team-paint" data-parallax-layer data-speed="0.14" data-range="110">
							<Image src={teamPaint} alt="Eine Lackierpistole beim Auftragen von Lack" widths={[480, 760, 1024]} sizes="(max-width: 840px) 55vw, 28vw" format="webp" loading="lazy" />
						</figure>
					</div>

					<div class="story__copy">
						<p>
							Bei der Arbeit an historischen Fahrzeugen greifen unterschiedliche handwerkliche
							Aufgaben ineinander. Maßstab sind ein sorgfältiger Umgang mit der vorhandenen Substanz,
							nachvollziehbare Entscheidungen und die Abstimmung der einzelnen Arbeitsschritte.
						</p>
					</div>
				</div>
			</section>

			<section
				id="kontakt"
				class="story story--images-left story--contact"
				aria-labelledby="contact-title"
				data-parallax-group
			>
				<h2 id="contact-title">Kontakt</h2>
				<div class="story__layout">
					<div class="collage collage--double collage--left collage--contact" aria-label="Einblicke in die Werkstatt in Fischbach">
						<figure
							class="image-layer image-layer--portrait"
							data-parallax-layer
							data-speed="0.123"
							data-range="136"
						>
							<Image
								src={contactExterior}
								alt="Arbeit an einem historischen Cabriolet in der Werkstatt"
								widths={[560, 760, 1024]}
								sizes="(max-width: 840px) 88vw, 48vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
						<figure
							class="image-layer image-layer--landscape"
							data-parallax-layer
							data-speed="0.22"
							data-range="204"
						>
							<Image
								src={contactEntrance}
								alt="Drei Mitarbeiter im Gespräch an einem historischen Fahrzeug"
								widths={[640, 960, 1280]}
								sizes="(max-width: 840px) 76vw, 42vw"
								format="webp"
								loading="lazy"
							/>
						</figure>
					</div>

					<div class="story__copy">
						<address class="contact-list">
							<a href="tel:+493696683783">
								<span class="contact-label">Telefon</span>
								<strong>03 69 66 / 83 7 83</strong>
							</a>
							<a href="tel:+493696683635" aria-label="Faxnummer 03 69 66 / 83 6 35">
								<span class="contact-label">Fax</span>
								<strong>03 69 66 / 83 6 35</strong>
							</a>
							<a href="mailto:info@oldtimermanufaktur.de">
								<span class="contact-label">E-Mail</span>
								<strong>info@oldtimermanufaktur.de</strong>
							</a>
							<a
								class="maps-link"
								href="https://maps.app.goo.gl/jg4eC1XRAyLDoW1BA"
								target="_blank"
								rel="noreferrer"
								aria-label="Adresse in Google Maps öffnen: i.d. Rhön DE, Kreuzweg 11a, 36452 Kaltennordheim-Fischbach/Rhön"
							>
								<span class="contact-label">Adresse</span>
								<strong class="maps-link__value">
									<span class="maps-link__address">
										i.d. Rhön DE, Kreuzweg 11a,<br />
										36452 Kaltennordheim-Fischbach/Rhön
									</span>
									<span class="maps-link__action" aria-hidden="true">In Google Maps öffnen ↗</span>
								</strong>
							</a>
						</address>
						<figure
							class="location-map"
							aria-label="Deutschlandkarte mit Standortmarkierung bei Fischbach in der Rhön"
							data-parallax-layer
							data-speed="0.055"
							data-range="28"
						>
							<img class="location-map__silhouette" src={germanyMap.src} width="522" height="729" alt="" loading="lazy" />
							<!-- Approximate Fischbach/Rhön position (50.65 N, 10.14 E); pin tip anchors to the map. -->
							<div class="location-map__marker">
								<img src={locationPin.src} width="24" height="24" alt="" loading="lazy" />
								<span>Fischbach</span>
							</div>
						</figure>
					</div>
				</div>
			</section>
</EditorialPageLayout>


<style>
	:global(.editorial-page) .collage--single,
	:global(.editorial-page) .collage--portraits,
	:global(.editorial-page) .collage--team-details { min-height: 0; }
	:global(.editorial-page) :is(.collage--single, .collage--portraits) .image-layer {
		position: relative; inset: auto; height: auto;
	}
	:global(.editorial-page) :is(.collage--single, .collage--portraits) img {
		display: block; height: auto;
	}
	:global(.editorial-page) .collage--single .image-layer { width: 78%; margin-left: auto; }
	:global(.editorial-page) .collage--portraits { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
	:global(.editorial-page) .collage--portraits .image-layer--portrait { width: 110%; }
	:global(.editorial-page) .collage--portraits .image-layer--landscape { width: 100%; margin-top: 55%; }
	:global(.editorial-page) .story--team {
		/* Reserve the full 170px downward travel plus heading clearance. */
		padding-bottom: clamp(15rem, 18vw, 18rem);
	}
	:global(.editorial-page) .story--team h2 {
		/* The top photo can travel 80px toward the heading. */
		margin-bottom: clamp(10rem, 12vw, 12rem);
	}
	:global(.editorial-page) .collage--team-details {
		min-height: clamp(44rem, 58vw, 52rem);
	}
	:global(.editorial-page) .collage--team-details .image-layer {
		position: absolute;
		inset: auto;
		height: auto;
		margin: 0;
	}
	:global(.editorial-page) .collage--team-details img {
		display: block;
		height: auto;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-main {
		top: 0;
		right: 0;
		width: 74%;
		z-index: 1;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-conversation {
		top: 30%;
		left: 0;
		width: 52%;
		z-index: 2;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-workshop {
		bottom: 4%;
		right: 0;
		width: 48%;
		z-index: 3;
	}
	:global(.editorial-page) .collage--team-details .image-layer--team-paint {
		bottom: 0;
		left: 10%;
		width: 24%;
		z-index: 4;
	}
	:global(.editorial-page) .collage--contact {
		min-height: clamp(34rem, 52vw, 48rem);
	}
	:global(.editorial-page) .collage--contact .image-layer--portrait {
		width: 94%;
		height: auto;
	}
	:global(.editorial-page) .collage--contact .image-layer--landscape {
		width: 68%;
		height: auto;
	}
	:global(.editorial-page) .collage--contact img {
		display: block;
		height: auto;
	}
	@media (max-width: 840px) {
		:global(.editorial-page) .collage--single .image-layer { width: 90%; }
		:global(.editorial-page) .story--team .story__layout { gap: 5rem; }
		:global(.editorial-page) .collage--team-details {
			min-height: clamp(28rem, 124vw, 44rem);
		}
		:global(.editorial-page) .collage--team-details .image-layer--team-main { width: 88%; }
		:global(.editorial-page) .collage--team-details .image-layer--team-conversation { top: 32%; width: 65%; }
		:global(.editorial-page) .collage--team-details .image-layer--team-workshop { width: 57%; bottom: 7%; }
		:global(.editorial-page) .collage--team-details .image-layer--team-paint { width: 31%; left: 3%; }
		:global(.editorial-page) .collage--contact {
			min-height: 0;
			display: grid;
			gap: 3rem;
		}
		:global(.editorial-page) .collage--contact .image-layer {
			position: relative;
			inset: auto;
		}
		:global(.editorial-page) .collage--contact .image-layer--landscape { justify-self: end; }
	}

	.profile-heading {
		margin-bottom: clamp(8rem, 10vw, 10.5rem);
		text-align: center;
		transform: translate3d(0, var(--parallax-y, 0), 0);
		will-change: transform;
	}

	:global(.editorial-page .story .profile-heading h2) {
		margin-bottom: clamp(2.25rem, 3vw, 3.5rem);
	}

	.profile-credentials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem clamp(1rem, 2vw, 2.2rem);
		max-width: 68rem;
		margin: 0 auto;
		font-size: clamp(1.02rem, 1.2vw, 1.25rem);
		font-weight: 650;
		line-height: 1.5;
		letter-spacing: 0.105em;
		text-transform: uppercase;
	}


	@media (max-width: 840px) {
		.profile-heading {
			margin-bottom: clamp(7.5rem, 31vw, 9rem);
		}

		:global(.editorial-page .story .profile-heading h2) {
			margin-bottom: 1.75rem;
		}

		.profile-credentials {
			flex-direction: column;
			gap: 0.3rem;
			font-size: clamp(0.97rem, 4.15vw, 1.1rem);
			letter-spacing: 0.085em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.profile-heading {
			transform: none;
			will-change: auto;
		}
	}

	.story--contact {
		padding-bottom: clamp(11rem, 16vw, 17rem);
	}

	.location-map {
		position: relative;
		width: min(82%, 18rem);
		margin: 4.5rem auto 1.75rem;
		transform: translate3d(0, var(--parallax-y, 0), 0);
		will-change: transform;
	}

	.location-map__silhouette {
		display: block;
		width: 100%;
		height: auto;
	}

	.location-map__marker {
		position: absolute;
		left: 46%;
		top: 57%;
		color: #000000;
	}

	.location-map__marker img {
		position: absolute;
		left: -12px;
		bottom: 0;
		width: 24px;
		height: 24px;
	}

	.location-map__marker span {
		position: absolute;
		left: 1rem;
		bottom: 0.2rem;
		font-size: clamp(0.8rem, 0.95vw, 0.95rem);
		font-weight: 500;
		letter-spacing: 0.06em;
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		.location-map {
			transform: none;
			will-change: auto;
		}
	}

	.contact-list {
		display: grid;
		border-top: 1px solid rgba(17, 17, 17, 0.3);
		font-style: normal;
	}

	.contact-list a {
		display: grid;
		grid-template-columns: minmax(5.5rem, 0.34fr) minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.15rem 0 1.25rem;
		border-bottom: 1px solid rgba(17, 17, 17, 0.3);
		color: inherit;
		text-decoration: none;
	}

	.contact-list a:hover > .contact-label,
	.contact-list a:hover strong {
		transform: translateX(0.55rem);
	}

	.contact-list a:focus-visible > .contact-label,
	.contact-list a:focus-visible strong {
		transform: translateX(0.55rem);
	}

	.contact-list a:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 0.35rem;
	}

	.contact-label,
	.contact-list strong {
		font-size: clamp(1.02rem, 1.1vw, 1.2rem);
		line-height: 1.55;
		transition: transform 180ms ease;
	}

	.contact-label {
		font-weight: 650;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.contact-list strong {
		min-width: 0;
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.maps-link__value {
		display: grid;
		align-items: center;
	}

	.maps-link__address,
	.maps-link__action {
		grid-area: 1 / 1;
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.maps-link__action {
		opacity: 0;
		transform: translateY(0.45rem);
	}

	.maps-link:is(:hover, :focus-visible) .maps-link__address {
		opacity: 0;
		transform: translateY(-0.45rem);
	}

	.maps-link:is(:hover, :focus-visible) .maps-link__action {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 840px) {
		.story--contact {
			padding-bottom: clamp(8rem, 29vw, 11rem);
		}

		.contact-list a {
			grid-template-columns: 5.2rem minmax(0, 1fr);
			gap: 1rem;
		}

		.contact-label,
		.contact-list strong {
			font-size: clamp(1.02rem, 4.35vw, 1.15rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-label,
		.contact-list strong,
		.maps-link__address,
		.maps-link__action {
			transition: none;
		}

		.contact-label,
		.contact-list strong {
			transform: none;
		}
	}
</style>
