---
import { Image } from 'astro:assets';
import type { Locale } from '../config/i18n';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import bodyPortrait from '../assets/oldtimer/L1005486.webp';
import bodyLandscape from '../assets/oldtimer/L1005735.webp';
import paintPortrait from '../assets/oldtimer/L1005678.webp';
import paintLandscape from '../assets/oldtimer/L1005705.webp';
import upholsteryPortrait from '../assets/oldtimer/L1005816.webp';
import upholsteryLandscape from '../assets/oldtimer/L1005861.webp';
import enginePortrait from '../assets/oldtimer/handwerk-motorbau-portrait.webp';
import engineLandscape from '../assets/oldtimer/handwerk-motorbau-landscape.webp';

interface Props {
	locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const copy = {
	de: {
		title: 'Handwerk',
		heading: 'Handwerk',
		manifesto: 'Alles aus einer Hand',
		description: 'Karosserie, Polsterei, Lackiererei und Motorbau: die Handwerksbereiche der Oldtimermanufaktur für historische Automobile.',
		sections: [
			{ id: 'karosserie', label: 'Karosserie' },
			{ id: 'polsterei', label: 'Polsterei' },
			{ id: 'lackiererei', label: 'Lackiererei' },
			{ id: 'motorbau', label: 'Motorbau' },
		],
		body: 'Jede Linie beginnt mit einem genauen Blick auf die vorhandene Substanz. Bleche werden geformt, angepasst und so zusammengefügt, dass Proportionen, Übergänge und Spaltmaße wieder ein stimmiges Ganzes ergeben.',
		upholstery: 'Material, Haptik und Verarbeitung prägen den Charakter eines Innenraums. Vom Zuschnitt bis zur letzten Naht entstehen Bezüge und Polster, die sich selbstverständlich in das historische Fahrzeug einfügen.',
		paint: 'Ein überzeugendes Finish entsteht lange vor dem ersten Farbauftrag. Sorgfältiger Schichtaufbau, ruhige Flächen und ein fein abgestimmter Farbton geben der Karosserie Tiefe, ohne ihre Form zu überdecken.',
		engine: 'Im Motorbau zählt das Zusammenspiel vieler kleiner Entscheidungen. Komponenten werden geprüft, bearbeitet und präzise aufeinander abgestimmt, bis aus einzelnen Teilen wieder eine verlässliche mechanische Einheit wird.',
	},
	en: {
		title: 'Craft',
		heading: 'Craft',
		manifesto: 'Everything from a single source',
		description: 'Bodywork, upholstery, paintwork and engine building: the Oldtimermanufaktur crafts behind the restoration of historic automobiles.',
		sections: [
			{ id: 'karosserie', label: 'Bodywork' },
			{ id: 'polsterei', label: 'Upholstery' },
			{ id: 'lackiererei', label: 'Paintwork' },
			{ id: 'motorbau', label: 'Engine building' },
		],
		body: 'Every line begins with a close assessment of the existing fabric. Metal panels are shaped, fitted and joined until the proportions, transitions and panel gaps once again form a coherent whole.',
		upholstery: 'Materials, texture and workmanship define the character of an interior. From the first cut to the final seam, covers and upholstery are made to feel entirely at home in the historic vehicle.',
		paint: 'A convincing finish begins long before the first coat of colour. Careful preparation, calm surfaces and a precisely matched shade give the body depth without overpowering its form.',
		engine: 'Engine building depends on the interaction of many small decisions. Components are inspected, machined and precisely matched until the individual parts once again become a dependable mechanical unit.',
	},
}[locale];

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site ?? Astro.url;
const siteRootUrl = new URL(basePath, siteUrl);
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const serviceId = `${pageUrl.href}#service`;
const organizationId = `${siteRootUrl.href}#organization`;
const handwerkServiceJsonLd = {
	'@type': 'Service',
	'@id': serviceId,
	name: `${copy.heading} – ${copy.manifesto}`,
	serviceType: locale === 'de' ? 'Restaurierung historischer Automobile' : 'Historic automobile restoration',
	description: copy.description,
	url: pageUrl.href,
	provider: { '@id': organizationId },
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: locale === 'de' ? 'Handwerksbereiche' : 'Craft disciplines',
		itemListElement: copy.sections.map((section) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: section.label,
				url: `${pageUrl.href}#${section.id}`,
			},
		})),
	},
};
---

<EditorialPageLayout
	title={copy.title}
	heading={copy.heading}
	description={copy.description}
	sections={copy.sections}
	theme="dark"
	background="linear-gradient(180deg, #111111 0%, #111111 17%, #302b27 22%, #4b453f 28%, #57514b 34%, #524d49 41%, #47464a 48%, #363d47 55%, #263747 62%, #162d43 68%, #0c304c 74%, #083553 78%, #10283b 86%, #111111 100%)"
	openGraphImage={bodyPortrait}
	openGraphImageAlt={locale === 'de' ? 'Ein Karosseriebauer arbeitet konzentriert an der Form eines historischen Fahrzeugs' : 'A bodywork specialist shapes a historic vehicle by hand'}
	structuredDataType="CollectionPage"
	dateModified="2026-08-10"
	additionalJsonLd={handwerkServiceJsonLd}
	{locale}
>
	<div slot="intro" class="craft-manifesto">
		<p>{copy.manifesto}</p>
		<ul aria-label={locale === 'de' ? 'Handwerksbereiche' : 'Craft disciplines'}>
			{copy.sections.map((section) => <li>{section.label}</li>)}
		</ul>
	</div>
	<section
		slot="opening"
		class="story story--images-right"
		aria-labelledby="karosserie-title"
		data-parallax-group
	>
		<h2 id="karosserie-title">{copy.sections[0].label}</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--right" aria-label={locale === 'de' ? 'Arbeiten in der Karosserieabteilung' : 'Work in the bodywork department'}>
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.12"
					data-range="132"
				>
					<Image
						src={bodyPortrait}
						alt={locale === 'de' ? 'Ein Karosseriebauer bearbeitet ein Metallteil von Hand' : 'A bodywork specialist shapes a metal component by hand'}
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="eager"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.21"
					data-range="196"
				>
					<Image
						src={bodyLandscape}
						alt={locale === 'de' ? 'Historische Fahrzeuge und Karosserieteile in der Werkstatt' : 'Historic vehicles and body panels in the workshop'}
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>{copy.body}</p>
			</div>
		</div>
	</section>

	<section
		id="polsterei"
		class="story story--images-left"
		aria-labelledby="polsterei-title"
		data-parallax-group
	>
		<h2 id="polsterei-title">{copy.sections[1].label}</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--left" aria-label={locale === 'de' ? 'Arbeiten in der Polsterei' : 'Work in the upholstery department'}>
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.126"
					data-range="138"
				>
					<Image
						src={upholsteryPortrait}
						alt={locale === 'de' ? 'Ein Polsterer führt Leder an einer Nähmaschine' : 'An upholsterer guides leather through a sewing machine'}
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.218"
					data-range="202"
				>
					<Image
						src={upholsteryLandscape}
						alt={locale === 'de' ? 'Werkzeuge, Schnittmuster und Leder auf dem Arbeitstisch einer Polsterei' : 'Tools, patterns and leather on an upholstery workbench'}
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>{copy.upholstery}</p>
			</div>
		</div>
	</section>

	<section
		id="lackiererei"
		class="story story--images-right"
		aria-labelledby="lackiererei-title"
		data-parallax-group
	>
		<h2 id="lackiererei-title">{copy.sections[2].label}</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--right" aria-label={locale === 'de' ? 'Arbeiten in der Lackiererei' : 'Work in the paint department'}>
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.122"
					data-range="134"
				>
					<Image
						src={paintPortrait}
						alt={locale === 'de' ? 'Ein Lackierer trägt Schutzkleidung beim Lackieren eines Karosserieteils' : 'A painter in protective clothing paints a body panel'}
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.224"
					data-range="206"
				>
					<Image
						src={paintLandscape}
						alt={locale === 'de' ? 'Lackierarbeiten an einer dunklen Karosserie in der Spritzkabine' : 'Paintwork on a dark body in the spray booth'}
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>{copy.paint}</p>
			</div>
		</div>
	</section>

	<section
		id="motorbau"
		class="story story--images-left"
		aria-labelledby="motorbau-title"
		data-parallax-group
	>
		<h2 id="motorbau-title">{copy.sections[3].label}</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--left" aria-label={locale === 'de' ? 'Platzhaltermotive für den Motorbau' : 'Placeholder imagery for engine building'}>
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.124"
					data-range="136"
				>
					<Image
						src={enginePortrait}
						alt={locale === 'de' ? 'KI-generierter Platzhalter: Hände ziehen Bauteile an einem klassischen Motor mit einem Drehmomentschlüssel an' : 'AI-generated placeholder: hands tighten components on a classic engine with a torque wrench'}
						widths={[560, 760, 1024]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.22"
					data-range="204"
				>
					<Image
						src={engineLandscape}
						alt={locale === 'de' ? 'KI-generierter Platzhalter: Ein überholter klassischer Reihensechszylinder auf einem Motorständer' : 'AI-generated placeholder: a rebuilt classic straight-six engine on a stand'}
						widths={[640, 960, 1280, 1536]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>{copy.engine}</p>
			</div>
		</div>
	</section>
</EditorialPageLayout>

<style is:global>
	.craft-manifesto {
		display: grid;
		gap: clamp(1.25rem, 2.4vw, 2rem);
		justify-items: center;
		width: min(100%, 74rem);
		margin-top: clamp(2.5rem, 4vw, 4rem);
		text-align: center;
	}

	.editorial-intro .craft-manifesto > p {
		margin: 0;
		font-size: clamp(2rem, 4.1vw, 4.75rem);
		font-weight: 520;
		letter-spacing: 0.07em;
		line-height: 0.98;
		text-transform: uppercase;
		text-wrap: balance;
	}

	.craft-manifesto ul {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.craft-manifesto li {
		position: relative;
		font-size: var(--text-utility);
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.craft-manifesto li + li::before {
		position: absolute;
		top: 50%;
		left: -0.82rem;
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		content: '';
		opacity: 0.5;
	}

	@media (max-width: 600px) {
		.editorial-intro .craft-manifesto > p {
			font-size: clamp(1.8rem, 9vw, 2.8rem);
		}

		.craft-manifesto ul {
			gap: 0.55rem 1rem;
		}

		.craft-manifesto li + li::before {
			left: -0.58rem;
		}
	}
</style>
