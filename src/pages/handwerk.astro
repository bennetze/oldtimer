---
import { Image } from 'astro:assets';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import mechanicsPortrait from '../assets/oldtimer/motor-klassik/hochformat/MKL_PORTRAIT_KFZ_MEISTER_ANTON_SCHRANK_AB-6144.webp';
import mechanicsLandscape from '../assets/oldtimer/motor-klassik/querformat/MKL_PORTRAIT_KFZ_MEISTER_ANTON_SCHRANK_AB-6297.webp';
import bodyPortrait from '../assets/oldtimer/motor-klassik/querformat/MKL_PORTRAIT_KFZ_MEISTER_ANTON_SCHRANK_AB-5800.webp';
import bodyLandscape from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00081.webp';
import bodyDetail from '../assets/oldtimer/oldtimermanufaktur-verzinnen/L1006963.webp';
import paintPortrait from '../assets/oldtimer/L1005705.webp';
import paintLandscape from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00378.webp';
import upholsteryPortrait from '../assets/oldtimer/L1005816.webp';
import upholsteryLandscape from '../assets/oldtimer/L1005861.webp';
import enginePortrait from '../assets/oldtimer/horch-350/engine-valvetrain.webp';
import upholsteryDetail from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00189.webp';
import paintDetail from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00572.webp';
import mechanicsDetail from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00155.webp';
import engineDetail from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00164.webp';
import upholsterySample from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00186.webp';
import EditorialMotion from '../components/EditorialMotion.astro';
import motorbauMp4 from '../assets/oldtimer/motorbau.mp4';
import motorbauMobileMp4 from '../assets/oldtimer/motorbau-mobile.mp4';
import motorbauWebm from '../assets/oldtimer/motorbau.webm';
import motorbauPoster from '../assets/oldtimer/motorbau-poster.jpg';
import motorbauMotionAvif from '../assets/oldtimer/motorbau-motion.avif?url';
import motorbauMotionWebp from '../assets/oldtimer/motorbau-motion.webp?url';

const sectionNavigationItems = [
	{ id: 'karosserie', label: 'Karosseriebau/Stellmacherei' },
	{ id: 'mechanik', label: 'Mechanik - technische Instandsetzungen' },
	{ id: 'motorbau', label: 'Motorenbau' },
	{ id: 'lackiererei', label: 'Lackiererei' },
	{ id: 'polsterei', label: 'Polsterei/Sattlerei' },
	{ id: 'leistungen', label: 'Leistungen' },
];

const services = [
	"Voll- und Teilrestaurierungen in allen Gewerken und Fahrzeugklassen",
	"eigener Karosseriebau mit Stellmacherei",
	"eigene Lackiererei",
	"sämtliche technischen Instandsetzungen",
	"eigener Motorenbau und Motorrevisionen",
	"eigene Autosattlerei",
	"eigene Feinmechanikabteilung (Drehen, Fräsen, Schleifen, Polieren...)",
	"eigener Formenbau und Prototypenbau",
	"detailgetreue Teileneufertigung",
	"perfekte Galvanikarbeiten (Chrom, Nickel, Zink, Kupfer, Messing, Gold)",
	"Fahrzeugüberführungen im eigenen geschlossenen Spezialtrailer",
	"Fahrzeuggutachten (Wertgutachten, Schadensgutachten, H-Gutachten, TÜV-, DEKRA- Vollabnahmen und Sonderabnahmen im eigenen Haus)",
	"sichere Fahrzeugeinlagerung / Oldtimerpension",
	"Oldtimerfahrten / Hochzeitsfahrten",
];

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site ?? Astro.url;
const siteRootUrl = new URL(basePath, siteUrl);
const pageUrl = new URL(`${basePath}handwerk/`, siteUrl);
const serviceId = `${pageUrl.href}#service`;
const organizationId = `${siteRootUrl.href}#organization`;
const handwerkServiceJsonLd = {
	'@type': 'Service',
	'@id': serviceId,
	name: 'Handwerk - Alles aus einer Hand',
	serviceType: 'Restaurierung historischer Automobile',
	description:
		'Voll- und Teilrestaurierungen, Karosseriebau, Mechanik, Motorenbau, Lackiererei und Sattlerei sowie Teileneufertigung, Fahrzeugüberführungen, Gutachten, sichere Einlagerung und Oldtimer- und Hochzeitsfahrten.',
	url: pageUrl.href,
	provider: { '@id': organizationId },
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Leistungen',
		itemListElement: services.map((service) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: service,
				url: `${pageUrl.href}#leistungen`,
			},
		})),
	},
};
---

<EditorialPageLayout
	title="Handwerk - Alles aus einer Hand"
	heading="Handwerk - Alles aus einer Hand"
	headingMaxWidth="26ch"
	description="Voll- und Teilrestaurierungen, Karosseriebau, Mechanik, Motorenbau, Lackiererei und Sattlerei sowie Teileneufertigung, Fahrzeugüberführungen, Gutachten, sichere Einlagerung und Oldtimer- und Hochzeitsfahrten."
	sections={sectionNavigationItems}
	theme="light"
	background="var(--gradient-green)"
	openGraphImage={bodyPortrait}
	openGraphImageAlt="Ein Mitarbeiter mit Schweißhelm schweißt an der Karosserie eines gelben historischen Automobils."
	structuredDataType="CollectionPage"
	dateModified="2026-10-27"
	additionalJsonLd={handwerkServiceJsonLd}
>
	<section
		slot="opening"
		class="story story--images-right"
		aria-labelledby="karosserie-title"
		data-parallax-group
	>
		<h2 id="karosserie-title">Karosseriebau/Stellmacherei</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--body-details collage--right collage--body-selection" role="group" aria-label="Arbeiten in der Karosserieabteilung">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.12"
					data-range="132"
				>
					<Image
						src={bodyPortrait}
						alt="Ein Mitarbeiter mit Schweißhelm schweißt an der Karosserie eines gelben historischen Automobils."
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="eager"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.21"
					data-range="196"
				>
					<Image
						src={bodyLandscape}
						alt="Eine historische Karosserie mit freigelegtem Holzgerippe und angepassten Blechteilen auf einem Werkstattgestell."
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--detail"
					data-parallax-layer
					data-speed="0.28"
					data-range="170"
				>
					<Image
						src={bodyDetail}
						alt="Brenner und Metallstab bei der Bearbeitung einer blanken Karosseriekante."
						widths={[480, 760, 1024]}
						sizes="(max-width: 840px) 55vw, 30vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>Originalgetreue Anfertigungen vom Blechteil bis zur kompletten Karosserie.</p>
				<p>In unserer hauseigenen und bestens ausgestatteten Karosseriebauwerkstatt beseitigen wir mit sehr erfahrenen Mitarbeitern und deren langjährigem Knowhow selbst hoffnungslos geglaubte Karosserieschäden. Dafür stehen uns alle gängigen Schweißtechniken sowie sämtliche speziellen Formgebungsmaschinen und -werkzeuge zur Verfügung. Blechteile in Stahl, Aluminium, Edelstahl und Messing werden hier entsprechend instandgesetzt, neu angefertigt, angepasst und so zusammengefügt, dass Proportionen, Konturen, Übergänge und Spaltmaße wieder ein stimmiges Ganzes ergeben.</p>
				<p>Auch die notwendigen Holzarbeiten für stabile Karosseriestrukturen früherer Jahrzehnte, als auch edle Furnierarbeiten entstehen in unserer Stellmacherei neu bzw. werden entsprechend originalgetreu restauriert und rekonstruiert.</p>
			</div>
		</div>
	</section>

	<section
		id="mechanik"
		class="story story--images-left"
		aria-labelledby="mechanik-title"
		data-parallax-group
	>
		<h2 id="mechanik-title">Mechanik - technische Instandsetzungen</h2>
		<div class="story__layout">
			<div class="collage collage--mechanics collage--left collage--layered" role="group" aria-label="Arbeiten in der mechanischen Abteilung">
				<figure class="image-layer image-layer--portrait" data-parallax-layer data-speed="0.126" data-range="138">
					<Image src={mechanicsPortrait} alt="Anton Schrank arbeitet unter einem auf der Hebebühne angehobenen Fahrzeug." widths={[560, 760, 1024, 1280]} sizes="(max-width: 840px) 88vw, 48vw" format="webp" loading="lazy" />
				</figure>
				<figure class="image-layer image-layer--landscape" data-parallax-layer data-speed="0.218" data-range="202">
					<Image src={mechanicsLandscape} alt="Anton Schrank und ein Kollege arbeiten gemeinsam am geöffneten Motorraum eines historischen Automobils." widths={[640, 960, 1280, 1600]} sizes="(max-width: 840px) 76vw, 42vw" format="webp" loading="lazy" />
				</figure>
				<figure class="image-layer image-layer--detail" data-parallax-layer data-speed="0.18" data-range="100">
					<Image src={mechanicsDetail} alt="Ein Mitarbeiter prüft ein geöffnetes Getriebe auf einer Werkbank." widths={[480, 760, 1024, 1280]} sizes="(max-width: 840px) 80vw, 36vw" format="webp" loading="lazy" />
				</figure>
			</div>
			<div class="story__copy">
				<p>In unserer mechanischen Abteilung finden sämtliche technischen Instandsetzungen statt. Achsen-, Bremsen, Lenkungs-, Getriebeüberholungen, aber auch Instandsetzungen an der Fahrzeugelektrik bis hin zur Neuanfertigung ganzer Kabelbäume.</p>
			</div>
		</div>
	</section>

	<section
		id="motorbau"
		class="story story--images-left story--engines"
		aria-labelledby="motorbau-title"
		data-parallax-group
	>
		<h2 id="motorbau-title">Motorenbau</h2>
		<div class="story__layout">
			<div class="collage engine-feature" role="group" aria-label="Motorenbau im Film">
				<figure
					class="image-layer image-layer--video"
					data-parallax-layer
					data-speed="0.12"
					data-range="48"
				>
					<EditorialMotion
						mp4={motorbauMp4}
						mobileMp4={motorbauMobileMp4}
						webm={motorbauWebm}
						poster={motorbauPoster}
						avif={motorbauMotionAvif}
						webp={motorbauMotionWebp}
						alt="Nahaufnahme des Ventiltriebs eines laufenden historischen Motors."
						sizes="(max-width: 840px) 90vw, (max-width: 1236px) 88vw, 1088px"
					/>
				</figure>
			</div>
			<div class="collage collage--double collage--left collage--engines" role="group" aria-label="Arbeiten im Motorenbau">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.124"
					data-range="136"
				>
					<Image
						src={enginePortrait}
						alt="Freigelegter Ventiltrieb des Horch 350 von 1928 während der Motorrestaurierung."
						widths={[180, 270]}
						sizes="(max-width: 840px) min(65vw, 270px), 270px"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure class="image-layer image-layer--detail" data-parallax-layer data-speed="0.18" data-range="100">
					<Image src={engineDetail} alt="Vergaser, Leitungen und Ventildeckel im geöffneten Motorraum eines historischen Automobils." widths={[480, 760, 1024, 1280]} sizes="(max-width: 840px) 80vw, 36vw" format="webp" loading="lazy" />
				</figure>
			</div>

			<div class="story__copy">
				<p>Hier werden Instandsetzungen an Motoren sowie Zünd- und Kraftstoffanlagen vorgenommen. Auch der Neuaufbau ganzer Motoren findet hier statt. Dafür erforderlich ist natürlich ein moderner Maschinenpark für sämtliche Bohr-, Dreh-, Fräs- und Spindelarbeiten.</p>
			</div>
		</div>
	</section>

	<section
		id="lackiererei"
		class="story story--images-left"
		aria-labelledby="lackiererei-title"
		data-parallax-group
	>
		<h2 id="lackiererei-title">Lackiererei</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--craft-details collage--left collage--paint-selection" role="group" aria-label="Arbeiten in der Lackiererei">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.122"
					data-range="134"
				>
					<Image
						src={paintPortrait}
						alt="Ein Lackierer mit Atemschutz spritzt dunkle Karosserieteile in einer Lackierkabine."
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.224"
					data-range="206"
				>
					<Image
						src={paintLandscape}
						alt="Eine Hand mit weißem Handschuh prüft die glänzende dunkelblaue Lackoberfläche einer Karosserie."
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure class="image-layer image-layer--detail" data-parallax-layer data-speed="0.28" data-range="170">
					<Image src={paintDetail} alt="Dunkelblauer Lack wird in einem transparenten Messbecher verrührt." widths={[480, 760, 1024]} sizes="(max-width: 840px) 56vw, 30vw" format="webp" loading="lazy" />
				</figure>
			</div>

			<div class="story__copy">
				<p>Hier kommt Farbe ins Spiel.</p>
				<p>Ein überzeugendes Finish entsteht lange vor dem ersten Farbauftrag. Sorgfältiger Schichtaufbau, ruhige Flächen und ein fein abgestimmter Farbton geben der Oberfläche die nötige Tiefe und Brillanz.</p>
				<p>Um die Authentizität einer Farbgebung zu gewährleisten, verfügen wir über wichtige historische Mischformeln und originale Farbmusterkarten vergangener Jahrzehnte. Dank einer eigenen Farb-Mischanlage und hochmodernen Lackieranlage, gepaart mit der langjährigen Erfahrung unserer Mitarbeiter, gewährleisten wir perfekte Lackierarbeiten und brillante Oberflächen.</p>
				<p>Zudem führen wir kunstvolle Linierungen aus, auch Nitro- und Lasurtechniken gehören zu unserem umfassenden Repertoire.</p>
			</div>
		</div>
	</section>

	<section
		id="polsterei"
		class="story story--images-left"
		aria-labelledby="polsterei-title"
		data-parallax-group
	>
		<h2 id="polsterei-title">Polsterei/Sattlerei</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--craft-details collage--left collage--upholstery" role="group" aria-label="Arbeiten in der Polsterei">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.126"
					data-range="138"
				>
					<Image
						src={upholsteryPortrait}
						alt="Ein Polsterer führt helles Material unter der Nadel einer Nähmaschine."
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.218"
					data-range="202"
				>
					<Image
						src={upholsteryLandscape}
						alt="Maßband, Scheren und markierte Schnittmuster auf einer Werkbank in der Polsterei."
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure class="image-layer image-layer--detail" data-parallax-layer data-speed="0.28" data-range="170">
					<Image src={upholsteryDetail} alt="Rote, senkrecht gesteppte Polster im Innenraum eines historischen Fahrzeugs." widths={[480, 760, 1024]} sizes="(max-width: 840px) 56vw, 30vw" format="webp" loading="lazy" />
				</figure>
				<figure class="image-layer image-layer--sample" data-parallax-layer data-speed="0.18" data-range="100">
					<Image src={upholsterySample} alt="Türkises Leder mit Aston-Martin-Schriftzug, Ziernähten und Stoffmustern in der Sattlerei." widths={[480, 760, 1024, 1280]} sizes="(max-width: 840px) 80vw, 36vw" format="webp" loading="lazy" />
				</figure>
			</div>

			<div class="story__copy">
				<p>Die Wahl der Materialien, die unvergleichliche Haptik und die fachgerechte Verarbeitung prägen den Charakter und die stimmige Ästhetik eines Innenraums.</p>
				<p>Von der behutsamen Aufarbeitung und Restaurierung wertvoller patinierter Original-Innenausstattungen bis hin zur originalgetreuen Neuanfertigung ganzer Innenräume, entstehen in unserer Sattlerei sämtliche Aufarbeitungen und Polsterungen in historisch korrekten Stoffen, feinstem Leder und edlen Teppichen in Originalqualität und fachgerechter Verarbeitung. Auch originalgetreue Cabrioverdecke teils mit echter Rosshaarfütterung wie sie in Fahrzeugen der Frühzeit verarbeitet wurden, werden mit absoluter Präzision neu angefertigt.</p>
				<p>Auf Wunsch verfeinern Stick- Gravur- und Laserarbeiten diese Oberflächen mit einmaligen Applikationen.</p>
			</div>
		</div>
	</section>
	<section
		id="leistungen"
		class="story story--services"
		aria-labelledby="leistungen-title"
		data-parallax-group
	>
		<div class="services-content">
			<h2 id="leistungen-title">Leistungen</h2>
			<ul class="services-list" role="list">
				{services.map((service) => <li><span>{service}</span></li>)}
			</ul>
		</div>
	</section>
</EditorialPageLayout>

<style>
	:global(.editorial-page) .collage--mechanics { min-height: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
	:global(.editorial-page) .collage--mechanics .image-layer { position: relative; inset: auto; width: 100%; height: auto; }
	:global(.editorial-page) .collage--mechanics .image-layer:nth-child(1) { grid-column: 1 / 9; grid-row: 1; z-index: 1; }
	:global(.editorial-page) .collage--mechanics .image-layer:nth-child(2) { grid-column: 7 / -1; grid-row: 1; align-self: end; margin-bottom: -12%; z-index: 2; }
	:global(.editorial-page) .collage--mechanics img { display: block; height: auto; }

	:global(.editorial-page) .story--services {
		padding-top: 3rem;
		padding-bottom: clamp(6rem, 12vw, 12rem);
		text-align: center;
	}
	.services-content {
		width: min(100%, 76rem);
		margin-inline: auto;
	}
	:global(.editorial-page) .story--services h2 {
		margin-bottom: clamp(3rem, 5vw, 5rem);
	}
	.services-list {
		display: grid;
		gap: clamp(1.5rem, 2.4vw, 2.25rem);
		justify-items: center;
		width: fit-content;
		max-width: min(100%, 60rem);
		margin: 0 auto;
		padding: 0;
		list-style: none;
		font-size: clamp(1.25rem, 1.7vw, 1.625rem);
		font-weight: 400;
		line-height: 1.75;
		text-align: center;
		text-wrap: balance;
		letter-spacing: 0.008em;
	}
	.services-list li {
		max-width: 100%;
	}
	.services-list li span::before {
		content: '•\00a0';
		margin-inline-end: 0.4em;
	}
	@media (max-width: 840px) {
		:global(.editorial-page) .story--services h2 {
			margin-bottom: 4rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.services-list { transform: none; }
	}

	:global(.editorial-page) .collage--body-details .image-layer--detail {
		right: 0;
		bottom: 0;
		z-index: 3;
		width: 48%;
		height: 34%;
	}
	:global(.editorial-page) .collage--body-details .image-layer--detail img {
		height: 100%;
	}
	:global(.editorial-page) .collage--craft-details .image-layer--portrait {
		width: 76%;
		height: 78%;
	}
	:global(.editorial-page) .collage--craft-details .image-layer--landscape {
		bottom: 14%;
		width: 64%;
		height: 38%;
	}
	:global(.editorial-page) .collage--craft-details .image-layer--detail {
		left: 0;
		bottom: 0;
		z-index: 3;
		width: 56%;
		height: auto;
	}
	:global(.editorial-page) .image-layer--detail img {
		display: block;
		height: auto;
	}
	:global(.editorial-page) .story--engines .story__layout {
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: clamp(2rem, 4vw, 4rem);
	}
	:global(.editorial-page) .story--engines .engine-feature {
		grid-column: 1 / -1;
		grid-row: 1;
		width: min(100%, 68rem);
		min-height: 0;
		justify-self: center;
		padding-block: clamp(1rem, 2vw, 2rem);
	}
	:global(.editorial-page) .engine-feature .image-layer {
		position: relative;
		inset: auto;
		width: 100%;
		height: auto;
	}
	:global(.editorial-page) .story--engines .collage--engines {
		grid-row: 2;
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(1rem, 2vw, 2rem);
		align-items: center;
		min-height: 0;
	}
	:global(.editorial-page) .story--engines .story__copy { grid-row: 2; }
	:global(.editorial-page) .collage--engines .image-layer { position: relative; inset: auto; width: 100%; height: auto; }
	:global(.editorial-page) .collage--engines .image-layer--portrait { width: min(100%, 270px); justify-self: center; }
	:global(.editorial-page) .collage--engines img { display: block; height: auto; }
	@media (max-width: 840px) {
		:global(.editorial-page) .collage--body-details .image-layer--detail {
			width: 55%;
