---
import { Image } from 'astro:assets';
import EditorialPageLayout from '../layouts/EditorialPageLayout.astro';
import bodyPortrait from '../assets/oldtimer/L1005486.webp';
import bodyLandscape from '../assets/oldtimer/L1005735.webp';
import bodyDetail from '../assets/oldtimer/oldtimermanufaktur-verzinnen/L1006963.webp';
import paintPortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00878.webp';
import paintLandscape from '../assets/oldtimer/L1005705.webp';
import upholsteryPortrait from '../assets/oldtimer/L1005816.webp';
import upholsteryLandscape from '../assets/oldtimer/L1005861.webp';
import enginePortrait from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00172.webp';
import upholsteryDetail from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00189.webp';
import paintDetail from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00572.webp';
import engineLandscape from '../assets/oldtimer/oldtimermanufaktur-fotos-2/DSC00171.webp';

const sectionNavigationItems = [
	{ id: 'karosserie', label: 'Karosserie' },
	{ id: 'polsterei', label: 'Polsterei' },
	{ id: 'lackiererei', label: 'Lackiererei' },
	{ id: 'motorbau', label: 'Motorbau' },
];

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const siteUrl = Astro.site ?? Astro.url;
const siteRootUrl = new URL(basePath, siteUrl);
const pageUrl = new URL(`${basePath}handwerk/`, siteUrl);
const serviceId = `${pageUrl.href}#service`;
const organizationId = `${siteRootUrl.href}#organization`;
const handwerkServiceJsonLd = {
	'@type': 'Service',
	'@id': serviceId,
	name: 'Handwerk – Alles aus einer Hand',
	serviceType: 'Restaurierung historischer Automobile',
	description:
		'Karosserie, Polsterei, Lackiererei und Motorbau für die Restaurierung historischer Automobile.',
	url: pageUrl.href,
	provider: { '@id': organizationId },
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Handwerksbereiche',
		itemListElement: sectionNavigationItems.map((section) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: section.label,
				url: `${pageUrl.href}#${section.id}`,
			},
		})),
	},
};
---

<EditorialPageLayout
	title="Handwerk"
	heading="Handwerk - Alles aus einer Hand"
	description="Karosserie, Polsterei, Lackiererei und Motorbau: die Handwerksbereiche der Oldtimermanufaktur für historische Automobile."
	sections={sectionNavigationItems}
	theme="light"
	background="linear-gradient(180deg, #ffffff 0%, #ffffff 11%, #f7eee2 18%, #f8f3ec 30%, #e9dacf 39%, #b1b6d5 47%, #8faede 54%, #80a3d1 61%, #8bb0e1 70%, #a6c6ec 82%, #ffffff 100%)"
	openGraphImage={bodyPortrait}
	openGraphImageAlt="Ein Karosseriebauer arbeitet konzentriert an der Form eines historischen Fahrzeugs"
	structuredDataType="CollectionPage"
	dateModified="2026-09-29"
	additionalJsonLd={handwerkServiceJsonLd}
>
	<section
		slot="opening"
		class="story story--images-right"
		aria-labelledby="karosserie-title"
		data-parallax-group
	>
		<h2 id="karosserie-title">Karosserie</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--body-details collage--right" aria-label="Arbeiten in der Karosserieabteilung">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.12"
					data-range="132"
				>
					<Image
						src={bodyPortrait}
						alt="Ein Karosseriebauer bearbeitet ein Metallteil von Hand"
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="eager"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.21"
					data-range="196"
				>
					<Image
						src={bodyLandscape}
						alt="Historische Fahrzeuge und Karosserieteile in der Werkstatt"
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--detail"
					data-parallax-layer
					data-speed="0.28"
					data-range="170"
				>
					<Image
						src={bodyDetail}
						alt="Nahaufnahme beim Verzinnen einer Karosseriekante"
						widths={[480, 760, 1024]}
						sizes="(max-width: 840px) 55vw, 30vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>
					Jede Linie beginnt mit einem genauen Blick auf die vorhandene Substanz. Bleche werden
					geformt, angepasst und so zusammengefügt, dass Proportionen, Übergänge und Spaltmaße
					wieder ein stimmiges Ganzes ergeben.
				</p>
			</div>
		</div>
	</section>

	<section
		id="polsterei"
		class="story story--images-left"
		aria-labelledby="polsterei-title"
		data-parallax-group
	>
		<h2 id="polsterei-title">Polsterei</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--craft-details collage--left" aria-label="Arbeiten in der Polsterei">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.126"
					data-range="138"
				>
					<Image
						src={upholsteryPortrait}
						alt="Ein Polsterer führt Leder an einer Nähmaschine"
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.218"
					data-range="202"
				>
					<Image
						src={upholsteryLandscape}
						alt="Werkzeuge, Schnittmuster und Leder auf dem Arbeitstisch einer Polsterei"
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure class="image-layer image-layer--detail" data-parallax-layer data-speed="0.28" data-range="170">
					<Image src={upholsteryDetail} alt="Rote Lederpolster und Türverkleidung im Innenraum eines historischen Fahrzeugs" widths={[480, 760, 1024]} sizes="(max-width: 840px) 56vw, 30vw" format="webp" loading="lazy" />
				</figure>
			</div>

			<div class="story__copy">
				<p>
					Material, Haptik und Verarbeitung prägen den Charakter eines Innenraums. Vom Zuschnitt
					bis zur letzten Naht entstehen Bezüge und Polster, die sich selbstverständlich in das
					historische Fahrzeug einfügen.
				</p>
			</div>
		</div>
	</section>

	<section
		id="lackiererei"
		class="story story--images-left"
		aria-labelledby="lackiererei-title"
		data-parallax-group
	>
		<h2 id="lackiererei-title">Lackiererei</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--craft-details collage--left" aria-label="Arbeiten in der Lackiererei">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.122"
					data-range="134"
				>
					<Image
						src={paintPortrait}
						alt="Prüfung der roten Lackoberfläche eines historischen Fahrzeugs"
						widths={[560, 760, 1024, 1280]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.224"
					data-range="206"
				>
					<Image
						src={paintLandscape}
						alt="Lackierarbeiten an einer dunklen Karosserie in der Spritzkabine"
						widths={[640, 960, 1280, 1600]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure class="image-layer image-layer--detail" data-parallax-layer data-speed="0.28" data-range="170">
					<Image src={paintDetail} alt="Dunkelblauer Lack in einem Mischbecher" widths={[480, 760, 1024]} sizes="(max-width: 840px) 56vw, 30vw" format="webp" loading="lazy" />
				</figure>
			</div>

			<div class="story__copy">
				<p>
					Ein überzeugendes Finish entsteht lange vor dem ersten Farbauftrag. Sorgfältiger
					Schichtaufbau, ruhige Flächen und ein fein abgestimmter Farbton geben der Karosserie
					Tiefe, ohne ihre Form zu überdecken.
				</p>
			</div>
		</div>
	</section>

	<section
		id="motorbau"
		class="story story--images-left"
		aria-labelledby="motorbau-title"
		data-parallax-group
	>
		<h2 id="motorbau-title">Motorbau</h2>
		<div class="story__layout">
			<div class="collage collage--double collage--left collage--engines" aria-label="Arbeiten im Motorbau">
				<figure
					class="image-layer image-layer--portrait"
					data-parallax-layer
					data-speed="0.124"
					data-range="136"
				>
					<Image
						src={enginePortrait}
						alt="Vergaser und Gestänge eines klassischen Motors in der Werkstatt"
						widths={[560, 760, 1024]}
						sizes="(max-width: 840px) 88vw, 48vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
				<figure
					class="image-layer image-layer--landscape"
					data-parallax-layer
					data-speed="0.22"
					data-range="204"
				>
					<Image
						src={engineLandscape}
						alt="Detailansicht der Vergaseranlage eines klassischen Motors"
						widths={[640, 960, 1280, 1536]}
						sizes="(max-width: 840px) 76vw, 42vw"
						format="webp"
						loading="lazy"
					/>
				</figure>
			</div>

			<div class="story__copy">
				<p>
					Im Motorbau zählt das Zusammenspiel vieler kleiner Entscheidungen. Komponenten werden
					geprüft, bearbeitet und präzise aufeinander abgestimmt, bis aus einzelnen Teilen wieder
					eine verlässliche mechanische Einheit wird.
				</p>
			</div>
		</div>
	</section>
</EditorialPageLayout>

<style>
	:global(.editorial-page) .collage--body-details .image-layer--detail {
		right: 0;
		bottom: 0;
		z-index: 3;
		width: 48%;
		height: 34%;
	}
	:global(.editorial-page) .collage--body-details .image-layer--detail img {
		height: 100%;
	}
	:global(.editorial-page) .collage--craft-details .image-layer--portrait {
		width: 76%;
		height: 78%;
	}
	:global(.editorial-page) .collage--craft-details .image-layer--landscape {
		bottom: 14%;
		width: 64%;
		height: 38%;
	}
	:global(.editorial-page) .collage--craft-details .image-layer--detail {
		left: 0;
		bottom: 0;
		z-index: 3;
		width: 56%;
		height: auto;
	}
	:global(.editorial-page) .image-layer--detail img {
		display: block;
		height: auto;
	}
	:global(.editorial-page) .collage--engines { min-height: clamp(38rem, 60vw, 58rem); }
	:global(.editorial-page) .collage--engines .image-layer { height: auto; }
	:global(.editorial-page) .collage--engines .image-layer--portrait { width: 94%; }
	:global(.editorial-page) .collage--engines .image-layer--landscape { width: 84%; bottom: 8%; }
	:global(.editorial-page) .collage--engines img { display: block; height: auto; }
	@media (max-width: 840px) {
		:global(.editorial-page) .collage--body-details .image-layer--detail {
			width: 55%;
			height: 36%;
		}
		:global(.editorial-page) .collage--engines { display: grid; gap: 3rem; min-height: 0; }
		:global(.editorial-page) .collage--engines .image-layer { position: relative; inset: auto; }
		:global(.editorial-page) .collage--engines .image-layer--landscape { justify-self: end; }
	}
</style>
