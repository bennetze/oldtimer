---
import Layout from "../layouts/Layout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SectionNavigation from "../components/SectionNavigation.astro";
import { localizedRoute, type Locale } from "../config/i18n";
import heroSiteMotionAvif from "../assets/oldtimer/hero-site-motion.avif";
import heroSiteMotionWebp from "../assets/oldtimer/hero-site-motion.webp";
import heroSiteMp4 from "../assets/oldtimer/hero-site.mp4";
import heroSitePoster from "../assets/oldtimer/hero-site-poster.jpg";
import heroSiteWebm from "../assets/oldtimer/hero-site.webm";
import handwerkMotionAvif from "../assets/oldtimer/handwerk-motion.avif";
import handwerkMotionWebp from "../assets/oldtimer/handwerk-motion.webp";
import handwerkMp4 from "../assets/oldtimer/handwerk.mp4";
import handwerkPoster from "../assets/oldtimer/handwerk-poster.jpg";
import handwerkWebm from "../assets/oldtimer/handwerk.webm";
import ueberUnsMotionAvif from "../assets/oldtimer/ueberuns-motion.avif";
import ueberUnsMotionWebp from "../assets/oldtimer/ueberuns-motion.webp";
import ueberUnsMp4 from "../assets/oldtimer/ueberuns.mp4";
import ueberUnsPoster from "../assets/oldtimer/ueberuns-poster.jpg";
import ueberUnsWebm from "../assets/oldtimer/ueberuns.webm";
import projekteMotionAvif from "../assets/oldtimer/projekte-motion.avif";
import projekteMotionWebp from "../assets/oldtimer/projekte-motion.webp";
import projekteMp4 from "../assets/oldtimer/projekte.mp4";
import projektePoster from "../assets/oldtimer/projekte-poster.jpg";
import projekteWebm from "../assets/oldtimer/projekte.webm";

interface Props {
  locale?: Locale;
}

const { locale = "de" } = Astro.props;
const copy = {
  de: {
    description: "Die Oldtimermanufaktur bewahrt die Geschichte klassischer Automobile – mit handwerklicher Präzision, technischer Sorgfalt und Respekt vor ihrer Geschichte.",
    hero: "Wir bewahren Geschichte(n)",
    motionPause: "Animation pausieren",
    motionPlay: "Animation abspielen",
    scrollCraft: "Zum Handwerk scrollen",
    scrollStart: "Zum Start scrollen",
    scrollAbout: "Zu Über uns scrollen",
    scrollProjects: "Zu Projekten scrollen",
    scrollFooter: "Zum Footer scrollen",
    sectionChange: "Abschnitt wechseln",
    learnMore: "Mehr erfahren",
    craft: "Handwerk",
    about: "Über uns",
    projects: "Projekte",
    navigation: [
      { id: "start", label: "Start" },
      { id: "handwerk", label: "Handwerk" },
      { id: "ueber-uns", label: "Über uns" },
      { id: "projekte", label: "Projekte" },
    ],
  },
  en: {
    description: "The Oldtimermanufaktur preserves the history of classic automobiles through skilled craftsmanship, technical care and respect for each vehicle's story.",
    hero: "We preserve history — and stories",
    motionPause: "Pause motion",
    motionPlay: "Play motion",
    scrollCraft: "Scroll to craft",
    scrollStart: "Scroll to the start",
    scrollAbout: "Scroll to About us",
    scrollProjects: "Scroll to projects",
    scrollFooter: "Scroll to the footer",
    sectionChange: "Change section",
    learnMore: "Discover more",
    craft: "Craft",
    about: "About us",
    projects: "Projects",
    navigation: [
      { id: "start", label: "Start" },
      { id: "handwerk", label: "Craft" },
      { id: "ueber-uns", label: "About us" },
      { id: "projekte", label: "Projects" },
    ],
  },
}[locale];

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const includeWebpMotionFallback = import.meta.env.BASE_URL === "/";
const sitePath = (path) => {
  const localizedPath = localizedRoute(path, locale);
  return localizedPath === "/"
    ? basePath
    : `${basePath}${localizedPath.replace(/^\//, "")}`;
};
---

<Layout
  description={copy.description}
  dateModified="2026-08-10"
  {locale}
>
  <SiteChrome {locale}>
    <main id="main-content" tabindex="-1">
      <SectionNavigation items={copy.navigation} {locale} />

      <section
        class="media-panel hero"
        id="start"
        aria-labelledby="hero-title"
        data-hero
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={heroSitePoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={heroSiteMp4} type="video/mp4" />
          <source
            src={heroSiteWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="high"
            src={heroSitePoster.src}
            data-motion-poster={heroSitePoster.src}
            data-motion-avif={heroSiteMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? heroSiteMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>
        <div class="media-panel__shade"></div>
        <button
          class="hero-motion-toggle"
          type="button"
          data-motion-toggle
          aria-label={copy.motionPause}
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--hero">
          <h1 id="hero-title">{copy.hero}</h1>
          <button
            class="scroll-cue"
            type="button"
            data-scroll-target="#handwerk"
            aria-label={copy.scrollCraft}
          >
            <span aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section
        class="media-panel craft"
        id="handwerk"
        aria-labelledby="craft-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={handwerkPoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={handwerkMp4} type="video/mp4" />
          <source
            src={handwerkWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="high"
            src={handwerkPoster.src}
            data-motion-poster={handwerkPoster.src}
            data-motion-avif={handwerkMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? handwerkMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>
        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label={copy.scrollStart}
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="craft-title">{copy.craft}</h2>
          <a class="section-cta" href={sitePath("/handwerk/")}>
            {copy.learnMore}
          </a>
          <div class="scroll-cues" aria-label={copy.sectionChange}>
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#ueber-uns"
              aria-label={copy.scrollAbout}
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="media-panel editorial-panel"
        id="ueber-uns"
        aria-labelledby="about-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={ueberUnsPoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={ueberUnsMp4} type="video/mp4" />
          <source src={ueberUnsWebm} type="video/webm" />
        </video>

        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            src={ueberUnsPoster.src}
            data-motion-poster={ueberUnsPoster.src}
            data-motion-avif={ueberUnsMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? ueberUnsMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>

        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label={copy.scrollStart}
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="about-title">{copy.about}</h2>
          <a class="section-cta" href={sitePath("/ueber-uns/")}>
            {copy.learnMore}
          </a>
          <div class="scroll-cues" aria-label={copy.sectionChange}>
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#projekte"
              aria-label={copy.scrollProjects}
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="media-panel editorial-panel"
        id="projekte"
        aria-labelledby="projects-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={projektePoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={projekteMp4} type="video/mp4" />
          <source src={projekteWebm} type="video/webm" />
        </video>

        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            src={projektePoster.src}
            data-motion-poster={projektePoster.src}
            data-motion-avif={projekteMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? projekteMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>

        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label={copy.scrollStart}
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="projects-title">{copy.projects}</h2>
          <a class="section-cta" href={sitePath("/projekte/")}>
            {copy.learnMore}
          </a>
          <div class="scroll-cues" aria-label={copy.sectionChange}>
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#site-footer"
              aria-label={copy.scrollFooter}
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>
    </main>

    <script is:inline define:vars={{ motionPlayLabel: copy.motionPlay, motionPauseLabel: copy.motionPause }}>
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const setMotionToggleState = (toggle, isPaused) => {
        if (!(toggle instanceof HTMLButtonElement)) {
          return;
        }

        toggle.classList.toggle("is-paused", isPaused);
        toggle.setAttribute(
          "aria-label",
          isPaused ? motionPlayLabel : motionPauseLabel,
        );
      };

      const initMotionPanel = (panel) => {
        if (!(panel instanceof HTMLElement)) {
          return;
        }

        const video = panel.querySelector("[data-motion-video]");
        const motionFallback = panel.querySelector("[data-motion-fallback]");
        const motionImage = panel.querySelector("[data-motion-image]");
        const motionToggle = panel.querySelector("[data-motion-toggle]");

        if (!(video instanceof HTMLVideoElement)) {
          return;
        }

        let autoplayBlocked = false;
        let inViewport = false;
        let fallbackActive = false;
        let fallbackTimer;
        let userPaused = prefersReducedMotion;

        const ensureMotionFallback = () => {
          if (
            !(motionFallback instanceof HTMLPictureElement) ||
            !(motionImage instanceof HTMLImageElement) ||
            motionImage.dataset.motionReady === "true"
          ) {
            return;
          }

          const avifSrc = motionImage.dataset.motionAvif;

          if (avifSrc) {
            const avifSource = document.createElement("source");
            avifSource.type = "image/avif";
            avifSource.srcset = avifSrc;
            avifSource.dataset.motionGeneratedSource = "true";
            motionFallback.prepend(avifSource);
          }

          const webpSrc = motionImage.dataset.motionWebp;

          if (webpSrc) {
            motionImage.src = webpSrc;
          }

          motionImage.dataset.motionReady = "true";
        };

        const pauseMotionFallback = () => {
          if (
            !(motionFallback instanceof HTMLPictureElement) ||
            !(motionImage instanceof HTMLImageElement)
          ) {
            return;
          }

          motionFallback
            .querySelectorAll("[data-motion-generated-source]")
            .forEach((source) => source.remove());

          const posterSrc = motionImage.dataset.motionPoster;

          if (posterSrc) {
            motionImage.src = posterSrc;
          }

          delete motionImage.dataset.motionReady;
        };

        const useMotionFallback = ({ animate = true } = {}) => {
          if (
            !(motionFallback instanceof HTMLElement) ||
            !(motionImage instanceof HTMLImageElement)
          ) {
            return false;
          }

          if (animate) {
            ensureMotionFallback();
          } else {
            pauseMotionFallback();
          }

          fallbackActive = true;

          panel.classList.add("is-motion-fallback");
          panel.classList.remove("is-video-ready");

          return true;
        };

        const markVideoReady = () => {
          window.clearTimeout(fallbackTimer);

          fallbackActive = false;
          autoplayBlocked = false;

          panel.classList.add("is-video-ready");
          panel.classList.remove("is-motion-fallback");

          setMotionToggleState(motionToggle, false);
        };

        const prepareVideo = () => {
          video.muted = true;
          video.defaultMuted = true;
          video.autoplay = true;
          video.loop = true;
          video.playsInline = true;
          video.volume = 0;
          video.controls = false;

          video.setAttribute("muted", "");
          video.setAttribute("autoplay", "");
          video.setAttribute("loop", "");
          video.setAttribute("playsinline", "");
          video.setAttribute("webkit-playsinline", "");
        };

        const playVideo = ({ userGesture = false } = {}) => {
          if (
            userPaused ||
            document.hidden ||
            !inViewport ||
            (autoplayBlocked && !userGesture)
          ) {
            return;
          }

          prepareVideo();

          video.play().catch(() => {
            autoplayBlocked = true;
            useMotionFallback();
            setMotionToggleState(motionToggle, false);
          });
        };

        const pauseMotion = () => {
          userPaused = true;

          window.clearTimeout(fallbackTimer);
          video.pause();

          if (fallbackActive) {
            useMotionFallback({ animate: false });
          }

          setMotionToggleState(motionToggle, true);
        };

        const resumeMotion = () => {
          userPaused = false;

          setMotionToggleState(motionToggle, false);

          if (fallbackActive && autoplayBlocked) {
            useMotionFallback();
          }

          playVideo({ userGesture: true });
        };

        const scheduleFallback = () => {
          if (userPaused || document.hidden || !inViewport) {
            return;
          }

          window.clearTimeout(fallbackTimer);

          fallbackTimer = window.setTimeout(() => {
            if (
              video.paused ||
              video.readyState < HTMLMediaElement.HAVE_FUTURE_DATA
            ) {
              useMotionFallback();
            }
          }, 900);
        };

        video.addEventListener("playing", markVideoReady);
        video.addEventListener("waiting", scheduleFallback);
        video.addEventListener("stalled", scheduleFallback);

        video.addEventListener("error", () => {
          autoplayBlocked = true;
          useMotionFallback();
        });

        motionToggle?.addEventListener("click", () => {
          if (userPaused) {
            resumeMotion();
          } else {
            pauseMotion();
          }
        });

        setMotionToggleState(motionToggle, userPaused);

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            ([entry]) => {
              inViewport = Boolean(entry?.isIntersecting);

              if (!inViewport) {
                video.pause();
                return;
              }

              playVideo();
            },
            {
              threshold: 0.12,
            },
          );

          observer.observe(panel);
        } else {
          inViewport = true;
          playVideo();
        }

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            video.pause();
            return;
          }

          playVideo();
        });

        window.addEventListener("pageshow", playVideo);

        ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
          window.addEventListener(
            eventName,
            () => playVideo({ userGesture: true }),
            {
              once: true,
              passive: true,
            },
          );
        });
      };

      document.querySelectorAll("[data-motion-panel]").forEach(initMotionPanel);
    </script>
  </SiteChrome>
</Layout>

<style>
  :global(html),
  :global(body),
  main {
    background: #101010;
    background-color: #101010;
  }

  .scroll-cue {
    color: currentColor;
    background: transparent;
    border: 0;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: var(--text-utility);
    font-weight: 500;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .media-panel {
    position: relative;
    display: grid;
    --panel-edge-cue-offset: clamp(5.25rem, 12vh, 8.5rem);
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }

  .media-panel::after {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 18vh;
    background: linear-gradient(180deg, rgba(16, 16, 16, 0), #101010);
    content: "";
    pointer-events: none;
  }

  .media-panel__image,
  .media-panel__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-panel__image {
    z-index: 0;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04) brightness(0.92);
    transform: scale(1.015);
  }

  .media-panel__image--motion-fallback {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .media-panel__image--motion-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-motion-panel] video.media-panel__image {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  [data-motion-panel].is-video-ready video.media-panel__image {
    visibility: visible;
    opacity: 1;
  }

  [data-motion-panel].is-video-ready .media-panel__image--motion-fallback {
    visibility: hidden;
    opacity: 0;
  }

  .hero-motion-toggle {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    bottom: clamp(1.25rem, 3vw, 2.75rem);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: rgba(238, 238, 238, 0.9);
    background: rgba(16, 16, 16, 0.22);
    border: 1px solid rgba(238, 238, 238, 0.38);
    border-radius: 999px;
    backdrop-filter: blur(14px);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .hero-motion-toggle span {
    position: relative;
    width: 11px;
    height: 14px;
    border-left: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  .hero-motion-toggle.is-paused span {
    width: 0;
    height: 0;
    margin-left: 2px;
    border-top: 7px solid transparent;
    border-right: 0;
    border-bottom: 7px solid transparent;
    border-left: 11px solid currentColor;
  }

  .hero-motion-toggle:hover,
  .hero-motion-toggle:focus-visible {
    background: rgba(16, 16, 16, 0.5);
    border-color: rgba(238, 238, 238, 0.86);
    transform: scale(1.05);
  }

  .hero-motion-toggle:focus-visible {
    outline: 1px solid rgba(238, 238, 238, 0.82);
    outline-offset: 0.35rem;
  }

  .media-panel__shade {
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.34),
        rgba(12, 12, 12, 0.04) 40%,
        rgba(12, 12, 12, 0.58)
      ),
      linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.42),
        rgba(12, 12, 12, 0.04) 56%,
        rgba(12, 12, 12, 0.22)
      );
    pointer-events: none;
  }

  .media-panel__shade--craft {
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.36),
        rgba(12, 12, 12, 0.06) 42%,
        rgba(12, 12, 12, 0.62)
      ),
      linear-gradient(90deg, rgba(12, 12, 12, 0.46), rgba(12, 12, 12, 0.05) 62%);
  }

  .media-panel__shade--editorial {
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.28),
        rgba(12, 12, 12, 0.03) 38%,
        rgba(12, 12, 12, 0.76)
      ),
      linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.34),
        rgba(12, 12, 12, 0.04) 50%,
        rgba(12, 12, 12, 0.28)
      );
  }

  #projekte .media-panel__image {
    object-position: 50% 48%;
  }

  #ueber-uns .media-panel__image {
    object-position: 50% 44%;
  }

  #oldtimer-kaufen .media-panel__image {
    object-position: 50% 48%;
  }

  .media-panel__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 9rem 0 clamp(5.25rem, 12vh, 8.5rem);
    text-align: center;
    transition:
      opacity 360ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-panel__content--craft {
    align-items: center;
    justify-content: end;
    width: min(780px, calc(100% - 2rem));
    margin: 0 auto;
    text-align: center;
  }

	h1,
	.media-panel h2 {
    margin: 0;
    font-family: var(--font-body);
		font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: none;
    font-size: clamp(2.05rem, 3.25vw, 4rem);
    line-height: 1.1;
    white-space: nowrap;
  }

  .media-panel h2 {
    max-width: 820px;
    font-size: clamp(1.8rem, 3vw, 3.55rem);
    line-height: 1.12;
