---
import Layout from "../layouts/Layout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SectionNavigation from "../components/SectionNavigation.astro";
import craftHands from "../assets/oldtimer/craft-hands.png";
import heroSiteMotionAvif from "../assets/oldtimer/hero-site-motion.avif";
import heroSiteMotionWebp from "../assets/oldtimer/hero-site-motion.webp";
import heroSiteMp4 from "../assets/oldtimer/hero-site.mp4";
import heroSitePoster from "../assets/oldtimer/hero-site-poster.jpg";
import heroSiteWebm from "../assets/oldtimer/hero-site.webm";
import handwerkMotionAvif from "../assets/oldtimer/handwerk-motion.avif";
import handwerkMotionWebp from "../assets/oldtimer/handwerk-motion.webp";
import handwerkMp4 from "../assets/oldtimer/handwerk.mp4";
import handwerkPoster from "../assets/oldtimer/handwerk-poster.jpg";
import handwerkWebm from "../assets/oldtimer/handwerk.webm";
import ueberUnsMotionAvif from "../assets/oldtimer/ueberuns-motion.avif";
import ueberUnsMotionWebp from "../assets/oldtimer/ueberuns-motion.webp";
import ueberUnsMp4 from "../assets/oldtimer/ueberuns.mp4";
import ueberUnsPoster from "../assets/oldtimer/ueberuns-poster.jpg";
import ueberUnsWebm from "../assets/oldtimer/ueberuns.webm";
import projekteMotionAvif from "../assets/oldtimer/projekte-motion.avif";
import projekteMotionWebp from "../assets/oldtimer/projekte-motion.webp";
import projekteMp4 from "../assets/oldtimer/projekte.mp4";
import projektePoster from "../assets/oldtimer/projekte-poster.jpg";
import projekteWebm from "../assets/oldtimer/projekte.webm";
import sectionOldtimerKaufen from "../assets/oldtimer/section-oldtimer-kaufen.png";
import sectionProjekte from "../assets/oldtimer/section-projekte.png";
import sectionUeberUns from "../assets/oldtimer/section-ueber-uns.png";
import { object, optional, overwrite } from "astro:schema";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const includeWebpMotionFallback = import.meta.env.BASE_URL === "/";
const sitePath = (path) => {
  if (path === "/") {
    return basePath;
  }

  if (path.startsWith("/#")) {
    return `${basePath}${path.slice(1)}`;
  }

  if (path.startsWith("/")) {
    return `${basePath}${path.slice(1)}`;
  }

  return path;
};

const sections = [
  {
    id: "ueber-uns",
    title: "Über uns",
    image: sectionUeberUns,
    alt: "Restaurierungsteam arbeitet konzentriert an einem klassischen Fahrzeug in einer Werkstatt",
    href: "/ueber-uns/",
    previous: "#handwerk",
    next: "#projekte",
  },
  {
    id: "projekte",
    title: "Projekte",
    image: sectionProjekte,
    alt: "Klassische Fahrzeuge in unterschiedlichen Restaurierungsphasen in einer dunklen Werkstatt",
    href: "/projekte/",
    previous: "#ueber-uns",
    next: "#oldtimer-kaufen",
  },
  {
    id: "oldtimer-kaufen",
    title: "Fahrzeugangebote",
    image: sectionOldtimerKaufen,
    alt: "Ein klassisches Coupé in einer dunklen Werkstattpräsentation",
    href: "/projekte/fahrzeugangebote/",
    previous: "#projekte",
  },
];

const sectionNavigationItems = [
  { id: "start", label: "Start" },
  { id: "handwerk", label: "Handwerk" },
  { id: "ueber-uns", label: "Über uns" },
  { id: "projekte", label: "Projekte" },
];
---

<Layout
  description="Die Oldtimermanufaktur bewahrt die Geschichte klassischer Automobile – mit handwerklicher Präzision, technischer Sorgfalt und Respekt vor ihrer Geschichte."
  dateModified="2026-08-06"
>
  <SiteChrome>
    <main id="main-content" tabindex="-1">
      <SectionNavigation items={sectionNavigationItems} />

      <section
        class="media-panel hero"
        id="start"
        aria-labelledby="hero-title"
        data-hero
        data-motion-panel
      >
        <video
          class="media-panel__image"
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={heroSitePoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={heroSiteMp4} type="video/mp4" />
          <source
            src={heroSiteWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="high"
            src={heroSitePoster.src}
            data-motion-poster={heroSitePoster.src}
            data-motion-avif={heroSiteMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? heroSiteMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>
        <div class="media-panel__shade"></div>
        <button
          class="hero-motion-toggle"
          type="button"
          data-motion-toggle
          aria-label="Animation abspielen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--hero">
          <h1 id="hero-title">
            Wir bewahren <span class="hero-title__word"
              >Geschichte<span class="hero-title__letter" data-hero-title-letter
                ><span
                  class="hero-title__letter-glyph"
                  data-hero-title-letter-glyph>N</span
                ></span
              ></span
            >
          </h1>
          <button
            class="scroll-cue"
            type="button"
            data-scroll-target="#handwerk"
            aria-label="Zum Handwerk scrollen"
          >
            <span aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section
        class="media-panel craft"
        id="handwerk"
        aria-labelledby="craft-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          muted
          loop
          playsinline
          webkit-playsinline
          preload="none"
          poster={handwerkPoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={handwerkMp4} type="video/mp4" />
          <source
            src={handwerkWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="auto" loading="lazy"
            src={handwerkPoster.src}
            data-motion-poster={handwerkPoster.src}
            data-motion-avif={handwerkMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? handwerkMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>
        <button class="hero-motion-toggle is-paused" type="button" data-motion-toggle aria-label="Animation abspielen">
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="craft-title">Handwerk</h2>
          <a class="section-cta" href={sitePath("/handwerk/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#ueber-uns"
              aria-label="Zu Über uns scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="media-panel editorial-panel"
        id="ueber-uns"
        aria-labelledby="ueber-uns-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          muted
          loop
          playsinline
          webkit-playsinline
          preload="none"
          poster={ueberUnsPoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={ueberUnsMp4} type="video/mp4" />
          <source src={ueberUnsWebm} type="video/webm" />
        </video>

        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            src={ueberUnsPoster.src}
            data-motion-poster={ueberUnsPoster.src}
            data-motion-avif={ueberUnsMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? ueberUnsMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>

        <button class="hero-motion-toggle is-paused" type="button" data-motion-toggle aria-label="Animation abspielen">
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="ueber-uns-title">Über uns</h2>
          <a class="section-cta" href={sitePath("/ueber-uns/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#projekte"
              aria-label="Zu Projekten scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="media-panel editorial-panel"
        id="projekte"
        aria-labelledby="projekte-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          muted
          loop
          playsinline
          webkit-playsinline
          preload="none"
          poster={projektePoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={projekteMp4} type="video/mp4" />
          <source src={projekteWebm} type="video/webm" />
        </video>

        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            src={projektePoster.src}
            data-motion-poster={projektePoster.src}
            data-motion-avif={projekteMotionAvif.src}
            data-motion-webp={includeWebpMotionFallback ? projekteMotionWebp.src : undefined}
            data-motion-image
          />
        </picture>

        <button class="hero-motion-toggle is-paused" type="button" data-motion-toggle aria-label="Animation abspielen">
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="projekte-title">Projekte</h2>
          <a class="section-cta" href={sitePath("/projekte/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#site-footer"
              aria-label="Zum Footer scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>
    </main>

    <script src="../scripts/homepage.js"></script>
  </SiteChrome>
</Layout>

<style>
  :global(html),
  :global(body),
  main {
    background: #101010;
    background-color: #101010;
  }

  .scroll-cue {
    color: currentColor;
    background: transparent;
    border: 0;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.66rem;
    font-weight: 500;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .media-panel {
    position: relative;
    display: grid;
    --panel-edge-cue-offset: clamp(5.25rem, 12vh, 8.5rem);
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }

  .media-panel::after {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 18vh;
    background: linear-gradient(180deg, rgba(16, 16, 16, 0), #101010);
    content: "";
    pointer-events: none;
  }

  .media-panel__image,
  .media-panel__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-panel__image {
    z-index: 0;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04) brightness(0.92);
    transform: scale(1.015);
  }

  .media-panel__image--motion-fallback {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .media-panel__image--motion-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-motion-panel] video.media-panel__image {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  [data-motion-panel].is-video-ready video.media-panel__image {
    visibility: visible;
    opacity: 1;
  }

  [data-motion-panel].is-video-ready .media-panel__image--motion-fallback {
    visibility: hidden;
    opacity: 0;
  }

  .hero-motion-toggle {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    bottom: clamp(1.25rem, 3vw, 2.75rem);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: rgba(238, 238, 238, 0.9);
    background: rgba(16, 16, 16, 0.22);
    border: 1px solid rgba(238, 238, 238, 0.38);
    border-radius: 999px;
    backdrop-filter: blur(14px);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .hero-motion-toggle span {
    position: relative;
    width: 11px;
    height: 14px;
    border-left: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  .hero-motion-toggle.is-paused span {
    width: 0;
    height: 0;
    margin-left: 2px;
    border-top: 7px solid transparent;
    border-right: 0;
    border-bottom: 7px solid transparent;
    border-left: 11px solid currentColor;
  }

  .hero-motion-toggle:hover,
  .hero-motion-toggle:focus-visible {
    background: rgba(16, 16, 16, 0.5);
    border-color: rgba(238, 238, 238, 0.86);
    transform: scale(1.05);
  }

  .hero-motion-toggle:focus-visible {
    outline: 1px solid rgba(238, 238, 238, 0.82);
    outline-offset: 0.35rem;
  }

  .media-panel__shade {
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.34),
        rgba(12, 12, 12, 0.04) 40%,
        rgba(12, 12, 12, 0.58)
      ),
      linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.42),
        rgba(12, 12, 12, 0.04) 56%,
        rgba(12, 12, 12, 0.22)
      );
    pointer-events: none;
  }

  .media-panel__shade--craft {
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.36),
        rgba(12, 12, 12, 0.06) 42%,
        rgba(12, 12, 12, 0.62)
      ),
      linear-gradient(90deg, rgba(12, 12, 12, 0.46), rgba(12, 12, 12, 0.05) 62%);
  }

  .media-panel__shade--editorial {
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.28),
        rgba(12, 12, 12, 0.03) 38%,
        rgba(12, 12, 12, 0.76)
      ),
      linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.34),
        rgba(12, 12, 12, 0.04) 50%,
        rgba(12, 12, 12, 0.28)
      );
  }

  #projekte .media-panel__image {
    object-position: 50% 48%;
  }

  #ueber-uns .media-panel__image {
    object-position: 50% 44%;
  }

  #oldtimer-kaufen .media-panel__image {
    object-position: 50% 48%;
  }

  .media-panel__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 9rem 0 clamp(5.25rem, 12vh, 8.5rem);
    text-align: center;
    transition:
      opacity 360ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-panel__content--craft {
    align-items: center;
    justify-content: end;
    width: min(780px, calc(100% - 2rem));
    margin: 0 auto;
    text-align: center;
  }

  h1,
  .media-panel h2 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1 {
    width: max-content;
    max-width: calc(100vw - 2rem);
    font-size: clamp(1.7rem, 3.1vw, 3.75rem);
    line-height: 1.1;
    white-space: nowrap;
  }

  .hero-title__word {
    white-space: nowrap;
  }

  .hero-title__letter {
    --hero-title-letter-width: 0.8em;

    display: inline-block;
    width: 0;
    overflow: visible;
    filter: blur(0.1em);
    opacity: 0;
    transform: translateX(-0.14em);
    vertical-align: baseline;
    will-change: width, opacity, filter, transform;
  }

  .hero-title__letter-glyph {
    display: inline-block;
  }

  .media-panel h2 {
    max-width: 820px;
    font-size: clamp(1.5rem, 2.75vw, 3.25rem);
    line-height: 1.12;
  }

  .media-panel__content--editorial {
    width: min(760px, calc(100% - 2rem));
    padding-bottom: clamp(4.25rem, 9vh, 6.75rem);
  }

  .section-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: min(84vw, 312px);
    min-height: 64px;
    margin-top: clamp(1.7rem, 3vw, 2.55rem);
    padding: 0.95rem 2.8rem;
    color: #111111;
    background: rgba(238, 238, 238, 0.96);
    border: 1px solid rgba(238, 238, 238, 0.98);
    border-radius: 999px;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: clamp(0.72rem, 0.76vw, 0.82rem);
    font-weight: 500;
    line-height: 1;
    transition:
      background 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      transform 220ms ease;
  }

  .section-cta:hover,
  .section-cta:focus-visible {
    color: var(--color-main);
    background: rgba(238, 238, 238, 0.08);
    border-color: rgba(238, 238, 238, 0.82);
    transform: translateY(-2px);
  }

  .section-cta:focus-visible {
    outline: 1px solid rgba(238, 238, 238, 0.72);
    outline-offset: 0.35rem;
  }

  .scroll-cue {
    cursor: pointer;
    width: 48px;
    height: 48px;
    color: var(--color-main);
    opacity: 0.78;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .scroll-cue span {
    width: 12px;
    height: 12px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px);
  }

  .scroll-cues {
    display: inline-grid;
    grid-template-columns: 48px;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3.6vw, 3.1rem);
  }

  .media-panel__content--hero > .scroll-cue {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .scroll-cue--up span {
    transform: rotate(225deg) translate(-2px, -2px);
  }

  .section-up-cue {
    position: absolute;
    top: var(--panel-edge-cue-offset);
    left: 50%;
    z-index: 4;
    transform: translateX(-50%);
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    color: rgba(238, 238, 238, 0.96);
    opacity: 1;
    transform: translateY(4px);
  }

  .scroll-cue--up:hover,
  .scroll-cue--up:focus-visible {
    transform: translateY(-4px);
  }

  .section-up-cue:hover,
  .section-up-cue:focus-visible {
    transform: translateX(-50%) translateY(-4px);
  }

  .scroll-cue:focus-visible {
    outline: 1px solid rgba(238, 238, 238, 0.62);
    outline-offset: 0.35rem;
  }

  @media (max-width: 1100px) {
    h1 {
      font-size: clamp(1.62rem, 5vw, 3.4rem);
    }

    .hero-title__word {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .media-panel {
      min-height: 100svh;
      --panel-edge-cue-offset: clamp(7.75rem, 18svh, 10rem);
    }

    .section-up-cue {
      top: calc(var(--site-header-height, 104px) + var(--panel-edge-cue-offset));
    }

    .media-panel__content,
    .media-panel__content--craft {
      width: min(100% - 2rem, 560px);
      margin: 0 auto;
      align-items: center;
      justify-content: end;
      padding: 6rem 0 clamp(7.75rem, 18svh, 10rem);
      text-align: center;
    }

    h1 {
      width: 100%;
      max-width: 900px;
      line-height: 1.12;
      letter-spacing: 0.12em;
      white-space: normal;
    }

    .hero-title__word:lang(en) {
      white-space: normal;
    }

    .media-panel h2 {
      font-size: clamp(1.48rem, 7vw, 2.05rem);
      line-height: 1.14;
      letter-spacing: 0.12em;
    }

    .scroll-cue {
      width: 44px;
      height: 44px;
    }

    .section-cta {
      min-width: min(84vw, 292px);
      min-height: 58px;
      padding-inline: 2.1rem;
      letter-spacing: 0.2em;
    }

    .hero-motion-toggle {
      right: 1rem;
      bottom: 1rem;
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title__letter {
      animation: none;
