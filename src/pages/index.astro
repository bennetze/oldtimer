---
import Layout from "../layouts/Layout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SectionNavigation from "../components/SectionNavigation.astro";
import craftHands from "../assets/oldtimer/craft-hands.png";
import heroSiteMotionAvif from "../assets/oldtimer/hero-site-motion.avif";
import heroSiteMotionWebp from "../assets/oldtimer/hero-site-motion.webp";
import heroSiteMp4 from "../assets/oldtimer/hero-site.mp4";
import heroSitePoster from "../assets/oldtimer/hero-site-poster.jpg";
import heroSiteWebm from "../assets/oldtimer/hero-site.webm";
import sectionOldtimerKaufen from "../assets/oldtimer/section-oldtimer-kaufen.png";
import sectionProjekte from "../assets/oldtimer/section-projekte.png";
import sectionUeberUns from "../assets/oldtimer/section-ueber-uns.png";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path) => {
  if (path === "/") {
    return basePath;
  }

  if (path.startsWith("/#")) {
    return `${basePath}${path.slice(1)}`;
  }

  if (path.startsWith("/")) {
    return `${basePath}${path.slice(1)}`;
  }

  return path;
};

const sections = [
  {
    id: "ueber-uns",
    title: "Über uns",
    image: sectionUeberUns,
    alt: "Restaurierungsteam arbeitet konzentriert an einem klassischen Fahrzeug in einer Werkstatt",
    href: "/ueber-uns/",
    previous: "#handwerk",
    next: "#projekte",
  },
  {
    id: "projekte",
    title: "Projekte",
    image: sectionProjekte,
    alt: "Klassische Fahrzeuge in unterschiedlichen Restaurierungsphasen in einer dunklen Werkstatt",
    href: "/projekte/",
    previous: "#ueber-uns",
    next: "#oldtimer-kaufen",
  },
  {
    id: "oldtimer-kaufen",
    title: "Fahrzeugangebote",
    image: sectionOldtimerKaufen,
    alt: "Ein klassisches Coupé in einer dunklen Werkstattpräsentation",
    href: "/projekte/fahrzeugangebote/",
    previous: "#projekte",
  },
];

const sectionNavigationItems = [
  { id: "start", label: "Start" },
  { id: "handwerk", label: "Handwerk" },
  ...sections.map((section) => ({ id: section.id, label: section.title })),
];
---

<Layout
  description="Die Oldtimermanufaktur bewahrt die Geschichte klassischer Automobile – mit handwerklicher Präzision, technischer Sorgfalt und Respekt vor ihrer Geschichte."
  dateModified="2026-08-06"
>
  <SiteChrome>
    <main id="main-content" tabindex="-1">
      <SectionNavigation items={sectionNavigationItems} />

      <section
        class="media-panel hero"
        id="start"
        aria-labelledby="hero-title"
        data-hero
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={heroSitePoster.src}
          disablepictureinpicture
          data-hero-video
          aria-hidden="true"
        >
          <source src={heroSiteMp4} type="video/mp4" />
          <source
            src={heroSiteWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-hero-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="high"
            src={heroSitePoster.src}
            data-hero-poster={heroSitePoster.src}
            data-hero-motion-avif={heroSiteMotionAvif.src}
            data-hero-motion-webp={heroSiteMotionWebp.src}
            data-hero-motion-image
          />
        </picture>
        <div class="media-panel__shade"></div>
        <button
          class="hero-motion-toggle"
          type="button"
          data-hero-motion-toggle
          aria-label="Animation pausieren"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--hero">
          <h1 id="hero-title">
            Wir bewahren <span class="hero-title__word"
              >Geschichte<span class="hero-title__letter" data-hero-title-letter
                ><span class="hero-title__letter-glyph" data-hero-title-letter-glyph
                  >N</span
                ></span
              ></span
            >
          </h1>
          <button
            class="scroll-cue"
            type="button"
            data-scroll-target="#handwerk"
            aria-label="Zum Handwerk scrollen"
          >
            <span aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section
        class="media-panel craft"
        id="handwerk"
        aria-labelledby="craft-title"
      >
        <img
          class="media-panel__image"
          src={craftHands.src}
          alt="KI-generierter Platzhalter für eine geplante Aufnahme handwerklicher Arbeit an einem Oldtimer"
          loading="lazy"
        />
        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="craft-title">Handwerk</h2>
          <a class="section-cta" href={sitePath("/handwerk/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#ueber-uns"
              aria-label="Zu Über uns scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      {
        sections.map((section) => (
          <section
            class="media-panel editorial-panel"
            id={section.id}
            aria-labelledby={`${section.id}-title`}
          >
            <img
              class="media-panel__image"
              src={section.image.src}
              alt={`KI-generierter Platzhalter: ${section.alt}`}
              loading="lazy"
            />
            <div class="media-panel__shade media-panel__shade--editorial" />
            <button
              class="scroll-cue scroll-cue--up section-up-cue"
              type="button"
              data-scroll-target={section.previous}
              aria-label={`Vor ${section.title} scrollen`}
            >
              <span aria-hidden="true" />
            </button>
            <div class="media-panel__content media-panel__content--editorial">
              <h2 id={`${section.id}-title`}>{section.title}</h2>
              <a class="section-cta" href={sitePath(section.href)}>
                Mehr erfahren
              </a>
              <div class="scroll-cues" aria-label="Abschnitt wechseln">
                {section.next ? (
                  <button
                    class="scroll-cue"
                    type="button"
                    data-scroll-target={section.next}
                    aria-label={`${section.title} verlassen`}
                  >
                    <span aria-hidden="true" />
                  </button>
                ) : (
                  <a
                    class="scroll-cue"
                    href="#site-footer"
                    aria-label="Zum Footer scrollen"
                  >
                    <span aria-hidden="true" />
                  </a>
                )}
              </div>
            </div>
          </section>
        ))
      }
    </main>

    <script is:inline>
      const hero = document.querySelector("[data-hero]");
      const heroVideo = document.querySelector("[data-hero-video]");
      const heroMotionFallback = document.querySelector(
        "[data-hero-motion-fallback]",
      );
      const heroMotionImage = document.querySelector(
        "[data-hero-motion-image]",
      );
      const heroMotionToggle = document.querySelector(
        "[data-hero-motion-toggle]",
      );
      const heroTitleLetter = document.querySelector(
        "[data-hero-title-letter]",
      );
      const heroTitleLetterGlyph = document.querySelector(
        "[data-hero-title-letter-glyph]",
      );
      let heroAutoplayBlocked = false;
      let heroInViewport = true;
      let heroFallbackActive = false;
      let heroFallbackTimer;
      let heroTitleCycleAnimation;
      let heroTitleCycleStarted = false;
      let heroTitleResizeFrame;
      let heroUserPaused = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const measureHeroTitleLetter = () => {
        if (
          !(heroTitleLetter instanceof HTMLElement) ||
          !(heroTitleLetterGlyph instanceof HTMLElement)
        ) {
          return;
        }

        const letterWidth = heroTitleLetterGlyph.getBoundingClientRect().width;
        if (letterWidth > 0) {
          heroTitleLetter.style.setProperty(
            "--hero-title-letter-width",
            `${letterWidth}px`,
          );
        }

        return letterWidth;
      };

      const startHeroTitleCycle = () => {
        if (!(heroTitleLetter instanceof HTMLElement)) {
          return;
        }

        Promise.resolve(document.fonts?.ready).then(() => {
          const letterWidth = measureHeroTitleLetter();
          if (!letterWidth) {
            return;
          }

          heroTitleCycleAnimation?.cancel();
          heroTitleLetter.classList.remove("is-cycling", "is-revealing");
          Object.assign(heroTitleLetter.style, {
            clipPath: "none",
            display: "inline-block",
            overflow: "visible",
            verticalAlign: "baseline",
          });

          if (heroUserPaused || typeof heroTitleLetter.animate !== "function") {
            Object.assign(heroTitleLetter.style, {
              filter: "blur(0)",
              opacity: "1",
              transform: "none",
              width: `${letterWidth}px`,
            });
            return;
          }

          const hiddenLetter = {
            filter: "blur(0.1em)",
            opacity: 0,
            transform: "translateX(-0.14em)",
            width: "0px",
          };
          const visibleLetter = {
            filter: "blur(0)",
            opacity: 1,
            transform: "translateX(0)",
            width: `${letterWidth}px`,
          };

          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              heroTitleCycleAnimation = heroTitleLetter.animate(
                [
                  { ...hiddenLetter, offset: 0 },
                  {
                    ...hiddenLetter,
                    easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                    offset: 1 / 10,
                  },
                  { ...visibleLetter, offset: 2 / 10 },
                  {
                    ...visibleLetter,
                    easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                    offset: 8 / 10,
                  },
                  { ...hiddenLetter, offset: 9 / 10 },
                  { ...hiddenLetter, offset: 1 },
                ],
                {
                  duration: 7500,
                  fill: "both",
                  iterations: Infinity,
                },
              );
            });
          });

          heroTitleCycleStarted = true;
        });
      };

      if (heroTitleLetter instanceof HTMLElement && !heroUserPaused) {
        heroTitleLetter.classList.remove("is-cycling", "is-revealing");
        Object.assign(heroTitleLetter.style, {
          clipPath: "none",
          display: "inline-block",
          filter: "blur(0.1em)",
          opacity: "0",
          overflow: "visible",
          transform: "translateX(-0.14em)",
          verticalAlign: "baseline",
          width: "0px",
        });
      }

      if (document.readyState === "complete") {
        startHeroTitleCycle();
      } else {
        window.addEventListener("load", startHeroTitleCycle, { once: true });
      }

      window.addEventListener(
        "resize",
        () => {
          window.cancelAnimationFrame(heroTitleResizeFrame);
          heroTitleResizeFrame = window.requestAnimationFrame(() => {
            if (heroTitleCycleStarted) {
              startHeroTitleCycle();
            } else {
              measureHeroTitleLetter();
            }
          });
        },
        { passive: true },
      );

      const setHeroToggleState = (isPaused) => {
        if (!(heroMotionToggle instanceof HTMLButtonElement)) {
          return;
        }

        heroMotionToggle.classList.toggle("is-paused", isPaused);
        heroMotionToggle.setAttribute(
          "aria-label",
          isPaused ? "Animation abspielen" : "Animation pausieren",
        );
      };

      const ensureHeroMotionFallback = () => {
        if (
          !(heroMotionFallback instanceof HTMLPictureElement) ||
          !(heroMotionImage instanceof HTMLImageElement) ||
          heroMotionImage.dataset.motionReady === "true"
        ) {
          return;
        }

        const avifSource = document.createElement("source");
        avifSource.type = "image/avif";
        avifSource.srcset = heroMotionImage.dataset.heroMotionAvif ?? "";
        avifSource.dataset.heroGeneratedSource = "true";
        heroMotionFallback.prepend(avifSource);

        if (heroMotionImage.dataset.heroMotionWebp) {
          heroMotionImage.src = heroMotionImage.dataset.heroMotionWebp;
        }
        heroMotionImage.dataset.motionReady = "true";
      };

      const pauseHeroMotionFallback = () => {
        if (
          !(heroMotionFallback instanceof HTMLPictureElement) ||
          !(heroMotionImage instanceof HTMLImageElement)
        ) {
          return;
        }

        heroMotionFallback
          .querySelectorAll("[data-hero-generated-source]")
          .forEach((source) => source.remove());
        if (heroMotionImage.dataset.heroPoster) {
          heroMotionImage.src = heroMotionImage.dataset.heroPoster;
        }
        delete heroMotionImage.dataset.motionReady;
      };

      const useHeroMotionFallback = ({ animate = true } = {}) => {
        if (
          !(hero instanceof HTMLElement) ||
          !(heroMotionFallback instanceof HTMLElement) ||
          !(heroMotionImage instanceof HTMLImageElement)
        ) {
          return false;
        }

        if (animate) {
          ensureHeroMotionFallback();
        } else {
          pauseHeroMotionFallback();
        }
        heroFallbackActive = true;
        hero.classList.add("hero--use-motion-fallback");
        hero.classList.remove("hero--video-ready");

        return true;
      };

      const markHeroVideoReady = () => {
        if (
          !(hero instanceof HTMLElement) ||
          !(heroVideo instanceof HTMLVideoElement)
        ) {
          return;
        }

        window.clearTimeout(heroFallbackTimer);
        heroFallbackActive = false;
        heroAutoplayBlocked = false;
        hero.classList.add("hero--video-ready");
        hero.classList.remove("hero--use-motion-fallback");
        setHeroToggleState(false);
      };

      const prepareHeroVideo = () => {
        if (!(heroVideo instanceof HTMLVideoElement)) {
          return false;
        }

        heroVideo.muted = true;
        heroVideo.defaultMuted = true;
        heroVideo.autoplay = true;
        heroVideo.loop = true;
        heroVideo.playsInline = true;
        heroVideo.volume = 0;
        heroVideo.controls = false;
        heroVideo.setAttribute("muted", "");
        heroVideo.setAttribute("autoplay", "");
        heroVideo.setAttribute("loop", "");
        heroVideo.setAttribute("playsinline", "");
        heroVideo.setAttribute("webkit-playsinline", "");

        return true;
      };

      const playHeroVideo = ({ userGesture = false } = {}) => {
        if (
          heroUserPaused ||
          document.hidden ||
          !heroInViewport ||
          (heroAutoplayBlocked && !userGesture)
        ) {
          return;
        }

        if (!prepareHeroVideo()) {
          return;
        }

        heroVideo
          .play()
          .catch(() => {
            heroAutoplayBlocked = true;
            useHeroMotionFallback();
            setHeroToggleState(false);
          });
      };

      const pauseHeroMotion = () => {
        heroUserPaused = true;
        window.clearTimeout(heroFallbackTimer);
        if (heroVideo instanceof HTMLVideoElement) {
          heroVideo.pause();
        }
        if (heroFallbackActive) {
          useHeroMotionFallback({ animate: false });
        }
        setHeroToggleState(true);
      };

      const resumeHeroMotion = () => {
        heroUserPaused = false;
        setHeroToggleState(false);
        if (heroFallbackActive && heroAutoplayBlocked) {
          useHeroMotionFallback();
        }
        playHeroVideo({ userGesture: true });
      };

      const scheduleHeroFallback = () => {
        if (heroUserPaused || document.hidden || !heroInViewport) {
          return;
        }

        window.clearTimeout(heroFallbackTimer);
        heroFallbackTimer = window.setTimeout(() => {
          if (
            heroVideo instanceof HTMLVideoElement &&
            (heroVideo.paused || heroVideo.readyState < HTMLMediaElement.HAVE_FUTURE_DATA)
          ) {
            useHeroMotionFallback();
          }
        }, 900);
      };

      if (heroVideo instanceof HTMLVideoElement) {
        heroVideo.addEventListener("playing", markHeroVideoReady);
        heroVideo.addEventListener("waiting", scheduleHeroFallback);
        heroVideo.addEventListener("stalled", scheduleHeroFallback);
        heroVideo.addEventListener("error", () => {
          heroAutoplayBlocked = true;
          useHeroMotionFallback();
        });

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", playHeroVideo, {
            once: true,
          });
        } else {
          playHeroVideo();
        }

        window.addEventListener("pageshow", playHeroVideo);
        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            heroVideo.pause();
          } else {
            playHeroVideo();
          }
        });
        ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
          window.addEventListener(
            eventName,
            () => playHeroVideo({ userGesture: true }),
            {
              once: true,
              passive: true,
            },
          );
        });
      }

      if (hero instanceof HTMLElement && "IntersectionObserver" in window) {
        const heroObserver = new IntersectionObserver(
          ([entry]) => {
            heroInViewport = Boolean(entry?.isIntersecting);
            if (!heroInViewport && heroVideo instanceof HTMLVideoElement) {
              heroVideo.pause();
              return;
            }
            playHeroVideo();
          },
          { threshold: 0.12 },
        );
        heroObserver.observe(hero);
      }

      heroMotionToggle?.addEventListener("click", () => {
        if (heroUserPaused) {
          resumeHeroMotion();
        } else {
          pauseHeroMotion();
        }
      });
      setHeroToggleState(heroUserPaused);
    </script>
  </SiteChrome>
</Layout>

<style>
  :global(html),
  :global(body),
  main {
    background: #101010;
    background-color: #101010;
  }

  .scroll-cue {
    color: currentColor;
    background: transparent;
    border: 0;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.66rem;
    font-weight: 500;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .media-panel {
    position: relative;
    display: grid;
    --panel-edge-cue-offset: clamp(5.25rem, 12vh, 8.5rem);
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }

  .media-panel::after {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 18vh;
    background: linear-gradient(180deg, rgba(16, 16, 16, 0), #101010);
    content: "";
    pointer-events: none;
  }

  .media-panel__image,
  .media-panel__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-panel__image {
    z-index: 0;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04) brightness(0.92);
    transform: scale(1.015);
  }

  .media-panel__image--motion-fallback {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .media-panel__image--motion-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero video.media-panel__image {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .hero--video-ready video.media-panel__image {
    visibility: visible;
    opacity: 1;
  }

  .hero--video-ready .media-panel__image--motion-fallback {
    visibility: hidden;
    opacity: 0;
  }

  .hero-motion-toggle {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    bottom: clamp(1.25rem, 3vw, 2.75rem);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: rgba(238, 238, 238, 0.9);
    background: rgba(16, 16, 16, 0.22);
    border: 1px solid rgba(238, 238, 238, 0.38);
    border-radius: 999px;
    backdrop-filter: blur(14px);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .hero-motion-toggle span {
    position: relative;
    width: 11px;
    height: 14px;
    border-left: 2px solid currentColor;
    border-right: 2px solid currentColor;
  }

  .hero-motion-toggle.is-paused span {
    width: 0;
    height: 0;
    margin-left: 2px;
    border-top: 7px solid transparent;
    border-right: 0;
    border-bottom: 7px solid transparent;
    border-left: 11px solid currentColor;
  }

  .hero-motion-toggle:hover,
  .hero-motion-toggle:focus-visible {
    background: rgba(16, 16, 16, 0.5);
    border-color: rgba(238, 238, 238, 0.86);
    transform: scale(1.05);
  }

  .hero-motion-toggle:focus-visible {
    outline: 1px solid rgba(238, 238, 238, 0.82);
    outline-offset: 0.35rem;
  }

  .media-panel__shade {
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.34),
        rgba(12, 12, 12, 0.04) 40%,
        rgba(12, 12, 12, 0.58)
      ),
      linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.42),
        rgba(12, 12, 12, 0.04) 56%,
        rgba(12, 12, 12, 0.22)
      );
    pointer-events: none;
  }

  .media-panel__shade--craft {
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.36),
        rgba(12, 12, 12, 0.06) 42%,
        rgba(12, 12, 12, 0.62)
      ),
      linear-gradient(90deg, rgba(12, 12, 12, 0.46), rgba(12, 12, 12, 0.05) 62%);
  }

  .media-panel__shade--editorial {
    background:
      linear-gradient(
        180deg,
        rgba(12, 12, 12, 0.28),
        rgba(12, 12, 12, 0.03) 38%,
        rgba(12, 12, 12, 0.76)
      ),
      linear-gradient(
        90deg,
        rgba(12, 12, 12, 0.34),
        rgba(12, 12, 12, 0.04) 50%,
        rgba(12, 12, 12, 0.28)
      );
  }

  #projekte .media-panel__image {
    object-position: 50% 48%;
  }

  #ueber-uns .media-panel__image {
    object-position: 50% 44%;
  }

  #oldtimer-kaufen .media-panel__image {
    object-position: 50% 48%;
  }

  .media-panel__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    width: min(860px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 9rem 0 clamp(5.25rem, 12vh, 8.5rem);
    text-align: center;
    transition:
      opacity 360ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-panel__content--craft {
    align-items: center;
    justify-content: end;
    width: min(780px, calc(100% - 2rem));
    margin: 0 auto;
    text-align: center;
  }

  h1,
  .media-panel h2 {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(1.7rem, 3.1vw, 3.75rem);
    line-height: 1.1;
  }

  .hero-title__word {
    white-space: nowrap;
  }

  .hero-title__letter {
    --hero-title-letter-width: 0.8em;

    display: inline-block;
    width: 0;
    overflow: visible;
    filter: blur(0.1em);
    opacity: 0;
    transform: translateX(-0.14em);
    vertical-align: baseline;
    will-change: width, opacity, filter, transform;
  }

