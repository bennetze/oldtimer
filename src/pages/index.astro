---
import Layout from "../layouts/Layout.astro";
import SiteChrome from "../components/SiteChrome.astro";
import SectionNavigation from "../components/SectionNavigation.astro";
import craftHands from "../assets/oldtimer/craft-hands.png";
import heroSiteMotionAvif from "../assets/oldtimer/hero-site-motion.avif";
import heroSiteMotionWebp from "../assets/oldtimer/hero-site-motion.webp";
import heroSiteMp4 from "../assets/oldtimer/hero-site.mp4";
import heroSitePoster from "../assets/oldtimer/hero-site-poster.jpg";
import heroSiteWebm from "../assets/oldtimer/hero-site.webm";
import handwerkMotionAvif from "../assets/oldtimer/handwerk-motion.avif";
import handwerkMotionWebp from "../assets/oldtimer/handwerk-motion.webp";
import handwerkMp4 from "../assets/oldtimer/handwerk.mp4";
import handwerkPoster from "../assets/oldtimer/handwerk-poster.jpg";
import handwerkWebm from "../assets/oldtimer/handwerk.webm";
import ueberUnsMotionAvif from "../assets/oldtimer/ueberuns-motion.avif";
import ueberUnsMotionWebp from "../assets/oldtimer/ueberuns-motion.webp";
import ueberUnsMp4 from "../assets/oldtimer/ueberuns.mp4";
import ueberUnsPoster from "../assets/oldtimer/ueberuns-poster.jpg";
import ueberUnsWebm from "../assets/oldtimer/ueberuns.webm";
import projekteMotionAvif from "../assets/oldtimer/projekte-motion.avif";
import projekteMotionWebp from "../assets/oldtimer/projekte-motion.webp";
import projekteMp4 from "../assets/oldtimer/projekte.mp4";
import projektePoster from "../assets/oldtimer/projekte-poster.jpg";
import projekteWebm from "../assets/oldtimer/projekte.webm";
import sectionOldtimerKaufen from "../assets/oldtimer/section-oldtimer-kaufen.png";
import sectionProjekte from "../assets/oldtimer/section-projekte.png";
import sectionUeberUns from "../assets/oldtimer/section-ueber-uns.png";
import { object, optional, overwrite } from "astro:schema";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path) => {
  if (path === "/") {
    return basePath;
  }

  if (path.startsWith("/#")) {
    return `${basePath}${path.slice(1)}`;
  }

  if (path.startsWith("/")) {
    return `${basePath}${path.slice(1)}`;
  }

  return path;
};

const sections = [
  {
    id: "ueber-uns",
    title: "Über uns",
    image: sectionUeberUns,
    alt: "Restaurierungsteam arbeitet konzentriert an einem klassischen Fahrzeug in einer Werkstatt",
    href: "/ueber-uns/",
    previous: "#handwerk",
    next: "#projekte",
  },
  {
    id: "projekte",
    title: "Projekte",
    image: sectionProjekte,
    alt: "Klassische Fahrzeuge in unterschiedlichen Restaurierungsphasen in einer dunklen Werkstatt",
    href: "/projekte/",
    previous: "#ueber-uns",
    next: "#oldtimer-kaufen",
  },
  {
    id: "oldtimer-kaufen",
    title: "Fahrzeugangebote",
    image: sectionOldtimerKaufen,
    alt: "Ein klassisches Coupé in einer dunklen Werkstattpräsentation",
    href: "/projekte/fahrzeugangebote/",
    previous: "#projekte",
  },
];

const sectionNavigationItems = [
  { id: "start", label: "Start" },
  { id: "handwerk", label: "Handwerk" },
  { id: "ueber-uns", label: "Über uns" },
  { id: "projekte", label: "Projekte" },
];
---

<Layout
  description="Die Oldtimermanufaktur bewahrt die Geschichte klassischer Automobile – mit handwerklicher Präzision, technischer Sorgfalt und Respekt vor ihrer Geschichte."
  dateModified="2026-08-06"
>
  <SiteChrome>
    <main id="main-content" tabindex="-1">
      <SectionNavigation items={sectionNavigationItems} />

      <section
        class="media-panel hero"
        id="start"
        aria-labelledby="hero-title"
        data-hero
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={heroSitePoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={heroSiteMp4} type="video/mp4" />
          <source
            src={heroSiteWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="high"
            src={heroSitePoster.src}
            data-motion-poster={heroSitePoster.src}
            data-motion-avif={heroSiteMotionAvif.src}
            data-motion-webp={heroSiteMotionWebp.src}
            data-motion-image
          />
        </picture>
        <div class="media-panel__shade"></div>
        <button
          class="hero-motion-toggle"
          type="button"
          data-motion-toggle
          aria-label="Animation pausieren"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--hero">
          <h1 id="hero-title">
            Wir bewahren <span class="hero-title__word"
              >Geschichte<span class="hero-title__letter" data-hero-title-letter
                ><span
                  class="hero-title__letter-glyph"
                  data-hero-title-letter-glyph>N</span
                ></span
              ></span
            >
          </h1>
          <button
            class="scroll-cue"
            type="button"
            data-scroll-target="#handwerk"
            aria-label="Zum Handwerk scrollen"
          >
            <span aria-hidden="true"></span>
          </button>
        </div>
      </section>

      <section
        class="media-panel craft"
        id="handwerk"
        aria-labelledby="craft-title"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={handwerkPoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={handwerkMp4} type="video/mp4" />
          <source
            src={handwerkWebm}
            type='video/webm; codecs="av01.0.08M.08"'
          />
        </video>
        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            fetchpriority="high"
            src={handwerkPoster.src}
            data-motion-poster={handwerkPoster.src}
            data-motion-avif={handwerkMotionAvif.src}
            data-motion-webp={handwerkMotionWebp.src}
            data-motion-image
          />
        </picture>
        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="craft-title">Handwerk</h2>
          <a class="section-cta" href={sitePath("/handwerk/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#ueber-uns"
              aria-label="Zu Über uns scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="media-panel editorial-panel"
        id="ueber-uns"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={ueberUnsPoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={ueberUnsMp4} type="video/mp4" />
          <source src={ueberUnsWebm} type="video/webm" />
        </video>

        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            src={ueberUnsPoster.src}
            data-motion-poster={ueberUnsPoster.src}
            data-motion-avif={ueberUnsMotionAvif.src}
            data-motion-webp={ueberUnsMotionWebp.src}
            data-motion-image
          />
        </picture>

        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="craft-title">Über uns</h2>
          <a class="section-cta" href={sitePath("/ueber-uns/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#projekte"
              aria-label="Zu Projekten scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>

      <section
        class="media-panel editorial-panel"
        id="projekte"
        data-motion-panel
      >
        <video
          class="media-panel__image"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"
          poster={projektePoster.src}
          disablepictureinpicture
          data-motion-video
          aria-hidden="true"
        >
          <source src={projekteMp4} type="video/mp4" />
          <source src={projekteWebm} type="video/webm" />
        </video>

        <picture
          class="media-panel__image media-panel__image--motion-fallback"
          aria-hidden="true"
          data-motion-fallback
        >
          <img
            alt=""
            decoding="async"
            src={projektePoster.src}
            data-motion-poster={projektePoster.src}
            data-motion-avif={projekteMotionAvif.src}
            data-motion-webp={projekteMotionWebp.src}
            data-motion-image
          />
        </picture>

        <div class="media-panel__shade media-panel__shade--craft"></div>
        <button
          class="scroll-cue scroll-cue--up section-up-cue"
          type="button"
          data-scroll-target="#start"
          aria-label="Zum Start scrollen"
        >
          <span aria-hidden="true"></span>
        </button>
        <div class="media-panel__content media-panel__content--craft">
          <h2 id="craft-title">Projekte</h2>
          <a class="section-cta" href={sitePath("/projekte/")}>
            Mehr erfahren
          </a>
          <div class="scroll-cues" aria-label="Abschnitt wechseln">
            <button
              class="scroll-cue"
              type="button"
              data-scroll-target="#site-footer"
              aria-label="Zum Footer scrollen"
            >
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const hero = document.querySelector("[data-hero]");
      const heroVideo = document.querySelector("[data-hero-video]");
      const heroMotionFallback = document.querySelector(
        "[data-hero-motion-fallback]",
      );
      const heroMotionImage = document.querySelector(
        "[data-hero-motion-image]",
      );
      const heroMotionToggle = document.querySelector(
        "[data-hero-motion-toggle]",
      );
      const heroTitleLetter = document.querySelector(
        "[data-hero-title-letter]",
      );
      const heroTitleLetterGlyph = document.querySelector(
        "[data-hero-title-letter-glyph]",
      );
      let heroTitleCycleAnimation;
      let heroTitleCycleStarted = false;
      let heroTitleResizeFrame;
      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      const measureHeroTitleLetter = () => {
        if (
          !(heroTitleLetter instanceof HTMLElement) ||
          !(heroTitleLetterGlyph instanceof HTMLElement)
        ) {
          return;
        }

        const letterWidth = heroTitleLetterGlyph.getBoundingClientRect().width;
        if (letterWidth > 0) {
          heroTitleLetter.style.setProperty(
            "--hero-title-letter-width",
            `${letterWidth}px`,
          );
        }

        return letterWidth;
      };

      const startHeroTitleCycle = () => {
        if (!(heroTitleLetter instanceof HTMLElement)) {
          return;
        }

        Promise.resolve(document.fonts?.ready).then(() => {
          const letterWidth = measureHeroTitleLetter();
          if (!letterWidth) {
            return;
          }

          heroTitleCycleAnimation?.cancel();
          heroTitleLetter.classList.remove("is-cycling", "is-revealing");
          Object.assign(heroTitleLetter.style, {
            clipPath: "none",
            display: "inline-block",
            overflow: "visible",
            verticalAlign: "baseline",
          });

          if (
            prefersReducedMotion ||
            typeof heroTitleLetter.animate !== "function"
          ) {
            Object.assign(heroTitleLetter.style, {
              filter: "blur(0)",
              opacity: "1",
              transform: "none",
              width: `${letterWidth}px`,
            });
            return;
          }

          const hiddenLetter = {
            filter: "blur(0.1em)",
            opacity: 0,
            transform: "translateX(-0.14em)",
            width: "0px",
          };
          const visibleLetter = {
            filter: "blur(0)",
            opacity: 1,
            transform: "translateX(0)",
            width: `${letterWidth}px`,
          };

          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              heroTitleCycleAnimation = heroTitleLetter.animate(
                [
                  { ...hiddenLetter, offset: 0 },
                  {
                    ...hiddenLetter,
                    easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                    offset: 1 / 10,
                  },
                  { ...visibleLetter, offset: 2 / 10 },
                  {
                    ...visibleLetter,
                    easing: "cubic-bezier(0.65, 0, 0.35, 1)",
                    offset: 8 / 10,
                  },
                  { ...hiddenLetter, offset: 9 / 10 },
                  { ...hiddenLetter, offset: 1 },
                ],
                {
                  duration: 7500,
                  fill: "both",
                  iterations: Infinity,
                },
              );
            });
          });

          heroTitleCycleStarted = true;
        });
      };

      if (heroTitleLetter instanceof HTMLElement && !prefersReducedMotion) {
        heroTitleLetter.classList.remove("is-cycling", "is-revealing");
        Object.assign(heroTitleLetter.style, {
          clipPath: "none",
          display: "inline-block",
          filter: "blur(0.1em)",
          opacity: "0",
          overflow: "visible",
          transform: "translateX(-0.14em)",
          verticalAlign: "baseline",
          width: "0px",
        });
      }

      if (document.readyState === "complete") {
        startHeroTitleCycle();
      } else {
        window.addEventListener("load", startHeroTitleCycle, { once: true });
      }

      window.addEventListener(
        "resize",
        () => {
          window.cancelAnimationFrame(heroTitleResizeFrame);
          heroTitleResizeFrame = window.requestAnimationFrame(() => {
            if (heroTitleCycleStarted) {
              startHeroTitleCycle();
            } else {
              measureHeroTitleLetter();
            }
          });
        },
        { passive: true },
      );

      const setMotionToggleState = (toggle, isPaused) => {
        if (!(toggle instanceof HTMLButtonElement)) {
          return;
        }

        toggle.classList.toggle("is-paused", isPaused);
        toggle.setAttribute(
          "aria-label",
          isPaused ? "Animation abspielen" : "Animation pausieren",
        );
      };

      const initMotionPanel = (panel) => {
        if (!(panel instanceof HTMLElement)) {
          return;
        }

        const video = panel.querySelector("[data-motion-video]");
        const motionFallback = panel.querySelector("[data-motion-fallback]");
        const motionImage = panel.querySelector("[data-motion-image]");
        const motionToggle = panel.querySelector("[data-motion-toggle]");

        if (!(video instanceof HTMLVideoElement)) {
          return;
        }

        let autoplayBlocked = false;
        let inViewport = false;
        let fallbackActive = false;
        let fallbackTimer;
        let userPaused = prefersReducedMotion;

        const ensureMotionFallback = () => {
          if (
            !(motionFallback instanceof HTMLPictureElement) ||
            !(motionImage instanceof HTMLImageElement) ||
            motionImage.dataset.motionReady === "true"
          ) {
            return;
          }

          const avifSrc = motionImage.dataset.motionAvif;

          if (avifSrc) {
            const avifSource = document.createElement("source");
            avifSource.type = "image/avif";
            avifSource.srcset = avifSrc;
            avifSource.dataset.motionGeneratedSource = "true";
            motionFallback.prepend(avifSource);
          }

          const webpSrc = motionImage.dataset.motionWebp;

          if (webpSrc) {
            motionImage.src = webpSrc;
          }

          motionImage.dataset.motionReady = "true";
        };

        const pauseMotionFallback = () => {
          if (
            !(motionFallback instanceof HTMLPictureElement) ||
            !(motionImage instanceof HTMLImageElement)
          ) {
            return;
          }

          motionFallback
            .querySelectorAll("[data-motion-generated-source]")
            .forEach((source) => source.remove());

          const posterSrc = motionImage.dataset.motionPoster;

          if (posterSrc) {
            motionImage.src = posterSrc;
          }

          delete motionImage.dataset.motionReady;
        };

        const useMotionFallback = ({ animate = true } = {}) => {
          if (
            !(motionFallback instanceof HTMLElement) ||
            !(motionImage instanceof HTMLImageElement)
          ) {
            return false;
          }

          if (animate) {
            ensureMotionFallback();
          } else {
            pauseMotionFallback();
          }

          fallbackActive = true;

          panel.classList.add("is-motion-fallback");
          panel.classList.remove("is-video-ready");

          return true;
        };

        const markVideoReady = () => {
          window.clearTimeout(fallbackTimer);

          fallbackActive = false;
          autoplayBlocked = false;

          panel.classList.add("is-video-ready");
          panel.classList.remove("is-motion-fallback");

          setMotionToggleState(motionToggle, false);
        };

        const prepareVideo = () => {
          video.muted = true;
          video.defaultMuted = true;
          video.autoplay = true;
          video.loop = true;
          video.playsInline = true;
          video.volume = 0;
          video.controls = false;

          video.setAttribute("muted", "");
          video.setAttribute("autoplay", "");
          video.setAttribute("loop", "");
          video.setAttribute("playsinline", "");
          video.setAttribute("webkit-playsinline", "");
        };

        const playVideo = ({ userGesture = false } = {}) => {
          if (
            userPaused ||
            document.hidden ||
            !inViewport ||
            (autoplayBlocked && !userGesture)
          ) {
            return;
          }

          prepareVideo();

          video.play().catch(() => {
            autoplayBlocked = true;
            useMotionFallback();
            setMotionToggleState(motionToggle, false);
          });
        };

        const pauseMotion = () => {
          userPaused = true;

          window.clearTimeout(fallbackTimer);
          video.pause();

          if (fallbackActive) {
            useMotionFallback({ animate: false });
          }

          setMotionToggleState(motionToggle, true);
        };

        const resumeMotion = () => {
          userPaused = false;

          setMotionToggleState(motionToggle, false);

          if (fallbackActive && autoplayBlocked) {
            useMotionFallback();
          }

          playVideo({ userGesture: true });
        };

        const scheduleFallback = () => {
          if (userPaused || document.hidden || !inViewport) {
            return;
          }

          window.clearTimeout(fallbackTimer);

          fallbackTimer = window.setTimeout(() => {
            if (
              video.paused ||
              video.readyState < HTMLMediaElement.HAVE_FUTURE_DATA
            ) {
              useMotionFallback();
            }
          }, 900);
        };

        video.addEventListener("playing", markVideoReady);
        video.addEventListener("waiting", scheduleFallback);
        video.addEventListener("stalled", scheduleFallback);

        video.addEventListener("error", () => {
          autoplayBlocked = true;
          useMotionFallback();
        });

        motionToggle?.addEventListener("click", () => {
          if (userPaused) {
            resumeMotion();
          } else {
            pauseMotion();
          }
        });

        setMotionToggleState(motionToggle, userPaused);

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            ([entry]) => {
              inViewport = Boolean(entry?.isIntersecting);

              if (!inViewport) {
                video.pause();
                return;
              }

              playVideo();
            },
            {
              threshold: 0.12,
            },
          );

          observer.observe(panel);
        } else {
          inViewport = true;
          playVideo();
        }

        document.addEventListener("visibilitychange", () => {
          if (document.hidden) {
            video.pause();
            return;
          }

          playVideo();
        });

        window.addEventListener("pageshow", playVideo);

        ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
          window.addEventListener(
            eventName,
            () => playVideo({ userGesture: true }),
            {
              once: true,
              passive: true,
            },
          );
        });
      };

      document.querySelectorAll("[data-motion-panel]").forEach(initMotionPanel);
    </script>
  </SiteChrome>
</Layout>

<style>
  :global(html),
  :global(body),
  main {
    background: #101010;
    background-color: #101010;
  }

  .scroll-cue {
    color: currentColor;
    background: transparent;
    border: 0;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.66rem;
    font-weight: 500;
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
  }

  .media-panel {
    position: relative;
    display: grid;
    --panel-edge-cue-offset: clamp(5.25rem, 12vh, 8.5rem);
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }

  .media-panel::after {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 18vh;
    background: linear-gradient(180deg, rgba(16, 16, 16, 0), #101010);
    content: "";
    pointer-events: none;
  }

  .media-panel__image,
  .media-panel__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-panel__image {
    z-index: 0;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.04) brightness(0.92);
    transform: scale(1.015);
  }

  .media-panel__image--motion-fallback {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  .media-panel__image--motion-fallback img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-motion-panel] video.media-panel__image {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 220ms ease,
      visibility 220ms ease;
  }

  [data-motion-panel].is-video-ready video.media-panel__image {
    visibility: visible;
    opacity: 1;
  }

  [data-motion-panel].is-video-ready .media-panel__image--motion-fallback {
    visibility: hidden;
    opacity: 0;
  }

  .hero-motion-toggle {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    bottom: clamp(1.25rem, 3vw, 2.75rem);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: rgba(238, 238, 238, 0.9);
    background: rgba(16, 16, 16, 0.22);
    border: 1px solid rgba(238, 238, 238, 0.38);
    border-radius: 999px;
    backdrop-filter: blur(14px);
    cursor: pointer;
    transition:
      background 180ms ease,
      border-color 180ms ease,
