---
import VehicleArchivePage from '../../../../../components/VehicleArchivePage.astro';
import { getCategoryVehicles } from '../../../../../config/vehicles';

export async function getStaticPaths() {
	const vehicles = await getCategoryVehicles('vergangene-projekte');
	const totalPages = Math.ceil(vehicles.length / 24);

	return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
		const page = index + 2;
		return { params: { page: String(page) }, props: { currentPage: page } };
	});
}

const { currentPage } = Astro.props;
const vehicles = await getCategoryVehicles('vergangene-projekte');
---

<VehicleArchivePage
	category="vergangene-projekte"
	{vehicles}
	{currentPage}
	pageSize={24}
	locale="en"
/>
