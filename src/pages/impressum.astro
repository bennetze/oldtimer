---
import LegalArticle from '../components/LegalArticle.astro';
import Layout from '../layouts/Layout.astro';
import SiteChrome from '../components/SiteChrome.astro';
---

<Layout
	title="Impressum"
	description="Das Impressum der neuen Website befindet sich noch in Vorbereitung."
	noindex
>
	<SiteChrome>
		<LegalArticle title="Impressum" eyebrow="Entwicklungsvorschau">
			<p>
				Die Anbieterkennzeichnung für diese neue Website befindet sich noch in Vorbereitung
				und wird vor der Produktionsfreigabe vollständig ergänzt. Diese Vorschauseite ist
				nicht die veröffentlichte Anbieterkennzeichnung des Unternehmens.
			</p>
		</LegalArticle>
	</SiteChrome>
</Layout>
