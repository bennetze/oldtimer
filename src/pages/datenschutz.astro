---
import LegalArticle from '../components/LegalArticle.astro';
import Layout from '../layouts/Layout.astro';
import SiteChrome from '../components/SiteChrome.astro';
---

<Layout
	title="Datenschutzerklärung"
	description="Die Datenschutzerklärung der neuen Website befindet sich noch in Vorbereitung."
	noindex
>
	<SiteChrome theme="light">
		<LegalArticle title="Datenschutzerklärung" eyebrow="Entwicklungsvorschau">
			<p>
				Die Datenschutzerklärung für diese neue Website befindet sich noch in Vorbereitung
				und wird vor der Produktionsfreigabe anhand des tatsächlichen Hostings und aller
				Verarbeitungsvorgänge vollständig ergänzt. Diese Vorschauseite ist noch keine
				Datenschutzerklärung.
			</p>
		</LegalArticle>
	</SiteChrome>
</Layout>
