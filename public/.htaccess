ErrorDocument 404 /404.html

# Preserve the former Joomla project URLs while the canonical site uses the
# nested /projekte/ hierarchy. The legacy item tail is retained verbatim so
# duplicate vehicle names remain unambiguous.
RedirectMatch 301 ^/aktuelle-projekte/?$ /projekte/aktuelle-projekte/
RedirectMatch 301 ^/aktuelle-projekte/item/([^/]+)/?$ /projekte/aktuelle-projekte/$1/
RedirectMatch 301 ^/referenzen/?$ /projekte/vergangene-projekte/
RedirectMatch 301 ^/referenzen/item/([^/]+)/?$ /projekte/vergangene-projekte/$1/
RedirectMatch 301 ^/fahrzeugangebote/?$ /projekte/fahrzeugangebote/
RedirectMatch 301 ^/fahrzeugangebote/item/([^/]+)/?$ /projekte/fahrzeugangebote/$1/
RedirectMatch 301 ^/oldtimer-kaufen/?$ /projekte/fahrzeugangebote/

# Portable baseline for Apache-compatible hosting. Re-test every directive with
# the final host; providers such as GitHub Pages ignore this file entirely.
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'self'; frame-src 'none'; img-src 'self' data:; manifest-src 'self'; media-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
	Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Text responses benefit from compression; media and WOFF2 are already compressed.
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
	# Gallery filenames are stable across edits, so always revalidate them.
	<If "%{REQUEST_URI} =~ m#^/vehicle-gallery/# || %{REQUEST_URI} =~ m#(?:/|\.html)$#">
		Header set Cache-Control "no-cache"
	</If>
	# Only Astro's content-hashed assets may be cached immutably.
	<If "%{REQUEST_URI} =~ m#^/_astro/[^/]+\.[A-Za-z0-9_-]{8,}(?:_[A-Za-z0-9_-]+)?\.[A-Za-z0-9]+$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>

<IfModule mod_headers.c>
	# Delivery URLs contain the complete SHA-256 of the generated image bytes.
	<If "%{REQUEST_URI} =~ m#^/vehicle-gallery/[a-z0-9-]+/[a-z0-9-]+/(?:_responsive/(?:480|800|960)/)?_immutable/[a-f0-9]{64}/[a-z0-9_.-]+\.webp$#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>
